model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup 'Source Queries'

	annotation PBI_QueryGroupOrder = 0

queryGroup Dimensions

	annotation PBI_QueryGroupOrder = 1

queryGroup Facts

	annotation PBI_QueryGroupOrder = 2

annotation PBI_QueryOrder = ["OData","Environment","Approval Status","Arrangement Type","Client Person","Client Family","Childcare","Childcare Plan","Close Reason","Community","Location","Role","Arrangement","Cases","Child Location Record","Child Location Record Expanded","Community Member Family","RLS","Date","Community Role Assignment","Referrals","Volunteer Family Function Assignment","Volunteer Family Role Approval","Volunteer Family Role Requirements","Volunteer Person Function Assignment","Volunteer Person Role Approval","Volunteer Family","Volunteer Person","Report Refresh","Volunteer Person Case Role Assignment","Volunteer Person Referral Role Assignment","Volunteer Person Role Requirements"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["CalcGroup","DevMode","DaxQueryView_Desktop"]

annotation __TEdtr = 1

ref table OData
ref table 'Volunteer Family'
ref table 'Volunteer Person'
ref table RLS
ref table Date
ref table Community
ref table 'Community Member Family'
ref table 'Community Role Assignment'
ref table 'Volunteer Family Function Assignment'
ref table 'Volunteer Person Function Assignment'
ref table Arrangement
ref table 'Child Location Record'
ref table 'Child Location Record Expanded'
ref table 'Childcare Plan'
ref table 'Client Family'
ref table 'Client Person'
ref table Cases
ref table 'Close Reason'
ref table Role
ref table 'Approval Status'
ref table Referrals
ref table 'Arrangement Type'
ref table Childcare
ref table Location
ref table 'Report Refresh'
ref table '(HELP) Cases & Referrals'
ref table 'Volunteer Person Case Role Assignment'
ref table 'Volunteer Person Referral Role Assignment'
ref table '(HELP) Arrangements'
ref table '(HELP) Childcare'
ref table 'Volunteer Family Role Approval'
ref table 'Volunteer Person Role Approval'
ref table '(HELP) Approval Activity'
ref table _aux_arrangement_display_by
ref table 'Volunteer Family Role Requirements'
ref table 'Volunteer Person Role Requirements'

ref role Dynamic

ref cultureInfo en-US

