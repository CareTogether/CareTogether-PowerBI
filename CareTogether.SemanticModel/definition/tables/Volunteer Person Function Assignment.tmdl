	partition 'Volunteer Person Function Assignment' = m
		mode: import
		queryGroup: Facts
		source = ```
				let
				  Source = #"OData",
				  PersonFunctionAssignment = Source{[Name="IndividualFunctionAssignments", Signature="table"]}[Data],
				
				  selectColumns = Table.SelectColumns(
				    PersonFunctionAssignment,
				    {
				      "OrganizationId",
				      "LocationId",
				      "ArrangementId",
				      "PersonId",
				      "Function"
				    }
				  ),
				
				  renameColumns = Table.RenameColumns(
				    selectColumns,
				    {
				      {"OrganizationId", "organization_id"},
				      {"LocationId", "location_id"},
				      {"ArrangementId", "arrangement_id"},
				      {"PersonId", "person_id"},
				      {"Function", "function"}
				    }
				  ),
				
				  addRLSKey = Table.AddColumn(
				    renameColumns,
				    "rls_key",
				    each Text.Combine({[organization_id], "-", [location_id]})
				  ),
				
				  // There are duplicated Family Ids in different orgs/locations:
				  addPersonUniqueKey = Table.AddColumn(
				      addRLSKey,
				      "person_uid",
				      each
				          if [person_id] <> null then
				              Text.Combine({[rls_key], "-", [person_id]})
				          else
				              null,
				      type text
				  ),
				
				  // There are duplicated Arrangemets in different orgs/locations:
				  addArrangementUniqueKey = Table.AddColumn(
				    addPersonUniqueKey,
				    "arrangement_uid",
				    each
				      if [arrangement_id] <> null then
				        Text.Combine({[rls_key], "-", [arrangement_id]})
				      else
				        null,
				      type text
				  )
				 
				in
				
				  addArrangementUniqueKey
				```

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

