	partition 'Volunteer Person Referral Role Assignment' = m
		mode: import
		queryGroup: Facts
		source = ```
				let
				  Source = #"OData",
				  ReferralsRoleAssignments = Source{[Name="ReferralsRoleAssignments", Signature="table"]}[Data],
				 
				  selectColumns = Table.SelectColumns(
				    ReferralsRoleAssignments,
				    {
				      "ReferralId",
				      "OrganizationId",
				      "LocationId",
				      "PersonId",
				      "PersonName",
				      "AssignmentRole",
				      "AssignedAtUtc",
				      "AssignedByUserId"
				    }
				  ),
				
				  renameColumns = Table.RenameColumns(
				    selectColumns,
				    {
				      {"ReferralId", "referral_id"},
				      {"OrganizationId", "organization_id"},
				      {"LocationId", "location_id"},
				      {"PersonId", "person_id"},
				      {"PersonName", "person_name"},
				      {"AssignmentRole", "role"},
				      {"AssignedAtUtc", "assigned_at_utc"},
				      {"AssignedByUserId", "assigned_by_user_id"}
				    }
				  ),
				
				  addRLSKey = Table.AddColumn(
				    renameColumns,
				    "rls_key",
				    each Text.Combine({[organization_id], "-", [location_id]})
				  ),
				
				  addReferralUniqueKey = Table.AddColumn(
				      addRLSKey,
				      "referral_uid",
				      each
				          if [referral_id] <> null then
				              Text.Combine({[rls_key], "-", [referral_id]})
				          else
				              null,
				      type text
				  ),
				
				  addPersonUniqueKey = Table.AddColumn(
				      addReferralUniqueKey,
				      "person_uid",
				      each
				          if [person_id] <> null then
				              Text.Combine({[rls_key], "-", [person_id]})
				          else
				              null,
				      type text
				  )
				
				in
				  
				  addPersonUniqueKey
				```

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

