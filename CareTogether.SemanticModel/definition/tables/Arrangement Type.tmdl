	partition 'Arrangement Type' = m
		mode: import
		queryGroup: Dimensions
		source = ```
				let
				  Source = #"OData",
				  ArrangementType = Source{[Name="ArrangementType", Signature="table"]}[Data],
				
				  selectColumns = Table.SelectColumns(
				    ArrangementType,
				    {
				      "OrganizationId", 
				      "LocationId", 
				      "Type",
				      "ChildInvolvement"      
				    }
				  ),
				
				  renameColumns = Table.RenameColumns(
				    selectColumns,
				    {
				      {"OrganizationId", "organization_id"},
				      {"LocationId", "location_id"},
				      {"Type", "type"},
				      {"ChildInvolvement", "child_involvement"}
				    }
				  ),
				
				  addRLSKey = Table.AddColumn(
				    renameColumns,
				    "rls_key",
				    each Text.Combine({[organization_id], "-", [location_id]})
				  ),
				
				  addArrangementTypeUniqueKey = Table.AddColumn(
				      addRLSKey,
				      "type_uid",
				      each
				          if [type] <> null then
				              Text.Combine({[rls_key], "-", [type]})
				          else
				              null,
				      type text
				  )
				
				in
				
				  addArrangementTypeUniqueKey
				```

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

