	partition 'Client Family' = m
		mode: import
		queryGroup: Dimensions
		source =
				let
				  Source = #"OData",
				  Family = Source{[Name="Family", Signature="table"]}[Data],
				
				  ExpandAddress = Table.ExpandRecordColumn(Family, "PrimaryAddress", {"Line1", "Line2", "City", "County", "State", "PostalCode"}, {"PrimaryAddress.Line1", "PrimaryAddress.Line2", "PrimaryAddress.City", "PrimaryAddress.County", "PrimaryAddress.State", "PrimaryAddress.PostalCode"}),
				
				  selectColumns = Table.SelectColumns(
				    ExpandAddress,
				    {
				      "Id", "OrganizationId", "LocationId", "Name", "PrimaryEmail", "PrimaryPhoneNumber", "PrimaryAddress.Line1",
				      "PrimaryAddress.Line2", "PrimaryAddress.City", "PrimaryAddress.County", "PrimaryAddress.State",
				      "PrimaryAddress.PostalCode", "HomeChurch"
				    }
				  ),
				
				  renameColumns = Table.RenameColumns(
				    selectColumns,
				    {
				      {"Id", "family_id"},
				      {"OrganizationId", "organization_id"},
				      {"LocationId", "location_id"},
				      {"Name", "family_name"},
				      {"PrimaryEmail", "primary_email"},
				      {"PrimaryPhoneNumber", "primary_phone_number"},
				      {"PrimaryAddress.Line1", "primary_address_line_1"},
				      {"PrimaryAddress.Line2", "primary_address_line_2"},
				      {"PrimaryAddress.City", "primary_address_city"},
				      {"PrimaryAddress.County", "primary_address_county"},
				      {"PrimaryAddress.State", "primary_address_state"},
				      {"PrimaryAddress.PostalCode", "primary_address_postal_code"},
				      {"HomeChurch", "home_church"}
				    }
				  ),
				
				  addRLSKey = Table.AddColumn(
				    renameColumns,
				    "rls_key",
				    each Text.Combine({[organization_id], "-", [location_id]})
				  ),
				
				  addFamilyUniqueKey = Table.AddColumn(
				      addRLSKey,
				      "family_uid",
				      each
				          if [family_id] <> null then
				              Text.Combine({[rls_key], "-", [family_id]})
				          else
				              null,
				      type text
				  )
				in
				  addFamilyUniqueKey

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

