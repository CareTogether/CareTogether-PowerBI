		sourceColumn: close_reason_uid

		annotation SummarizationSetBy = Automatic

	partition 'Close Reason' = m
		mode: import
		queryGroup: Dimensions
		source =
				let
				
				  Source = #"OData",
				  Cases = Source{[Name="Cases", Signature="table"]}[Data],
				
				  selectColumns = Table.SelectColumns(
				    Cases,
				    {
				      "OrganizationId",
				      "LocationId",
				      "CloseReason"
				    }
				  ),
				
				  selectRows = Table.SelectRows(
				    selectColumns,
				    each [CloseReason] <> null
				  ),
				
				  properCaseCloseReason = Table.TransformColumns(
				    selectRows,
				    {
				      {"CloseReason", Text.Proper, type text}
				    }
				  ),
				
				  selectDistinctRecords = Table.Distinct(properCaseCloseReason),
				
				  renameColumns = Table.RenameColumns(
				    selectDistinctRecords,
				    {
				      {"OrganizationId", "organization_id"},
				      {"LocationId", "location_id"},
				      {"CloseReason", "close_reason"}
				    }
				  ),
				
				  addRLSKey = Table.AddColumn(
				    renameColumns,
				    "rls_key",
				    each Text.Combine({[organization_id], "-", [location_id]})
				  ),
				
				  addCloseReasonUniqueKey = Table.AddColumn(
				      addRLSKey,
				      "close_reason_uid",
				      each
				          if [close_reason] <> null then
				              Text.Combine({[rls_key], "-", [close_reason]})
				          else
				              null,
				      type text
				  )
				
				in
				
				  addCloseReasonUniqueKey

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

