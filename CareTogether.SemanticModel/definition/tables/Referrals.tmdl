table Referrals
	lineageTag: 19bd5638-a230-4a8a-b0b1-d46d4070d28d

	measure '# of Referrals Created CP' =
			
			/*
			CP = Current Period
			Counts the number of Referrals created within the selected timeframe.
			*/
			
			VAR selectedStartDate = [Selected Timeframe Start]
			VAR selectedEndDate = [Selected Timeframe End]
			
			RETURN
			CALCULATE(
			    COUNTROWS('Referrals'),
			    'Referrals'[created_utc] >= selectedStartDate,
			    'Referrals'[created_utc] < selectedEndDate + 1,
			    USERELATIONSHIP('Referrals'[location_id], Location[location_id])
			)
		formatString: #,0
		lineageTag: 73af666a-279e-474b-9e38-c99b68d78c69

	measure '# of Referrals Created PP' =
			
			/*
			PP = Previous Period
			Counts the number of Referrals created during the period immediately preceding the selected timeframe.
			*/
			
			VAR currentStartDate = [Selected Timeframe Start]
			VAR currentEndDate = [Selected Timeframe End]
			VAR periodDays = DATEDIFF(currentStartDate, currentEndDate, DAY) + 1
			VAR previousStartDate = currentStartDate - periodDays
			VAR previousEndDate = currentStartDate - 1
			
			RETURN
			CALCULATE(
			    COUNTROWS('Referrals'),
			    'Referrals'[created_utc] >= previousStartDate,
			    'Referrals'[created_utc] < previousEndDate + 1,
			    USERELATIONSHIP('Referrals'[location_id], Location[location_id])
			)
		formatString: #,0
		lineageTag: 8ea54ea0-bbbd-4e70-9b67-941b8f840a0c

	measure '# of Referrals Created PoP' =
			
			VAR currentPeriod = [# of Referrals Created CP]
			VAR previousPeriod = [# of Referrals Created PP]
			VAR perc = DIVIDE(currentPeriod - previousPeriod, previousPeriod)
			
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(perc), BLANK(),
			    perc >= 0, FORMAT(perc, "+0%") & "▲",
			    perc < 0, FORMAT(perc, "0%") & "▼",
			    "0%"
			)
		lineageTag: 7420d2aa-fd5e-457c-a48a-e5417dda5999

	measure '# of Referrals Accepted CP' = ```
			
			/*
			CP = Current Period
			
			Counts the number of Referrals accepted within the selected
			timeframe, regardless of when they were created.
			
			The selected timeframe is applied to the Referral Acceptance Date.
			*/
			
			VAR selectedStartDate = [Selected Timeframe Start]
			VAR selectedEndDate = [Selected Timeframe End]
			
			RETURN
			CALCULATE(
			    DISTINCTCOUNT('Referrals'[referral_id]),
			    'Referrals'[accepted_utc] >= selectedStartDate,
			    'Referrals'[accepted_utc] < selectedEndDate + 1,
			    NOT ISBLANK('Referrals'[accepted_utc]),
			    USERELATIONSHIP('Referrals'[location_id], Location[location_id])
			)
			
			```
		formatString: #,0
		lineageTag: 76a067c4-1b13-4a60-b494-110893d7399e

	measure '# of Referrals Accepted PP' = ```
			
			/*
			PP = Previous Period
			
			Counts the number of Referrals accepted during the previous
			equivalent period, regardless of when they were created.
			
			The previous timeframe is applied to the Referral Acceptance Date.
			*/
			
			VAR currentStartDate = [Selected Timeframe Start]
			VAR currentEndDate = [Selected Timeframe End]
			
			VAR periodDays =
			    DATEDIFF(currentStartDate, currentEndDate, DAY) + 1
			
			VAR previousStartDate =
			    currentStartDate - periodDays
			
			VAR previousEndDate =
			    currentStartDate - 1
			
			RETURN
			CALCULATE(
			    DISTINCTCOUNT('Referrals'[referral_id]),
			    'Referrals'[accepted_utc] >= previousStartDate,
			    'Referrals'[accepted_utc] < previousEndDate + 1,
			    NOT ISBLANK('Referrals'[accepted_utc]),
			    USERELATIONSHIP('Referrals'[location_id], Location[location_id])
			)
			
			```
		formatString: #,0
		lineageTag: 5a747f92-0901-4f6e-9c24-3e523565f11e

	measure '# of Referrals Accepted PoP' =
			
			VAR currentPeriod = [# of Referrals Accepted CP]
			VAR previousPeriod = [# of Referrals Accepted PP]
			VAR perc = DIVIDE(currentPeriod - previousPeriod, previousPeriod)
			
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(perc), BLANK(),
			    perc >= 0, FORMAT(perc, "+0%") & "▲",
			    perc < 0, FORMAT(perc, "0%") & "▼",
			    "0%"
			)
		lineageTag: 1b3cc45f-0ebe-4b78-8942-e14a271f171c

	measure '# of Families Connected CP' =
			
			/*
			CP = Current Period
			Counts unique Families associated with Referrals created within the selected timeframe.
			*/
			
			VAR selectedStartDate = [Selected Timeframe Start]
			VAR selectedEndDate = [Selected Timeframe End]
			
			RETURN
			CALCULATE(
			    DISTINCTCOUNT('Referrals'[family_id]),
			    'Referrals'[created_utc] >= selectedStartDate,
			    'Referrals'[created_utc] < selectedEndDate + 1,
			    NOT ISBLANK('Referrals'[family_id]),
			    USERELATIONSHIP('Referrals'[location_id], Location[location_id])
			)
		formatString: #,0
		lineageTag: fac84eb8-b35b-4df2-b86d-84729afd9ac1

	measure '# of Families Connected PP' =
			
			/*
			PP = Previous Period
			Counts unique Families associated with Referrals created during the previous equivalent period.
			*/
			
			VAR currentStartDate = [Selected Timeframe Start]
			VAR currentEndDate = [Selected Timeframe End]
			VAR periodDays = DATEDIFF(currentStartDate, currentEndDate, DAY) + 1
			VAR previousStartDate = currentStartDate - periodDays
			VAR previousEndDate = currentStartDate - 1
			
			RETURN
			CALCULATE(
			    DISTINCTCOUNT('Referrals'[family_id]),
			    'Referrals'[created_utc] >= previousStartDate,
			    'Referrals'[created_utc] < previousEndDate + 1,
			    NOT ISBLANK('Referrals'[family_id]),
			    USERELATIONSHIP('Referrals'[location_id], Location[location_id])
			)
		formatString: #,0
		lineageTag: 901855f2-2a70-46a2-97f6-76f78ab2e1b1

	measure '# of Families Connected PoP' =
			
			VAR currentPeriod = [# of Families Connected CP]
			VAR previousPeriod = [# of Families Connected PP]
			VAR perc = DIVIDE(currentPeriod - previousPeriod, previousPeriod)
			
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(perc), BLANK(),
			    perc >= 0, FORMAT(perc, "+0%") & "▲",
			    perc < 0, FORMAT(perc, "0%") & "▼",
			    "0%"
			)
		lineageTag: 814fac65-439d-4bac-81e9-eccd405840fe

