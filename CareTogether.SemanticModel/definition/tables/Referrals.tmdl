	column 'Referral Volunteer Role Assignment' =
			
			VAR personRoles =
			    DISTINCT(
			        SELECTCOLUMNS(
			            RELATEDTABLE('Volunteer Person Referral Role Assignment'),
			            "Person", 'Volunteer Person Referral Role Assignment'[person_name],
			            "Role", 'Volunteer Person Referral Role Assignment'[role]
			        )
			    )
			
			RETURN
			CONCATENATEX(
			    personRoles,
			    [Person] & " (" & [Role] & ")",
			    UNICHAR(10),
			    [Person],
			    ASC
			)
		displayFolder: _calculated_columns
		lineageTag: b3f38aa5-2ea5-42c2-9746-fa146a9263f0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Client Family Name' = LOOKUPVALUE('Client Family'[family_name], 'Client Family'[family_id], Referrals[family_id])
		displayFolder: _calculated_columns
		lineageTag: 03b64610-df29-4d51-b120-97828d05cb9a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Referrals = m
		mode: import
		queryGroup: Facts
		source =
				let
				  Source = #"OData",
				  Referrals = Source{[Name="Referrals", Signature="table"]}[Data],
				
				  selectColumns = Table.SelectColumns(
				    Referrals,
				    {
				      "ReferralId",
				      "OrganizationId",
				      "LocationId",
				      "FamilyId",
				      "CaseId",
				      "CreatedAtUtc",
				      "AcceptedAtUtc",
				      "ClosedAtUtc",
				      "Title",
				      "Status",
				      "Comment",
				      "CloseReason"
				    }
				  ),
				
				  renameColumns = Table.RenameColumns(
				    selectColumns,
				    {
				      {"ReferralId", "referral_id"},
				      {"OrganizationId", "organization_id"},
				      {"LocationId", "location_id"},
				      {"FamilyId", "family_id"},
				      {"CaseId", "case_id"},
				      {"CreatedAtUtc", "created_utc"},
				      {"AcceptedAtUtc", "accepted_utc"},
				      {"ClosedAtUtc", "closed_utc"},
				      {"Title", "title"},
				      {"Status", "status"},
				      {"Comment", "comment"},
				      {"CloseReason", "close_reason"}
				    }
				  ),
				
				  addRLSKey = Table.AddColumn(
				      renameColumns,
				      "rls_key",
				      each Text.Combine({[organization_id], "-", [location_id]})
				  ),
				
				  addReferralUniqueKey = Table.AddColumn(
				      addRLSKey,
				      "referral_uid",
				      each
				          if [referral_id] <> null then
				              Text.Combine({[rls_key], "-", [referral_id]})
				          else
				              null,
				      type text
				  ),
				
				  addCaseUniqueKey = Table.AddColumn(
				      addReferralUniqueKey,
				      "case_uid",
				      each
				          if [case_id] <> null then
				              Text.Combine({[rls_key], "-", [case_id]})
				          else
				              null,
				      type text
				  ),
				
				  addFamilyUniqueKey = Table.AddColumn(
				      addCaseUniqueKey,
				      "family_uid",
				      each
				          if [family_id] <> null then
				              Text.Combine({[rls_key], "-", [family_id]})
				          else
				              null,
				      type text
				  ),
				
				  properCaseCloseReason = Table.TransformColumns(addFamilyUniqueKey, {{"close_reason", Text.Proper, type text}}),
				
				  addCloseReasonUniqueKey = Table.AddColumn(
				    properCaseCloseReason,
				    "close_reason_uid",
				    each
				      if [close_reason] <> null then
				        Text.Combine({[rls_key], "-", [close_reason]})
				      else
				        null,
				    type text
				  )
				
				in
				
				  addCloseReasonUniqueKey

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

