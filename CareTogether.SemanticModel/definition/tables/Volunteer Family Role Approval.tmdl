	column 'Family Application Type' =
			
			/*
			Classifies each Family Application as New or Returning
			based on the Family and Role combination.
			
			Each entry into Prospective represents a new Application,
			including renewals and reapplications.
			
			The first Prospective date for each Family and Role
			is classified as a New Application.
			
			Subsequent Prospective dates for the same Family and Role
			are classified as Returning Applications.
			
			Applications are tracked across Locations using
			Family ID and Role UID.
			
			Only Prospective records receive a classification.
			*/
			
			VAR currentFamily = 'Volunteer Family Role Approval'[family_id]
			VAR currentRole = 'Volunteer Family Role Approval'[role_uid]
			VAR currentDate = 'Volunteer Family Role Approval'[valid_from]
			VAR currentStatus = 'Volunteer Family Role Approval'[status]
			
			VAR firstApplicationDate =
			    CALCULATE(
			        MIN('Volunteer Family Role Approval'[valid_from]),
			        FILTER(
			            ALL('Volunteer Family Role Approval'),
			            'Volunteer Family Role Approval'[family_id] = currentFamily &&
			            'Volunteer Family Role Approval'[role_uid] = currentRole &&
			            'Volunteer Family Role Approval'[status] = "Prospective"
			        )
			    )
			
			RETURN
			IF(
			    currentStatus = "Prospective",
			    IF(
			        currentDate = firstApplicationDate,
			        "New",
			        "Returning"
			    ),
			    BLANK()
			)
		displayFolder: _calculated_columns
		lineageTag: 881367eb-8984-43fc-87ce-954dea66c4c4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Family Application Final Status' =
			
			/*
			Identifies the final observed status of each Family Application.
			
			Each entry into Prospective starts a new Application cycle
			for the same Family and Role.
			
			All subsequent status records belong to that Application
			until the next Prospective entry.
			
			The final status is the latest status recorded within
			the Application cycle, based on valid_from.
			
			Application cycles are tracked across Locations using
			Family ID and Role UID.
			
			Future-dated status transitions are excluded.
			
			Records without a preceding Prospective entry return BLANK.
			*/
			
			VAR currentFamily = 'Volunteer Family Role Approval'[family_id]
			VAR currentRole = 'Volunteer Family Role Approval'[role_uid]
			VAR currentDate = 'Volunteer Family Role Approval'[valid_from]
			
			VAR applicationStartDate =
			    CALCULATE(
			        MAX('Volunteer Family Role Approval'[valid_from]),
			        FILTER(
			            ALL('Volunteer Family Role Approval'),
			            'Volunteer Family Role Approval'[family_id] = currentFamily &&
			            'Volunteer Family Role Approval'[role_uid] = currentRole &&
			            'Volunteer Family Role Approval'[status] = "Prospective" &&
			            'Volunteer Family Role Approval'[valid_from] <= currentDate
			        )
			    )
			
			VAR nextApplicationStartDate =
			    CALCULATE(
			        MIN('Volunteer Family Role Approval'[valid_from]),
			        FILTER(
			            ALL('Volunteer Family Role Approval'),
			            'Volunteer Family Role Approval'[family_id] = currentFamily &&
			            'Volunteer Family Role Approval'[role_uid] = currentRole &&
			            'Volunteer Family Role Approval'[status] = "Prospective" &&
			            'Volunteer Family Role Approval'[valid_from] > applicationStartDate
			        )
			    )
			
			VAR lastStatusDate =
			    CALCULATE(
			        MAX('Volunteer Family Role Approval'[valid_from]),
			        FILTER(
			            ALL('Volunteer Family Role Approval'),
			            'Volunteer Family Role Approval'[family_id] = currentFamily &&
			            'Volunteer Family Role Approval'[role_uid] = currentRole &&
			            'Volunteer Family Role Approval'[valid_from] >= applicationStartDate &&
			            (
			                ISBLANK(nextApplicationStartDate) ||
			                'Volunteer Family Role Approval'[valid_from] < nextApplicationStartDate
			            ) &&
			            'Volunteer Family Role Approval'[valid_from] < TODAY() + 1
			        )
			    )
			
			VAR finalStatus =
			    CALCULATE(
			        SELECTEDVALUE('Volunteer Family Role Approval'[status]),
			        FILTER(
			            ALL('Volunteer Family Role Approval'),
			            'Volunteer Family Role Approval'[family_id] = currentFamily &&
			            'Volunteer Family Role Approval'[role_uid] = currentRole &&
			            'Volunteer Family Role Approval'[valid_from] = lastStatusDate
			        )
			    )
			
			RETURN
			IF(
			    NOT ISBLANK(applicationStartDate) &&
			    NOT ISBLANK(currentFamily) &&
			    NOT ISBLANK(currentRole) &&
			    NOT ISBLANK(lastStatusDate),
			    finalStatus,
			    BLANK()
			)
		displayFolder: _calculated_columns
		lineageTag: 852e754e-5c5f-4566-8070-f7e805f47870
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'Volunteer Family Role Approval' = m
		mode: import
		queryGroup: Facts
		source =
				let
				  Source = #"OData",
				  VolunteerFamilyRoleApproval = Source{[Name="FamilyRoleApprovals", Signature="table"]}[Data],
				
				  selectColumns = Table.SelectColumns(
				    VolunteerFamilyRoleApproval,
				    {
				      "OrganizationId",
				      "LocationId",
				      "FamilyId",
				      "RoleName",
				      "Start",
				      "End",
				      "Status"
				    }
				  ),
				
				  renameColumns = Table.RenameColumns(
				    selectColumns,
				    {
				      {"OrganizationId", "organization_id"},
				      {"LocationId", "location_id"},
				      {"FamilyId", "family_id"},
				      {"RoleName", "role_name"},
				      {"Start", "valid_from"},
				      {"End", "valid_to"},
				      {"Status", "status"}
				    }
				  ),
				
				  addRLSKey = Table.AddColumn(
				    renameColumns,
				    "rls_key",
				    each Text.Combine({[organization_id], "-", [location_id]})
				  ),
				
				  addFamilyUniqueKey = Table.AddColumn(
				      addRLSKey,
				      "family_uid",
				      each
				          if [family_id] <> null then
				              Text.Combine({[rls_key], "-", [family_id]})
				          else
				              null,
				      type text
				  ),
				
				  // Roles are not associated with locations - The UID must be ORG + Role Name
				  addRoleUniqueKey = Table.AddColumn(
				      addFamilyUniqueKey,
				      "role_uid",
				      each
				          if [role_name] <> null then
				              Text.Combine({[organization_id], "-", [role_name]})
				          else
				              null,
				      type text
				  )
				
				in
				
				  addRoleUniqueKey

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

