	measure '# of Family Onboardings CP' =
			
			/*
			CP = Current Period
			
			Counts the number of Family Onboarding events
			during the selected timeframe.
			
			Each entry into Onboarded represents an Onboarding
			event for a specific Family and Role.
			
			Onboardings are identified by Family ID, Role UID,
			and Onboarded start date.
			
			Duplicate records across Locations are counted only once.
			
			This is an activity-based measure, not a cohort measure.
			*/
			
			VAR selectedStartDate = [Selected Timeframe Start]
