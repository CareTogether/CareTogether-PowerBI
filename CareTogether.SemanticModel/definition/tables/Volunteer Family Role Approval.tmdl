	measure '# of Family Onboardings PP' =
			
			/*
			PP = Previous Period
			
			Counts the number of Family Onboarding events
			during the previous period.
			
			The previous period has the same number of calendar days
			as the currently selected timeframe.
			
			Each entry into Onboarded represents an Onboarding
			event for a specific Family and Role.
			
			Onboardings are identified by Family ID, Role UID,
			and Onboarded start date.
			
			Duplicate records across Locations are counted only once.
			
			This is an activity-based measure, not a cohort measure.
			*/
			
			VAR selectedStartDate = [Selected Timeframe Start]
			VAR selectedEndDate = [Selected Timeframe End]
			
			VAR periodDays = DATEDIFF(selectedStartDate, selectedEndDate, DAY) + 1
			VAR previousStartDate = selectedStartDate - periodDays
			VAR previousEndDate = selectedStartDate - 1
			
			RETURN
			CALCULATE(
			    COUNTROWS(
			        SUMMARIZE(
			            'Volunteer Family Role Approval',
			            'Volunteer Family Role Approval'[family_id],
			            'Volunteer Family Role Approval'[role_uid],
			            'Volunteer Family Role Approval'[valid_from]
			        )
			    ),
			    'Volunteer Family Role Approval'[status] = "Onboarded",
			    'Volunteer Family Role Approval'[valid_from] >= previousStartDate,
			    'Volunteer Family Role Approval'[valid_from] < previousEndDate + 1,
			    USERELATIONSHIP('Volunteer Family Role Approval'[location_id],Location[location_id])
