table 'Volunteer Family Role Approval'
	lineageTag: 87060a4c-3f05-4b70-82e1-e983aecf94be

	measure '# of Family Applications CP' =
			
			
			/*
			CP = Current Period
			
			Counts the number of Family Applications initiated
			during the selected timeframe.
			
			Each entry into Prospective represents a new Application
			for a specific Family and Role, including reapplications.
			
			Applications are identified by Family ID, Role UID,
			and Prospective start date.
			
			Duplicate records across Locations are counted only once.
			*/
			
			VAR selectedStartDate = [Selected Timeframe Start]
			VAR selectedEndDate = [Selected Timeframe End]
			
			RETURN
			CALCULATE(
			    COUNTROWS(
			        SUMMARIZE(
			            'Volunteer Family Role Approval',
			            'Volunteer Family Role Approval'[family_id],
			            'Volunteer Family Role Approval'[role_uid],
			            'Volunteer Family Role Approval'[valid_from]
			        )
			    ),
			    'Volunteer Family Role Approval'[status] = "Prospective",
			    'Volunteer Family Role Approval'[valid_from] >= selectedStartDate,
			    'Volunteer Family Role Approval'[valid_from] < selectedEndDate + 1,
			    USERELATIONSHIP('Volunteer Family Role Approval'[location_id], Location[location_id])
			)
		formatString: #,0
		displayFolder: Approval Activity Measures
		lineageTag: bec457db-d02b-48ea-bf3b-f22709675045

	measure '# of Family Applications PP' =
			
			
			/*
			PP = Previous Period
			
			Counts the number of Family Applications initiated
			during the previous period.
			
			The previous period has the same number of calendar days
			as the currently selected timeframe.
			
			Each entry into Prospective represents a new Application
			for a specific Family and Role, including reapplications.
			
			Applications are identified by Family ID, Role UID,
			and Prospective start date.
			
			Duplicate records across Locations are counted only once.
			*/
			
			VAR selectedStartDate = [Selected Timeframe Start]
			VAR selectedEndDate = [Selected Timeframe End]
			
			VAR periodDays = DATEDIFF(selectedStartDate, selectedEndDate, DAY) + 1
			VAR previousStartDate = selectedStartDate - periodDays
			VAR previousEndDate = selectedStartDate - 1
			
			RETURN
			CALCULATE(
			    COUNTROWS(
			        SUMMARIZE(
			            'Volunteer Family Role Approval',
			            'Volunteer Family Role Approval'[family_id],
			            'Volunteer Family Role Approval'[role_uid],
			            'Volunteer Family Role Approval'[valid_from]
			        )
			    ),
			    'Volunteer Family Role Approval'[status] = "Prospective",
			    'Volunteer Family Role Approval'[valid_from] >= previousStartDate,
			    'Volunteer Family Role Approval'[valid_from] < previousEndDate + 1,
			    USERELATIONSHIP('Volunteer Family Role Approval'[location_id], Location[location_id])
			)
		formatString: 0
		displayFolder: Approval Activity Measures
		lineageTag: 30eeac1b-3073-43a9-92b9-c18144e123ef

	measure '# of Family Applications PoP' =
			
			
			VAR currentPeriod = [# of Family Applications CP]
			VAR previousPeriod = [# of Family Applications PP]
			VAR perc = DIVIDE(currentPeriod - previousPeriod, previousPeriod)
			
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(perc), BLANK(),
			    perc >= 0, FORMAT(perc, "+0%") & "▲",
			    perc < 0, FORMAT(perc, "0%") & "▼",
			    "0%"
			)
		displayFolder: Approval Activity Measures
		lineageTag: a39e9345-2f83-49d9-a819-564a77acca98

	measure '# of Family Approvals CP' =
			
			/*
			CP = Current Period
			
			Counts the number of Family Approval events
			during the selected timeframe.
			
			Each entry into Approved represents an Approval
			for a specific Family and Role.
			
			Approvals are identified by Family ID, Role UID,
			and Approved start date.
			
			Duplicate records across Locations are counted only once.
			
			This is an activity-based measure, not a cohort measure.
			*/
			
			VAR selectedStartDate = [Selected Timeframe Start]
			VAR selectedEndDate = [Selected Timeframe End]
			
			RETURN
			CALCULATE(
			    COUNTROWS(
			        SUMMARIZE(
			            'Volunteer Family Role Approval',
			            'Volunteer Family Role Approval'[family_id],
			            'Volunteer Family Role Approval'[role_uid],
			            'Volunteer Family Role Approval'[valid_from]
			        )
			    ),
			    'Volunteer Family Role Approval'[status] = "Approved",
			    'Volunteer Family Role Approval'[valid_from] >= selectedStartDate,
			    'Volunteer Family Role Approval'[valid_from] < selectedEndDate + 1,
			    USERELATIONSHIP('Volunteer Family Role Approval'[location_id], Location[location_id])
			)
		formatString: #,0
		displayFolder: Approval Activity Measures
		lineageTag: 58a0343b-b112-4f31-841e-8e68ae7cd1b9

	measure '# of Family Approvals PP' =
			
			/*
			PP = Previous Period
			
			Counts the number of Family Approval events
			during the previous period.
			
			The previous period has the same number of calendar days
			as the currently selected timeframe.
			
			Each entry into Approved represents an Approval
			for a specific Family and Role.
			
			Approvals are identified by Family ID, Role UID,
			and Approved start date.
			
			Duplicate records across Locations are counted only once.
			
			This is an activity-based measure, not a cohort measure.
			*/
			
