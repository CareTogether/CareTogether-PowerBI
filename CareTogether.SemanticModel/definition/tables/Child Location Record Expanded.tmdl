			- The care date falls within the previous period.
			- The care date is on or before today.
			
			Each unique combination of care date and childcare
			record is counted only once.
			
			The previous period has the same number of days
			as the currently selected timeframe.
			
			The timeframe is applied to the actual care dates,
			not the Arrangement request date.
			
			The calculation uses the expanded childcare table,
			which contains one row per care date.
			*/
			
			VAR currentStartDate = [Selected Timeframe Start]
			VAR currentEndDate = [Selected Timeframe End]
			VAR todayDate = TODAY()
			VAR periodDays = DATEDIFF(currentStartDate, currentEndDate, DAY) + 1
			VAR previousStartDate = currentStartDate - periodDays
			VAR previousEndDate = currentStartDate - 1
			VAR effectiveEndDate = MIN(previousEndDate, todayDate)
			
			RETURN
			CALCULATE(
			    IF(
			        previousStartDate > todayDate,
			        BLANK(),
			        CALCULATE(
			            COUNTROWS(
			                DISTINCT(
			                    SELECTCOLUMNS(
			                        'Child Location Record Expanded',
			                        "Date", 'Child Location Record Expanded'[date],
			                        "Index", 'Child Location Record Expanded'[index]
			                    )
			                )
			            ),
			            'Child Location Record Expanded'[childcare_plan] <> "WithParent",
			            'Child Location Record Expanded'[overnight_stay] = TRUE(),
			            'Child Location Record Expanded'[date] >= previousStartDate,
			            'Child Location Record Expanded'[date] < effectiveEndDate + 1
			        )
			    ),
			    USERELATIONSHIP('Child Location Record Expanded'[location_id], Location[location_id])
			)
		formatString: #,0
		lineageTag: 2aeeeb21-ceb6-4a94-af6e-8768cbdc75c1

	measure '# of Nights of Care PoP' =
			
			
			VAR currentPeriod = [# of Nights of Care CP]
			VAR previousPeriod = [# of Nights of Care PP]
			VAR Perc = DIVIDE(currentPeriod - previousPeriod, previousPeriod)
			
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(Perc), BLANK(),
			    Perc >= 0, FORMAT(Perc, "+0%") & "▲",
			    Perc < 0, FORMAT(Perc, "0%") & "▼",
			    "0%"
			)
		lineageTag: cbc6e22b-bcc2-4694-8086-7d401dbfb4ef

