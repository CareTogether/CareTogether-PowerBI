		annotation SummarizationSetBy = Automatic

	partition 'Child Location Record Expanded' = m
		mode: import
		queryGroup: Facts
		source =
				let
				  Source = #"Child Location Record",
				
				  selectColumns = Table.SelectColumns(
				    Source,
				    {
				      "index",
				      "location_id",
				      "rls_key",
				      "childcare_plan",
				      "started_at_utc",
				      "ended_at_utc"
				    }
				  ),
				
				  addStartDate = Table.AddColumn(
				    selectColumns,
				    "start_date",
				    each
				      if [started_at_utc] <> null then
				        Date.From([started_at_utc])
				      else
				        null,
				    type date
				  ),
				
				  addEndDate = Table.AddColumn(
				    addStartDate,
				    "end_date",
				    each
				      if [ended_at_utc] <> null then
				        Date.From([ended_at_utc])
				      else
				        null,
				    type date
				  ),
				
				  currentUTCDate = Date.From(DateTimeZone.UtcNow()),
				
				  filterValidRecords = Table.SelectRows(
				    addEndDate,
				    each
				      [start_date] <> null and
				      (
				        [end_date] = null or
				        [start_date] <= [end_date]
				      )
				  ),
				
				  addDateList = Table.AddColumn(
				    filterValidRecords,
				    "date",
				    each
				      let
				        finalDate =
				          if [end_date] <> null then
				            [end_date]
				          else
				            currentUTCDate
				      in
				        List.Dates(
				          [start_date],
				          Duration.Days(finalDate - [start_date]) + 1,
				          #duration(1, 0, 0, 0)
				        ),
				    type list
				  ),
				
				  expandDates = Table.ExpandListColumn(
				    addDateList,
				    "date"
				  ),
				
				  changeDateType = Table.TransformColumnTypes(
				    expandDates,
				    {
				      {"date", type date}
				    }
				  ),
				
				  addOvernightStay = Table.AddColumn(
				    changeDateType,
				    "overnight_stay",
				    each
				      if [end_date] <> null then
				        [date] < [end_date]
				      else
				        [date] < currentUTCDate,
				    type logical
				  ),
				
				  selectFinalColumns = Table.SelectColumns(
				    addOvernightStay,
				    {
				      "date",
				      "index",
				      "childcare_plan",
				      "overnight_stay",
				      "location_id",
				      "rls_key"
				    }
				  )
				
				in
				
				  selectFinalColumns

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

