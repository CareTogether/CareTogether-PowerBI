table 'Child Location Record Expanded'
	lineageTag: 3370c7c2-7722-4481-860e-f84e38ff301a

	measure '# of Days of Care CP' =
			
			/*
			CP = Current Period
			
			Counts the total number of volunteer childcare days
			provided during the selected timeframe, regardless
			of when the care originally started.
			
			A care day is considered valid when:
			- The childcare plan is not WithParent.
			- The care date falls within the selected timeframe.
			- The care date is on or before today.
			
			Each unique combination of care date and childcare
			record is counted only once.
			
			The selected timeframe is applied to the actual
			care dates, not the Arrangement request date.
			
			The calculation uses the expanded childcare table,
			which contains one row per care date.
			*/
			
			VAR startDate = [Selected Timeframe Start]
			VAR endDate = [Selected Timeframe End]
			VAR todayDate = TODAY()
			VAR effectiveEndDate = MIN(endDate, todayDate)
			
			RETURN
			CALCULATE(
			    IF(
			        startDate > todayDate,
			        BLANK(),
			        CALCULATE(
			            COUNTROWS(
			                DISTINCT(
			                    SELECTCOLUMNS(
			                        'Child Location Record Expanded',
			                        "Date", 'Child Location Record Expanded'[date],
			                        "Index", 'Child Location Record Expanded'[index]
			                    )
			                )
			            ),
			            'Child Location Record Expanded'[childcare_plan] <> "WithParent",
			            'Child Location Record Expanded'[date] >= startDate,
			            'Child Location Record Expanded'[date] < effectiveEndDate + 1
			        )
			    ),
			    USERELATIONSHIP('Child Location Record Expanded'[location_id], Location[location_id])
			)
		formatString: #,0
		lineageTag: 73d59c19-d7af-4c72-8256-e34830727ebf

	measure '# of Days of Care PP' =
			
			/*
			PP = Previous Period
			
			Counts the total number of volunteer childcare days
			provided during the previous period, regardless
			of when the care originally started.
			
			A care day is considered valid when:
			- The childcare plan is not WithParent.
			- The care date falls within the previous period.
			- The care date is on or before today.
			
			Each unique combination of care date and childcare
			record is counted only once.
			
			The previous period has the same number of days
			as the currently selected timeframe.
			
			The timeframe is applied to the actual care dates,
			not the Arrangement request date.
			
			The calculation uses the expanded childcare table,
			which contains one row per care date.
			*/
			
			VAR currentStartDate = [Selected Timeframe Start]
			VAR currentEndDate = [Selected Timeframe End]
			VAR todayDate = TODAY()
			VAR periodDays = DATEDIFF(currentStartDate, currentEndDate, DAY) + 1
			VAR previousStartDate = currentStartDate - periodDays
			VAR previousEndDate = currentStartDate - 1
			VAR effectiveEndDate = MIN(previousEndDate, todayDate)
			
			RETURN
			CALCULATE(
			    IF(
			        previousStartDate > todayDate,
			        BLANK(),
			        CALCULATE(
			            COUNTROWS(
			                DISTINCT(
			                    SELECTCOLUMNS(
			                        'Child Location Record Expanded',
			                        "Date", 'Child Location Record Expanded'[date],
			                        "Index", 'Child Location Record Expanded'[index]
			                    )
			                )
			            ),
			            'Child Location Record Expanded'[childcare_plan] <> "WithParent",
			            'Child Location Record Expanded'[date] >= previousStartDate,
			            'Child Location Record Expanded'[date] < effectiveEndDate + 1
			        )
			    ),
			    USERELATIONSHIP('Child Location Record Expanded'[location_id], Location[location_id])
			)
		formatString: #,0
		lineageTag: d5992849-7c57-4617-81ee-6a1833ee88ba

	measure '# of Days of Care PoP' =
			
			
			VAR currentPeriod = [# of Days of Care CP]
			VAR previousPeriod = [# of Days of Care PP]
			VAR Perc = DIVIDE(currentPeriod - previousPeriod, previousPeriod)
			
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(Perc), BLANK(),
			    Perc >= 0, FORMAT(Perc, "+0%") & "▲",
			    Perc < 0, FORMAT(Perc, "0%") & "▼",
			    "0%"
			)
		lineageTag: 1b36d46d-3ce1-489d-b1aa-0fba53a26ab5

	measure '# of Nights of Care CP' =
			
			/*
			CP = Current Period
			
			Counts the total number of overnight childcare stays
			provided during the selected timeframe, regardless
			of when the care originally started.
			
			A night of care is considered valid when:
			- The childcare plan is not WithParent.
			- The record is marked as an overnight stay.
			- The care date falls within the selected timeframe.
			- The care date is on or before today.
			
			Each unique combination of care date and childcare
			record is counted only once.
			
			The selected timeframe is applied to the actual
			care dates, not the Arrangement request date.
			
			The calculation uses the expanded childcare table,
			which contains one row per care date.
			*/
			
			VAR startDate = [Selected Timeframe Start]
			VAR endDate = [Selected Timeframe End]
			VAR todayDate = TODAY()
			VAR effectiveEndDate = MIN(endDate, todayDate)
			
			RETURN
			CALCULATE(
			    IF(
			        startDate > todayDate,
			        BLANK(),
			        CALCULATE(
			            COUNTROWS(
			                DISTINCT(
			                    SELECTCOLUMNS(
			                        'Child Location Record Expanded',
			                        "Date", 'Child Location Record Expanded'[date],
			                        "Index", 'Child Location Record Expanded'[index]
			                    )
			                )
			            ),
			            'Child Location Record Expanded'[childcare_plan] <> "WithParent",
			            'Child Location Record Expanded'[overnight_stay] = TRUE(),
			            'Child Location Record Expanded'[date] >= startDate,
			            'Child Location Record Expanded'[date] < effectiveEndDate + 1
			        )
			    ),
			    USERELATIONSHIP('Child Location Record Expanded'[location_id], Location[location_id])
			)
		formatString: #,0
		lineageTag: a8d22db6-b1da-49ca-b71f-5601dfd5f0aa

