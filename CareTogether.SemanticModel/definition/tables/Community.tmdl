		sourceColumn: community_uid

		annotation SummarizationSetBy = Automatic

	partition Community = m
		mode: import
		queryGroup: Dimensions
		source = ```
				let
				  Source = #"OData",
				  Communities = Source{[Name="Communities", Signature="table"]}[Data],
				
				  selectColumns = Table.SelectColumns(
				    Communities,
				    {
				      "Id", 
				      "OrganizationId", 
				      "LocationId",
				      "Name"
				    }
				  ),
				
				  renameColumns = Table.RenameColumns(
				    selectColumns,
				    {
				      {"Id", "community_id"},
				      {"OrganizationId", "organization_id"},
				      {"LocationId", "location_id"},
				      {"Name", "community_name"}
				    }
				  ),
				
				  addRLSKey = Table.AddColumn(
				    renameColumns,
				    "rls_key",
				    each Text.Combine({[organization_id], "-", [location_id]})
				  ),
				
				  addCommunityUniqueKey = Table.AddColumn(
				      addRLSKey,
				      "community_uid",
				      each
				          if [community_id] <> null then
				              Text.Combine({[rls_key], "-", [community_id]})
				          else
				              null,
				      type text
				  )
				
				in
				
				  addCommunityUniqueKey
				```

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

