table Community
	lineageTag: ee066e46-1c5f-4cbe-a89f-50dd5ba238ac

	measure '# of Communities' =
			
			/*
			Counts the total number of distinct Communities
			within the current Organization and Location context.
			
			Communities with the same name but different IDs
			are counted separately.
			
			Includes Communities regardless of volunteer
			membership or service activity.
			*/
			
			CALCULATE(
			    DISTINCTCOUNT(Community[community_id]),
			    NOT ISBLANK(Community[community_id]),
			    USERELATIONSHIP(Community[location_id], Location[location_id])
			)
		formatString: 0
		lineageTag: 8674170e-ca73-4bf2-8f63-99428c1e9168

	column community_id
		dataType: string
		displayFolder: _columns
		lineageTag: 6c1531e1-eb12-4ddd-b49c-36e9450c23a2
		summarizeBy: none
		sourceColumn: community_id

		annotation SummarizationSetBy = Automatic

	column organization_id
