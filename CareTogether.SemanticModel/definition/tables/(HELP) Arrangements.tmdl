table '(HELP) Arrangements'
	lineageTag: 1c66c735-495d-4633-87b6-cec45153af40

	measure '(HTML) Help - Dynamic Pop-up - Arrangements' = ```
			
			/*
			Dynamically returns the corresponding HTML tooltip
			based on the selected Help ID from the Arrangements
			helper table.
			*/
			
			VAR HelpID =
			    SELECTEDVALUE(
			        '(HELP) Arrangements'[Help ID]
			    )
			
			RETURN
			SWITCH(
			    HelpID,
			
			    "REQUESTED",
			        [(HTML) Help - Requested],
			
			    "STARTED",
			        [(HTML) Help - Started],
			
			    "FAMILIES_SERVED",
			        [(HTML) Help - Families Served],
			
			    "PEOPLE_SERVED",
			        [(HTML) Help - People Served],
			
			    "AVG_TIME_TO_START",
			        [(HTML) Help - Avg. Time to Start],
			
			    "AVG_DURATION",
			        [(HTML) Help - Avg. Duration],
			
			    "ARRANGEMENTS_BY_TYPE",
			        [(HTML) Help - Arrangements by Type],
			
			    "ARRANGEMENTS_BY_LOCATION",
			        [(HTML) Help - Arrangements by Location],
			
			    "ARRANGEMENTS_OVER_TIME",
			        [(HTML) Help - Arrangements Over Time],
			
			    "REQUEST_OUTCOMES",
			        [(HTML) Help - Request Outcomes],
			
			    "ARRANGEMENTS_DETAILS",
			        [(HTML) Help - Arrangements Details],
			
			    BLANK()
			)
			
			```
		displayFolder: Measures
		lineageTag: fc1532a0-5ab3-4694-93f6-fcec98a19e91

	measure '(HTML) Help - Requested' = ```
			
			"
			<div style='width:100%;height:100%;box-sizing:border-box;padding:18px;font-family:Arial,sans-serif;color:#333333;background:#FFFFFF;'>
			
			    <!-- HEADER -->
			    <div style='display:flex;align-items:center;gap:8px;margin-bottom:14px;'>
			        <div style='width:22px;height:22px;flex:0 0 22px;display:flex;align-items:center;justify-content:center;background:#F2F2F2;border-radius:50%;font-size:12px;font-weight:700;'>i</div>
			        <div style='font-size:15px;font-weight:700;line-height:1.2;'>Arrangements Requested</div>
			    </div>
			
			    <!-- DESCRIPTION -->
			    <div style='font-size:11px;line-height:1.5;margin-bottom:16px;'>
			        Shows how many <b>Arrangements were requested</b> during the selected timeframe.
			    </div>
			
			    <!-- CALCULATION -->
			    <div style='font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:#666666;margin-bottom:6px;'>
			        How is it calculated?
			    </div>
			    <div style='font-size:11px;line-height:1.5;margin-bottom:16px;'>
			        Arrangements are counted using their <b>Request Date</b>. Each request is included if its date falls within the selected timeframe, regardless of its current status.
			    </div>
			
			    <!-- INFO BOX -->
			    <div style='width:100%;box-sizing:border-box;background:#F5F5F5;border-radius:7px;padding:11px 12px;'>
			        <div style='font-size:10px;font-weight:700;margin-bottom:5px;'>What does this measure?</div>
			        <div style='font-size:10px;line-height:1.5;color:#555555;'>
			            This metric represents incoming demand for Arrangements, including requests that have not yet started or were subsequently cancelled.
			        </div>
			    </div>
			
			    <!-- NOTE -->
			    <div style='margin-top:14px;padding-top:12px;border-top:1px solid #E5E5E5;font-size:10px;line-height:1.45;color:#666666;'>
			        <b>Important:</b> a requested Arrangement does not necessarily mean that services have started.
			    </div>
			
			</div>
			"
			
			```
		displayFolder: HTML
		lineageTag: fe53402e-b851-43f1-955b-99f148dfb6cd

	measure '(HTML) Help - Started' = ```
			
			"
			<div style='width:100%;height:100%;box-sizing:border-box;padding:18px;font-family:Arial,sans-serif;color:#333333;background:#FFFFFF;'>
			
			    <!-- HEADER -->
			    <div style='display:flex;align-items:center;gap:8px;margin-bottom:14px;'>
			        <div style='width:22px;height:22px;flex:0 0 22px;display:flex;align-items:center;justify-content:center;background:#F2F2F2;border-radius:50%;font-size:12px;font-weight:700;'>i</div>
			        <div style='font-size:15px;font-weight:700;line-height:1.2;'>Arrangements Started</div>
			    </div>
			
			    <!-- DESCRIPTION -->
			    <div style='font-size:11px;line-height:1.5;margin-bottom:16px;'>
			        Shows how many Arrangements <b>started during the selected timeframe</b>, regardless of when they were requested.
			    </div>
			
			    <!-- CALCULATION -->
			    <div style='font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:#666666;margin-bottom:6px;'>
			        How is it calculated?
			    </div>
			    <div style='font-size:11px;line-height:1.5;margin-bottom:16px;'>
			        Arrangements are counted using their <b>Start Date</b>. Only Arrangements with a valid start date on or before today and whose phase is not Cancelled are included.
			    </div>
			
			    <!-- INFO BOX -->
			    <div style='width:100%;box-sizing:border-box;background:#F5F5F5;border-radius:7px;padding:11px 12px;'>
			        <div style='font-size:10px;font-weight:700;margin-bottom:5px;'>Example: September selected</div>
			        <div style='font-size:10px;line-height:1.5;color:#555555;'>
			            An Arrangement requested in August but started in September is included in September's Started count.
			        </div>
			    </div>
			
			    <!-- NOTE -->
			    <div style='margin-top:14px;padding-top:12px;border-top:1px solid #E5E5E5;font-size:10px;line-height:1.45;color:#666666;'>
			        <b>Important:</b> Started and Requested measure different events. Started may exceed Requested within the same timeframe.
			    </div>
			
			</div>
			"
			
			```
		displayFolder: HTML
		lineageTag: 5fb0ecf5-d61a-4ab5-bf01-712250457392

	measure '(HTML) Help - Families Served' = ```
			
			"
			<div style='width:100%;height:100%;box-sizing:border-box;padding:18px;font-family:Arial,sans-serif;color:#333333;background:#FFFFFF;'>
			
			    <!-- HEADER -->
			    <div style='display:flex;align-items:center;gap:8px;margin-bottom:14px;'>
			        <div style='width:22px;height:22px;flex:0 0 22px;display:flex;align-items:center;justify-content:center;background:#F2F2F2;border-radius:50%;font-size:12px;font-weight:700;'>i</div>
			        <div style='font-size:15px;font-weight:700;line-height:1.2;'>Families Served</div>
			    </div>
			
			    <!-- DESCRIPTION -->
			    <div style='font-size:11px;line-height:1.5;margin-bottom:16px;'>
			        Shows the number of <b>unique Families</b> associated with Arrangements that started during the selected timeframe.
			    </div>
			
			    <!-- CALCULATION -->
			    <div style='font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:#666666;margin-bottom:6px;'>
			        How is it calculated?
			    </div>
			    <div style='font-size:11px;line-height:1.5;margin-bottom:16px;'>
			        Families are counted once based on their unique Family ID. The timeframe is applied to the associated Arrangement's <b>Start Date</b>.
			    </div>
			
			    <!-- INFO BOX -->
			    <div style='width:100%;box-sizing:border-box;background:#F5F5F5;border-radius:7px;padding:11px 12px;'>
			        <div style='font-size:10px;font-weight:700;margin-bottom:5px;'>Why count unique Families?</div>
			        <div style='font-size:10px;line-height:1.5;color:#555555;'>
			            A Family may have multiple Arrangements. Counting unique Families avoids counting the same Family more than once within the selected timeframe.
			        </div>
			    </div>
			
			    <!-- NOTE -->
			    <div style='margin-top:14px;padding-top:12px;border-top:1px solid #E5E5E5;font-size:10px;line-height:1.45;color:#666666;'>
			        <b>Important:</b> this metric measures Families associated with Arrangements started in the period, not all Families receiving ongoing services.
			    </div>
			
			</div>
			"
			
			```
		displayFolder: HTML
		lineageTag: aad10222-d004-48ad-b12c-a9f57619a3a7

	measure '(HTML) Help - People Served' = ```
			
			"
			<div style='width:100%;height:100%;box-sizing:border-box;padding:18px;font-family:Arial,sans-serif;color:#333333;background:#FFFFFF;'>
			
			    <!-- HEADER -->
			    <div style='display:flex;align-items:center;gap:8px;margin-bottom:14px;'>
			        <div style='width:22px;height:22px;flex:0 0 22px;display:flex;align-items:center;justify-content:center;background:#F2F2F2;border-radius:50%;font-size:12px;font-weight:700;'>i</div>
			        <div style='font-size:15px;font-weight:700;line-height:1.2;'>People Served</div>
			    </div>
			
			    <!-- DESCRIPTION -->
			    <div style='font-size:11px;line-height:1.5;margin-bottom:16px;'>
			        Shows the number of <b>unique People</b> associated with Arrangements that started during the selected timeframe.
			    </div>
			
			    <!-- CALCULATION -->
			    <div style='font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:#666666;margin-bottom:6px;'>
			        How is it calculated?
			    </div>
			    <div style='font-size:11px;line-height:1.5;margin-bottom:16px;'>
			        People are counted using their unique Person ID. Only Arrangements with a <b>Start Date</b> within the selected timeframe are considered.
			    </div>
			
			    <!-- INFO BOX -->
			    <div style='width:100%;box-sizing:border-box;background:#F5F5F5;border-radius:7px;padding:11px 12px;'>
			        <div style='font-size:10px;font-weight:700;margin-bottom:5px;'>Example</div>
			        <div style='font-size:10px;line-height:1.5;color:#555555;'>
			            If one person is associated with three Arrangements started during the selected timeframe, that person is counted only once.
			        </div>
			    </div>
			
			    <!-- NOTE -->
			    <div style='margin-top:14px;padding-top:12px;border-top:1px solid #E5E5E5;font-size:10px;line-height:1.45;color:#666666;'>
			        <b>Important:</b> this metric measures unique People, not the total number of Arrangements or service days.
			    </div>
			
			</div>
			"
			
			```
		displayFolder: HTML
		lineageTag: 696ee799-b011-4ef1-822e-26a36b2f3dba

	measure '(HTML) Help - Avg. Time to Start' = ```
			
			"
			<div style='width:100%;height:100%;box-sizing:border-box;padding:18px;font-family:Arial,sans-serif;color:#333333;background:#FFFFFF;'>
			
			    <!-- HEADER -->
			    <div style='display:flex;align-items:center;gap:8px;margin-bottom:14px;'>
			        <div style='width:22px;height:22px;flex:0 0 22px;display:flex;align-items:center;justify-content:center;background:#F2F2F2;border-radius:50%;font-size:12px;font-weight:700;'>i</div>
			        <div style='font-size:15px;font-weight:700;line-height:1.2;'>Avg. Time to Start</div>
			    </div>
			
			    <!-- DESCRIPTION -->
			    <div style='font-size:11px;line-height:1.5;margin-bottom:16px;'>
			        Shows the <b>average number of days</b> between an Arrangement being requested and effectively starting.
			    </div>
			
			    <!-- CALCULATION -->
			    <div style='font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:#666666;margin-bottom:6px;'>
			        How is it calculated?
			    </div>
			    <div style='font-size:11px;line-height:1.5;margin-bottom:16px;'>
			        For each Arrangement started during the selected timeframe, the difference between its <b>Start Date</b> and <b>Request Date</b> is calculated. The average of these differences is displayed in days.
			    </div>
			
			    <!-- INFO BOX -->
			    <div style='width:100%;box-sizing:border-box;background:#F5F5F5;border-radius:7px;padding:11px 12px;'>
			        <div style='font-size:10px;font-weight:700;margin-bottom:5px;'>Example</div>
			        <div style='font-size:10px;line-height:1.5;color:#555555;'>
			            If three Arrangements took 2, 4 and 6 days to start, the average time to start is <b>4 days</b>.
			        </div>
			    </div>
			
			    <!-- NOTE -->
			    <div style='margin-top:14px;padding-top:12px;border-top:1px solid #E5E5E5;font-size:10px;line-height:1.45;color:#666666;'>
			        <b>Important:</b> the selected timeframe applies to the Start Date, not the Request Date. Arrangements that have not started are excluded.
			    </div>
			
			</div>
			"
			
			```
		displayFolder: HTML
		lineageTag: 18c802dd-3929-436b-9d62-a279b11f8dd2

	measure '(HTML) Help - Arrangements by Type' = ```
			
			"
			<div style='width:100%;height:100%;box-sizing:border-box;padding:18px;font-family:Arial,sans-serif;color:#333333;background:#FFFFFF;'>
			
			    <!-- HEADER -->
			    <div style='display:flex;align-items:center;gap:8px;margin-bottom:14px;'>
			        <div style='width:22px;height:22px;flex:0 0 22px;display:flex;align-items:center;justify-content:center;background:#F2F2F2;border-radius:50%;font-size:12px;font-weight:700;'>i</div>
			        <div style='font-size:15px;font-weight:700;line-height:1.2;'>Arrangements by Type</div>
			    </div>
			
			    <!-- DESCRIPTION -->
			    <div style='font-size:11px;line-height:1.5;margin-bottom:16px;'>
			        Shows the distribution of Arrangements across the different <b>Arrangement Types</b>.
			    </div>
			
			    <!-- CHART -->
			    <div style='font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:#666666;margin-bottom:6px;'>
			        What does the chart show?
			    </div>
			    <div style='font-size:11px;line-height:1.5;margin-bottom:16px;'>
			        Each category represents an Arrangement Type and its corresponding number of Arrangements within the selected timeframe.
			    </div>
			
			    <!-- INFO BOX -->
			    <div style='width:100%;box-sizing:border-box;background:#F5F5F5;border-radius:7px;padding:11px 12px;'>
			        <div style='font-size:10px;font-weight:700;margin-bottom:5px;'>How to use this information</div>
			        <div style='font-size:10px;line-height:1.5;color:#555555;'>
			            Compare Arrangement Types to understand which types of support account for the largest share of activity.
			        </div>
			    </div>
			
			    <!-- NOTE -->
			    <div style='margin-top:14px;padding-top:12px;border-top:1px solid #E5E5E5;font-size:10px;line-height:1.45;color:#666666;'>
			        <b>Note:</b> the distribution follows the metric and date context applied to the visual. Selecting a category may filter other visuals on the page.
			    </div>
			
			</div>
			"
			
			```
		displayFolder: HTML
		lineageTag: 28538980-f8ae-4bf8-b05f-08e896b67870

	measure '(HTML) Help - Arrangements by Location' = ```
			
			"
			<div style='
			    width:100%;height:100%;box-sizing:border-box;padding:18px;
			    font-family:Arial,sans-serif;color:#333333;background:#FFFFFF;
			'>
			
			    <!-- HEADER -->
			    <div style='display:flex;align-items:center;gap:8px;margin-bottom:14px;'>
			        <div style='
			            width:22px;height:22px;flex:0 0 22px;
			            display:flex;align-items:center;justify-content:center;
			            background:#F2F2F2;border-radius:50%;
			            font-size:12px;font-weight:700;
			        '>i</div>
			
			        <div style='font-size:15px;font-weight:700;line-height:1.2;'>
			            Arrangements by Location
			        </div>
			    </div>
			
			    <!-- DESCRIPTION -->
			    <div style='font-size:11px;line-height:1.5;margin-bottom:16px;'>
			        Shows the <b>geographic distribution of Arrangements</b>
			        based on the location of the Client Person associated
			        with each Arrangement.
			    </div>
			
			    <!-- CHART -->
			    <div style='
			        font-size:10px;font-weight:700;text-transform:uppercase;
			        letter-spacing:0.5px;color:#666666;margin-bottom:6px;
			    '>
			        What does the visual show?
			    </div>
			
			    <div style='font-size:11px;line-height:1.5;margin-bottom:16px;'>
			        The map and accompanying table display Arrangement
			        activity according to the <b>Client Person's geographic
			        location</b>, helping identify where clients are located.
			    </div>
			
			    <!-- INFO BOX -->
			    <div style='
			        width:100%;box-sizing:border-box;
			        background:#F5F5F5;border-radius:7px;padding:11px 12px;
			    '>
			        <div style='font-size:10px;font-weight:700;margin-bottom:5px;'>
			            How to use this information
			        </div>
			
			        <div style='font-size:10px;line-height:1.5;color:#555555;'>
			            Explore the map or select a location in the table
			            to understand the geographic distribution of clients
			            associated with Arrangements and identify areas
			            with greater service demand.
			        </div>
			    </div>
			
			    <!-- NOTE -->
			    <div style='
			        margin-top:14px;padding-top:12px;
			        border-top:1px solid #E5E5E5;
			        font-size:10px;line-height:1.45;color:#666666;
			    '>
			        <b>Important:</b> locations represent where the
			        <b>Client Person</b> is located, not necessarily the
			        operational Location responsible for the Arrangement
			        or where services are delivered.
			    </div>
			
			</div>
			"
			
			```
		displayFolder: HTML
		lineageTag: 1ec62931-3cae-48fb-9e61-2665926c232e

	measure '(HTML) Help - Arrangements Over Time' = ```
			
			"
			<div style='
			    width:100%;height:100%;box-sizing:border-box;padding:18px;
			    font-family:Arial,sans-serif;color:#333333;background:#FFFFFF;
			'>
			
			    <!-- HEADER -->
			    <div style='display:flex;align-items:center;gap:8px;margin-bottom:14px;'>
			        <div style='
			            width:22px;height:22px;flex:0 0 22px;
			            display:flex;align-items:center;justify-content:center;
			            background:#F2F2F2;border-radius:50%;
			            font-size:12px;font-weight:700;
			        '>i</div>
			
			        <div style='font-size:15px;font-weight:700;line-height:1.2;'>
			            Arrangements Over Time
			        </div>
			    </div>
			
			    <!-- DESCRIPTION -->
			    <div style='font-size:11px;line-height:1.5;margin-bottom:16px;'>
			        Shows how Arrangement activity <b>changes over time</b>
			        within the selected timeframe, helping identify trends,
			        peaks and changes in demand or service activity.
			    </div>
			
			    <!-- CHART -->
			    <div style='
			        font-size:10px;font-weight:700;text-transform:uppercase;
			        letter-spacing:0.5px;color:#666666;margin-bottom:6px;
			    '>
			        How to explore the timeline
			    </div>
			
			    <div style='font-size:11px;line-height:1.5;margin-bottom:14px;'>
			        Move your mouse over the chart. A toolbar will appear
			        in the <b>top-right corner</b>, allowing you to navigate
			        between <b>Year, Month and Day</b> levels.
			    </div>
			
			    <!-- DRILL UP -->
			    <div style='
			        display:flex;align-items:center;gap:12px;
			        margin-bottom:14px;
			    '>
			
			        <div style='
			            width:36px;height:36px;flex:0 0 36px;
			            display:flex;align-items:center;justify-content:center;
			            background:#F5F5F5;border-radius:5px;
			        '>
			            <svg width='24' height='24' viewBox='0 0 24 24'
			                 fill='none' stroke='#45B9C8'
			                 stroke-width='1.3'
			                 stroke-linecap='square'
			                 stroke-linejoin='miter'>
			                <path d='M12 21V3 M4 11L12 3L20 11'/>
			            </svg>
			        </div>
			
			        <div style='font-size:11px;line-height:1.5;'>
			            <b>Drill Up</b><br/>
			            Click the upward arrow to move to a higher
			            level of the hierarchy:
			            <b>Day → Month → Year</b>.
			        </div>
			
			    </div>
			
			    <!-- EXPAND ALL -->
			    <div style='
			        display:flex;align-items:center;gap:12px;
			        margin-bottom:16px;
			    '>
			
			        <div style='
			            width:36px;height:36px;flex:0 0 36px;
			            display:flex;align-items:center;justify-content:center;
			            background:#F5F5F5;border-radius:5px;
			        '>
			            <svg width='24' height='24' viewBox='0 0 24 24'
			                 fill='none' stroke='#45B9C8'
			                 stroke-width='1.3'
			                 stroke-linecap='square'
			                 stroke-linejoin='miter'>
			                <path d='M12 3V10
			                         M5 10H19
			                         M5 10V20
			                         M19 10V20
			                         M1 16L5 20L9 16
			                         M15 16L19 20L23 16'/>
			            </svg>
			        </div>
			
			        <div style='font-size:11px;line-height:1.5;'>
			            <b>Expand All Down One Level</b><br/>
			            Click the branching downward arrow to expand
			            the hierarchy:
			            <b>Year → Month → Day</b>,
			            keeping previous levels visible.
			        </div>
			
			    </div>
			
			    <!-- INFO BOX -->
			    <div style='
			        width:100%;box-sizing:border-box;
			        background:#F5F5F5;border-radius:7px;
			        padding:11px 12px;
			    '>
			
			        <div style='
			            font-size:10px;font-weight:700;margin-bottom:5px;
			        '>
			            Tip: Explore different levels of detail
			        </div>
			
			        <div style='
			            font-size:10px;line-height:1.5;color:#555555;
			        '>
			            Start with the yearly overview, expand into months
			            to identify trends, and continue into days for a
			            more detailed analysis.
			        </div>
			
			    </div>
			
			    <!-- NOTE -->
			    <div style='
			        margin-top:14px;padding-top:12px;
			        border-top:1px solid #E5E5E5;
			        font-size:10px;line-height:1.45;color:#666666;
			    '>
			        <b>Note:</b> navigating the date hierarchy changes
			        the level of detail displayed, but does not change
			        the selected report timeframe.
			    </div>
			
			</div>
			"
			
			```
		displayFolder: HTML
		lineageTag: 32c17ac3-47d5-478d-8496-8dacf530ec79

	measure '(HTML) Help - Request Outcomes' = ```
			
			"
			<div style='width:100%;height:100%;box-sizing:border-box;padding:18px;font-family:Arial,sans-serif;color:#333333;background:#FFFFFF;'>
			
			    <!-- HEADER -->
			    <div style='display:flex;align-items:center;gap:8px;margin-bottom:14px;'>
			        <div style='width:22px;height:22px;flex:0 0 22px;display:flex;align-items:center;justify-content:center;background:#F2F2F2;border-radius:50%;font-size:12px;font-weight:700;'>i</div>
			        <div style='font-size:15px;font-weight:700;line-height:1.2;'>Request Outcomes</div>
			    </div>
			
			    <!-- DESCRIPTION -->
			    <div style='font-size:11px;line-height:1.5;margin-bottom:16px;'>
			        Shows the <b>current outcomes of Arrangements requested during the selected timeframe</b>.
			    </div>
			
			    <!-- CALCULATION -->
			    <div style='font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:#666666;margin-bottom:6px;'>
			        How is it calculated?
			    </div>
			    <div style='font-size:11px;line-height:1.5;margin-bottom:16px;'>
			        First, Arrangements are selected using their <b>Request Date</b>. Their current outcomes are then evaluated, regardless of when they started or ended.
			    </div>
			
			    <!-- INFO BOX -->
			    <div style='width:100%;box-sizing:border-box;background:#F5F5F5;border-radius:7px;padding:11px 12px;'>
			        <div style='font-size:10px;font-weight:700;margin-bottom:5px;'>Understanding the outcomes</div>
			        <div style='font-size:10px;line-height:1.5;color:#555555;'>
			            <b>Cancelled:</b> requests that were cancelled.<br/>
			            <b>Not Started:</b> requests that have not started.<br/>
			            <b>In Progress:</b> requests currently in progress.<br/>
			            <b>Ended:</b> requests whose Arrangements have ended.
			        </div>
			    </div>
			
			    <!-- NOTE -->
			    <div style='margin-top:14px;padding-top:12px;border-top:1px solid #E5E5E5;font-size:10px;line-height:1.45;color:#666666;'>
			        <b>Important:</b> this is a request-based cohort analysis. It follows Arrangements requested during the selected timeframe, even when their outcomes occur later.
			    </div>
			
			</div>
			"
			
			```
		displayFolder: HTML
		lineageTag: 92269cd3-87f1-456f-885f-f39dc6fc3cb1

