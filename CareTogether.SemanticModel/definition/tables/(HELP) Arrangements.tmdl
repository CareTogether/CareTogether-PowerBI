	measure '(HTML) Help - Avg. Duration' =
			
			"
			<div style='
			    width:100%;height:100%;box-sizing:border-box;padding:18px;
			    font-family:Arial,sans-serif;color:#333333;background:#FFFFFF;
			'>
			
			    <!-- HEADER -->
			    <div style='display:flex;align-items:center;gap:8px;margin-bottom:14px;'>
			        <div style='
			            width:22px;height:22px;flex:0 0 22px;
			            display:flex;align-items:center;justify-content:center;
			            background:#F2F2F2;border-radius:50%;
			            font-size:12px;font-weight:700;
			        '>i</div>
			
			        <div style='font-size:15px;font-weight:700;line-height:1.2;'>
			            Average Arrangement Duration
			        </div>
			    </div>
			
			    <!-- DESCRIPTION -->
			    <div style='font-size:11px;line-height:1.5;margin-bottom:16px;'>
			        Shows the <b>average number of days Arrangements have
			        remained active</b>, including both completed and ongoing
			        Arrangements that started during the selected timeframe.
			    </div>
			
			    <!-- CALCULATION -->
			    <div style='
			        font-size:10px;font-weight:700;text-transform:uppercase;
			        letter-spacing:0.5px;color:#666666;margin-bottom:6px;
			    '>
			        How is it calculated?
			    </div>
			
			    <div style='font-size:11px;line-height:1.5;margin-bottom:16px;'>
			        For <b>completed Arrangements</b>, duration is calculated
			        from the Start Date to the End Date.
			        <br/><br/>
			        For <b>ongoing Arrangements</b>, duration is calculated
			        from the Start Date to today.
			        <br/><br/>
			        The average is calculated across all eligible Arrangements,
			        using their <b>Start Date</b> to determine whether they
			        belong to the selected timeframe.
			    </div>
			
			    <!-- INFO BOX -->
			    <div style='
			        width:100%;box-sizing:border-box;
			        background:#F5F5F5;border-radius:7px;padding:11px 12px;
			    '>
			        <div style='font-size:10px;font-weight:700;margin-bottom:5px;'>
			            Which Arrangements are included?
			        </div>
			
			        <div style='font-size:10px;line-height:1.5;color:#555555;'>
			            Only Arrangements that have started and are not
			            cancelled are included.
			            <br/><br/>
			            Arrangements without a Start Date, with a future
			            Start Date, or with an invalid negative duration
			            are excluded.
			        </div>
			    </div>
			
			    <!-- NOTE -->
			    <div style='
			        margin-top:14px;padding-top:12px;
			        border-top:1px solid #E5E5E5;
			        font-size:10px;line-height:1.45;color:#666666;
			    '>
			        <b>Important:</b> Ongoing Arrangements continue accumulating
			        days until they end, so the average may change over time.
			        Previous Period (PP) uses the same calculation for
			        Arrangements started in the immediately preceding period
			        of equal length. Both periods measure ongoing duration
			        through today.
			    </div>
			
			</div>
			"
		displayFolder: HTML
		lineageTag: d8698b99-fcab-41a8-820f-5c55f52dc0a3

