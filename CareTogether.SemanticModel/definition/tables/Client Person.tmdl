table 'Client Person'
	lineageTag: 11e18395-5d20-4b6b-ae25-440ababb8222

	measure '# of Client Families Supported' =
			
			
			/*
			
			Counts unique families that received support at any point during the selected period. Each family is counted only once, regardless of how many people or Arrangements are associated with that family. A single-day selection shows families supported on that day, while a wider date range includes families supported at any point during that period. Future support is excluded.
			
			*/
			
			VAR Today = TODAY()
			VAR CurrentStartDate = [Selected Timeframe Start]
			VAR CurrentEndDate = MIN(Today, [Selected Timeframe End])
			
			RETURN
			IF(
			    CurrentStartDate > Today,
			    BLANK(),
			    COUNTROWS(
			        FILTER(
			            VALUES('Client Person'[family_id]),
			            CALCULATE(
			                COUNTROWS(
			                    FILTER(
			                        RELATEDTABLE(Arrangement),
			                        NOT(ISBLANK(Arrangement[started_utc])) &&
			                        Arrangement[started_utc] <= CurrentEndDate &&
			                        (
			                            ISBLANK(Arrangement[ended_utc]) ||
			                            Arrangement[ended_utc] >= CurrentStartDate
			                        )
			                    )
			                )
			            ) > 0
			        )
			    )
			)
		formatString: 0
		lineageTag: 30c40e40-cc0e-4a41-a456-19db89ef39e3

