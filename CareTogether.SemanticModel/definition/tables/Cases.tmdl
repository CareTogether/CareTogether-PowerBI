table Cases
	lineageTag: 23bf38dd-4523-4833-8aa7-9afd794cc2f9

	measure '# of Cases Opened CP' =
			
			/*
			CP = Current Period
			Counts unique Cases opened within the selected timeframe.
			*/
			
			VAR selectedStartDate = [Selected Timeframe Start]
			VAR selectedEndDate = [Selected Timeframe End]
			
			RETURN
			CALCULATE(
			    DISTINCTCOUNT('Cases'[case_id]),
			    'Cases'[opened] >= selectedStartDate,
			    'Cases'[opened] < selectedEndDate + 1,
			    USERELATIONSHIP('Cases'[location_id], Location[location_id])
			)
		formatString: #,0
		lineageTag: 36a58840-a5d2-4a24-a649-142331365cbb

	measure '# of Cases Opened PP' =
			
			/*
			PP = Previous Period
			Counts the number of Cases opened during the period immediately preceding the selected timeframe.
			*/
			
			VAR currentStartDate = [Selected Timeframe Start]
			VAR currentEndDate = [Selected Timeframe End]
			VAR periodDays = DATEDIFF(currentStartDate, currentEndDate, DAY) + 1
			VAR previousStartDate = currentStartDate - periodDays
			VAR previousEndDate = currentStartDate - 1
			
			RETURN
			CALCULATE(
			    DISTINCTCOUNT('Cases'[case_id]),
			    'Cases'[opened] >= previousStartDate,
			    'Cases'[opened] < previousEndDate + 1,
			    USERELATIONSHIP('Cases'[location_id], Location[location_id])
			)
		formatString: #,0
		lineageTag: 9e973988-baba-48cd-9abb-26a064a6b04a

	measure '# of Cases Opened PoP' =
			
			VAR currentPeriod = [# of Cases Opened CP]
			VAR previousPeriod = [# of Cases Opened PP]
			VAR perc = DIVIDE(currentPeriod - previousPeriod, previousPeriod)
			
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(perc), BLANK(),
			    perc >= 0, FORMAT(perc, "+0%") & "▲",
			    perc < 0, FORMAT(perc, "0%") & "▼",
			    "0%"
			)
		lineageTag: ba929364-62f4-42bb-86a4-eac154f52bf1

	measure '# of Cases Closed CP' = ```
			
			/*
			CP = Current Period
			
			Counts the number of unique Cases closed within the
			selected timeframe, regardless of when they were opened.
			
			The selected timeframe is applied to the Case Closing Date.
			*/
			
			VAR selectedStartDate = [Selected Timeframe Start]
			VAR selectedEndDate = [Selected Timeframe End]
			
			RETURN
			CALCULATE(
			    DISTINCTCOUNT('Cases'[case_id]),
			    'Cases'[closed] >= selectedStartDate,
			    'Cases'[closed] < selectedEndDate + 1,
			    NOT ISBLANK('Cases'[closed]),
			    USERELATIONSHIP(
			        'Cases'[location_id],
			        Location[location_id]
			    )
			)
			
			```
		formatString: #,0
		lineageTag: f5fff5c7-b5c5-402c-81f3-9aeab498d5b9

	measure '# of Cases Closed PP' = ```
			
			/*
			PP = Previous Period
			
			Counts the number of unique Cases closed during the
			previous equivalent period, regardless of when they
			were opened.
			
			The previous timeframe is applied to the Case Closing Date.
			*/
			
			VAR currentStartDate = [Selected Timeframe Start]
			VAR currentEndDate = [Selected Timeframe End]
			
			VAR periodDays =
			    DATEDIFF(currentStartDate, currentEndDate, DAY) + 1
			
			VAR previousStartDate =
			    currentStartDate - periodDays
			
			VAR previousEndDate =
			    currentStartDate - 1
			
			RETURN
			CALCULATE(
			    DISTINCTCOUNT('Cases'[case_id]),
			    'Cases'[closed] >= previousStartDate,
			    'Cases'[closed] < previousEndDate + 1,
			    NOT ISBLANK('Cases'[closed]),
			    USERELATIONSHIP(
			        'Cases'[location_id],
			        Location[location_id]
			    )
			)
			
			```
		formatString: #,0
		lineageTag: 787e05c4-6146-4ffe-8080-a3c20c5766c8

	measure '# of Cases Closed PoP' =
			
			VAR currentPeriod = [# of Cases Closed CP]
			VAR previousPeriod = [# of Cases Closed PP]
			VAR perc = DIVIDE(currentPeriod - previousPeriod, previousPeriod)
			
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(perc), BLANK(),
			    perc >= 0, FORMAT(perc, "+0%") & "▲",
			    perc < 0, FORMAT(perc, "0%") & "▼",
			    "0%"
			)
		lineageTag: 233edad0-10a1-42fe-b17f-df59e1b197db

	measure '# of Families with Cases CP' =
			
			/*
			CP = Current Period
			Counts unique Families with at least one Case opened within the selected timeframe.
			*/
			
			VAR selectedStartDate = [Selected Timeframe Start]
			VAR selectedEndDate = [Selected Timeframe End]
			
			RETURN
			CALCULATE(
			    DISTINCTCOUNT('Cases'[family_id]),
			    'Cases'[opened] >= selectedStartDate,
			    'Cases'[opened] < selectedEndDate + 1,
			    NOT ISBLANK('Cases'[family_id]),
			    USERELATIONSHIP('Cases'[location_id], Location[location_id])
			)
		formatString: #,0
		lineageTag: 97af483c-dae0-483c-8e8d-d50b0c09f7bb

	measure '# of Families with Cases PP' =
			
			/*
			PP = Previous Period
			Counts unique Families with at least one Case opened during the previous equivalent period.
			*/
			
			VAR currentStartDate = [Selected Timeframe Start]
			VAR currentEndDate = [Selected Timeframe End]
			VAR periodDays = DATEDIFF(currentStartDate, currentEndDate, DAY) + 1
			
			VAR previousStartDate = currentStartDate - periodDays
			VAR previousEndDate = currentStartDate - 1
			
			RETURN
			CALCULATE(
			    DISTINCTCOUNT('Cases'[family_id]),
			    'Cases'[opened] >= previousStartDate,
			    'Cases'[opened] < previousEndDate + 1,
			    NOT ISBLANK('Cases'[family_id]),
			    USERELATIONSHIP('Cases'[location_id], Location[location_id])
			)
		formatString: #,0
		lineageTag: ee9b9e22-fdf7-4b21-9887-4e73208fd300

	measure '# of Families with Cases PoP' =
			
			VAR currentPeriod = [# of Families with Cases CP]
			VAR previousPeriod = [# of Families with Cases PP]
			VAR perc = DIVIDE(currentPeriod - previousPeriod, previousPeriod)
			
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(perc), BLANK(),
			    perc >= 0, FORMAT(perc, "+0%") & "▲",
			    perc < 0, FORMAT(perc, "0%") & "▼",
			    "0%"
			)
		lineageTag: 53da9d2a-4cc7-4732-a09e-b020c3e359c9

	measure 'Avg. Days Between Cases CP' =
			
			/*
			CP = Current Period
			Calculates the average number of days between consecutive Cases
			for Cases opened within the selected timeframe.
			
			Only returning Families are included, since the first Case of a Family
			has no previous Case.
			*/
			
			VAR selectedStartDate = [Selected Timeframe Start]
			VAR selectedEndDate = [Selected Timeframe End]
			
			RETURN
			CALCULATE(
			    AVERAGE('Cases'[days_between_cases]),
			    'Cases'[opened] >= selectedStartDate,
			    'Cases'[opened] < selectedEndDate + 1,
			    NOT ISBLANK('Cases'[days_between_cases]),
			    USERELATIONSHIP('Cases'[location_id], Location[location_id])
			)
		formatString: #,0
		lineageTag: 3ba2fa12-7752-445b-829b-ad0a2c910cf7

	measure 'Avg. Days Between Cases PP' =
			
			/*
			PP = Previous Period
			Calculates the average number of days between consecutive Cases
			for Cases opened during the previous equivalent period.
			
			Only returning Families are included, since the first Case of a Family
			has no previous Case.
			*/
			
			VAR currentStartDate = [Selected Timeframe Start]
			VAR currentEndDate = [Selected Timeframe End]
			VAR periodDays = DATEDIFF(currentStartDate, currentEndDate, DAY) + 1
			VAR previousStartDate = currentStartDate - periodDays
			VAR previousEndDate = currentStartDate - 1
			
			RETURN
			CALCULATE(
			    AVERAGE('Cases'[days_between_cases]),
			    'Cases'[opened] >= previousStartDate,
			    'Cases'[opened] < previousEndDate + 1,
			    NOT ISBLANK('Cases'[days_between_cases]),
			    USERELATIONSHIP('Cases'[location_id], Location[location_id])
			)
		lineageTag: ac9f4ed6-1770-44e5-ac15-a99900a5e5ff

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg. Days Between Cases PoP' =
			
			VAR currentPeriod = [Avg. Days Between Cases CP]
			VAR previousPeriod = [Avg. Days Between Cases PP]
			VAR perc = DIVIDE(currentPeriod - previousPeriod, previousPeriod)
			
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(perc), BLANK(),
			    perc >= 0, FORMAT(perc, "+0%") & "▲",
			    perc < 0, FORMAT(perc, "0%") & "▼",
			    "0%"
			)
		lineageTag: f88a2e41-d010-4422-b5ad-a300eb165591

