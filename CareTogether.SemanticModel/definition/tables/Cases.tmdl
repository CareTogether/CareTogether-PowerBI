	column case_family_type =
			
			
			/*
			Classifies the Family for each Case based on its Case history.
			
			New Family:
			The Case is the first Case opened for the Family.
			
			Returning Family:
			The Family had at least one Case opened before the current Case.
			*/
			
			VAR currentFamily = 'Cases'[family_id]
			VAR currentOpened = 'Cases'[opened]
			
			VAR previousCases =
			    CALCULATE(
			        DISTINCTCOUNT('Cases'[case_id]),
			        FILTER(
			            ALL('Cases'),
			            'Cases'[family_id] = currentFamily &&
			            'Cases'[opened] < currentOpened
			        )
			    )
			
			RETURN
			IF(
			    ISBLANK(currentFamily) || ISBLANK(currentOpened),
			    BLANK(),
			    IF(previousCases > 0, "Returning Family", "New Family")
			)
		displayFolder: _calculated_columns
		lineageTag: c2b8ab3f-f2df-4538-88c7-3eeb41ff0d48
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column previous_case_opened =
			
			/*
			Returns the opening date of the most recent Case previously opened
			for the same Family.
			
			Returns blank when the current Case is the Family's first Case.
			*/
			
			VAR currentFamily = 'Cases'[family_id]
			VAR currentOpened = 'Cases'[opened]
			
			RETURN
			IF(
			    ISBLANK(currentFamily) || ISBLANK(currentOpened),
			    BLANK(),
			    MAXX(
			        FILTER(
			            ALL('Cases'),
			            'Cases'[family_id] = currentFamily &&
			            'Cases'[opened] < currentOpened
			        ),
			        'Cases'[opened]
			    )
			)
		formatString: General Date
		displayFolder: _calculated_columns
		lineageTag: 793b0e27-606d-44fa-9d77-f6845e30dd81
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column days_between_cases =
			
			/*
			Calculates the number of days between the opening of the previous Case
			and the opening of the current Case for the same Family.
			
			Returns blank when there is no previous Case.
			*/
			
			VAR previousOpened = 'Cases'[previous_case_opened]
			
			RETURN
			IF(
			    ISBLANK(previousOpened),
			    BLANK(),
			    DATEDIFF(previousOpened, 'Cases'[opened], DAY)
			)
		formatString: 0
		displayFolder: _calculated_columns
		lineageTag: 2e397eb9-cc70-4956-83db-85349d5db2b4
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Volunteers & Roles' =
			
			VAR personRoles =
			    DISTINCT(
			        SELECTCOLUMNS(
			            RELATEDTABLE('Volunteer Person Case Role Assignment'),
			            "Person", 'Volunteer Person Case Role Assignment'[person_name],
			            "Role", 'Volunteer Person Case Role Assignment'[role]
			        )
			    )
			
			RETURN
			CONCATENATEX(
			    personRoles,
			    [Person] & " (" & [Role] & ")",
			    UNICHAR(10),
			    [Person],
			    ASC
			)
		displayFolder: _calculated_columns
		lineageTag: 68f8217f-739d-4fe8-8a9d-fa02583b66ae
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Cases = m
		mode: import
		queryGroup: Facts
		source =
				let
				  Source = #"OData",
				  Cases = Source{[Name="Cases", Signature="table"]}[Data],
				
				  selectColumns = Table.SelectColumns(
				    Cases,
				    {
				      "CaseId",
				      "OrganizationId",
				      "LocationId",
				      "FamilyId",
				      "Opened",
				      "Closed",
				      "ReferralSource",
				      "CloseReason",
				      "PrimaryReasonForReferral"
				    }
				  ),
				
				  renameColumns = Table.RenameColumns(
				    selectColumns,
				    {
				      {"CaseId", "case_id"},
				      {"OrganizationId", "organization_id"},
				      {"LocationId", "location_id"},
				      {"FamilyId", "family_id"},
				      {"Opened", "opened"},
				      {"Closed", "closed"},
				      {"ReferralSource", "referral_source"},
				      {"CloseReason", "close_reason"},
				      {"PrimaryReasonForReferral", "primary_reason_for_referral"}
				    }
				  ),
				
				  addRLSKey = Table.AddColumn(
				    renameColumns,
				    "rls_key",
				    each Text.Combine({[organization_id], "-", [location_id]})
				  ),
				
				  addCaseUniqueKey = Table.AddColumn(
				      addRLSKey,
				      "case_uid",
				      each
				          if [case_id] <> null then
				              Text.Combine({[rls_key], "-", [case_id]})
				          else
				              null,
				      type text
				  ),
				
				  addFamilyUniqueKey = Table.AddColumn(
				      addCaseUniqueKey,
				      "family_uid",
				      each
				          if [family_id] <> null then
				              Text.Combine({[rls_key], "-", [family_id]})
				          else
				              null,
				      type text
				  ),
				
				  properCaseCloseReason = Table.TransformColumns(addFamilyUniqueKey, {{"close_reason", Text.Proper, type text}}),
				
				  addCloseReasonUniqueKey = Table.AddColumn(
				    properCaseCloseReason,
				    "close_reason_uid",
				    each
				      if [close_reason] <> null then
				        Text.Combine({[rls_key], "-", [close_reason]})
				      else
				        null,
				    type text
				  )
				
				in
				  addCloseReasonUniqueKey

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

