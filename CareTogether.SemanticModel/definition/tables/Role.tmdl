	partition Role = m
		mode: import
		queryGroup: Dimensions
		source = ```
				let
				  Source = #"OData",
				  Role = Source{[Name="Role", Signature="table"]}[Data],
				  
				  selectColumns = Table.SelectColumns(
				    Role,
				    {
				      "OrganizationId",
				      "Name"
				    }
				  ),
				
				  renameColumns = Table.RenameColumns(
				    selectColumns,
				    {
				      {"OrganizationId", "organization_id"},
				      {"Name", "role_name"}
				    }
				  ),
				
				  addRoleUniqueKey = Table.AddColumn(
				      renameColumns,
				      "role_uid",
				      each
				          if [role_name] <> null then
				              Text.Combine({[organization_id], "-", [role_name]})
				          else
				              null,
				      type text
				  )
				in
				  addRoleUniqueKey
				```

