	partition 'Volunteer Person' = m
		mode: import
		queryGroup: Dimensions
		source = ```
				let
				  Source = #"OData",
				  Person = Source{[Name="Person", Signature="table"]}[Data],
				  
				  removeDuplicatedRecords = Table.Distinct(Person, {"Id", "OrganizationId", "LocationId"}),
				  addFullName = Table.AddColumn(removeDuplicatedRecords, "full_name", each Text.Combine({[FirstName], " ", [LastName]})),
				
				  expandFamily = Table.ExpandRecordColumn(addFullName, "Family", 
				    {"Name", "PrimaryEmail", "PrimaryPhoneNumber", "PrimaryAddress", "HomeChurch"}, 
				    {"Family.Name", "Family.PrimaryEmail", "Family.PrimaryPhoneNumber", "Family.PrimaryAddress", "Family.HomeChurch"}
				  ),
				  
				  expandFamilyPrimaryAddress = Table.ExpandRecordColumn(expandFamily, "Family.PrimaryAddress", 
				    {"Line1", "Line2", "City", "County", "State", "PostalCode"}, 
				    {"Family.PrimaryAddress.Line1", "Family.PrimaryAddress.Line2", "Family.PrimaryAddress.City", "Family.PrimaryAddress.County", 
				    "Family.PrimaryAddress.State", "Family.PrimaryAddress.PostalCode"}
				  ),
				
				  selectColumns = Table.SelectColumns(
				    expandFamilyPrimaryAddress,
				    {
				      "Id", 
				      "OrganizationId", 
				      "LocationId", 
				      "FamilyId", 
				      "FirstName", 
				      "LastName",
				      "full_name",
				      "PersonType", 
				      "Ethnicity", 
				      "DateOfBirth", 
				      "Gender",
				      "Family.Name", 
				      "Family.PrimaryEmail", 
				      "Family.PrimaryPhoneNumber",
				      "Family.PrimaryAddress.Line1", 
				      "Family.PrimaryAddress.Line2", 
				      "Family.PrimaryAddress.City", 
				      "Family.PrimaryAddress.County", 
				      "Family.PrimaryAddress.State", 
				      "Family.PrimaryAddress.PostalCode"
				    }
				  ),
				
				  renameColumns = Table.RenameColumns(
				    selectColumns,
				    {
				      {"Id", "person_id"},
				      {"OrganizationId", "organization_id"},
				      {"LocationId", "location_id"},
				      {"FamilyId", "family_id"},
				      {"FirstName", "first_name"},
				      {"LastName", "last_name"},
				      {"full_name", "full_name"},
				      {"PersonType", "person_type"},
				      {"Ethnicity", "ethnicity"},
				      {"DateOfBirth", "date_of_birth"},
				      {"Gender", "gender"},
				      {"Family.Name", "family_name"},
				      {"Family.PrimaryEmail", "email"},
				      {"Family.PrimaryPhoneNumber", "phone_number"},
				      {"Family.PrimaryAddress.Line1", "address_line_1"},
				      {"Family.PrimaryAddress.Line2", "address_line_2"},
				      {"Family.PrimaryAddress.City", "city"}, 
				      {"Family.PrimaryAddress.County", "county"},
				      {"Family.PrimaryAddress.State", "state"},
				      {"Family.PrimaryAddress.PostalCode", "postal_code"}
				    }
				  ),
				
				  addRLSKey = Table.AddColumn(
				    renameColumns,
				    "rls_key",
				    each Text.Combine({[organization_id], "-", [location_id]})
				  ),
				
				  addPersonUniqueKey = Table.AddColumn(
				    addRLSKey,
				    "person_uid",
				    each
				      if [person_id] <> null then
				        Text.Combine({[rls_key], "-", [person_id]})
				      else
				        null,
				      type text
				  ),
				
				  addFamilyUniqueKey = Table.AddColumn(
				      addPersonUniqueKey,
				      "family_uid",
				      each
				          if [family_id] <> null then
				              Text.Combine({[rls_key], "-", [family_id]})
				          else
				              null,
				      type text
				  )
				
				in
				
				  addFamilyUniqueKey
				```

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

