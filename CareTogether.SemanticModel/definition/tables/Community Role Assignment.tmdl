	partition 'Community Role Assignment' = m
		mode: import
		queryGroup: Facts
		source = ```
				let
				  Source = #"OData",
				  communityRoleAssignment = Source{[Name="CommunityRoleAssignments", Signature="table"]}[Data],
				
				  selectColumns = Table.SelectColumns(
				    communityRoleAssignment,
				    {
				      "OrganizationId",
				      "LocationId",
				      "CommunityId",
				      "PersonId",
				      "Role"
				    }
				  ),
				
				  renameColumns = Table.RenameColumns(
				    selectColumns,
				    {
				      {"OrganizationId", "organization_id"},
				      {"LocationId", "location_id"},
				      {"CommunityId", "community_id"},
				      {"PersonId", "person_id"},
				      {"Role", "role"}
				    }
				  ),
				
				  addRLSKey = Table.AddColumn(
				    renameColumns,
				    "rls_key",
				    each Text.Combine({[organization_id], "-", [location_id]})
				  ),
				
				  addPersonUniqueKey = Table.AddColumn(
				      addRLSKey,
				      "person_uid",
				      each
				          if [person_id] <> null then
				              Text.Combine({[rls_key], "-", [person_id]})
				          else
				              null,
				      type text
				  ),
				
				  addCommunityUniqueKey = Table.AddColumn(
				      addPersonUniqueKey,
				      "community_uid",
				      each
				          if [community_id] <> null then
				              Text.Combine({[rls_key], "-", [community_id]})
				          else
				              null,
				      type text
				  )
				  
				in
				
				  addCommunityUniqueKey
				```

