	measure '(HTML) Help - Assigned and Caring Individual Volunteers' =
			
			"
			<div style='
			    width:100%;height:100%;box-sizing:border-box;padding:18px;
			    font-family:Arial,sans-serif;color:#333333;background:#FFFFFF;
			'>
			
			    <!-- HEADER -->
			    <div style='display:flex;align-items:center;gap:8px;margin-bottom:14px;'>
			        <div style='
			            width:22px;height:22px;flex:0 0 22px;
			            display:flex;align-items:center;justify-content:center;
			            background:#F2F2F2;border-radius:50%;
			            font-size:12px;font-weight:700;
			        '>i</div>
			
			        <div style='font-size:15px;font-weight:700;line-height:1.2;'>
			            Assigned and Caring Individual Volunteers
			        </div>
			    </div>
			
			    <!-- DESCRIPTION -->
			    <div style='font-size:11px;line-height:1.5;margin-bottom:16px;'>
			        Shows the number of <b>approved individual volunteers</b>
			        with active Arrangement assignments on the
			        selected reference date.
			    </div>
			
			    <!-- METRIC -->
			    <div style='
			        font-size:10px;font-weight:700;text-transform:uppercase;
			        letter-spacing:0.5px;color:#666666;margin-bottom:6px;
			    '>
			        How is this metric calculated?
			    </div>
			
			    <div style='font-size:11px;line-height:1.5;margin-bottom:16px;'>
			        For individual volunteers,
			        <b>Assigned and Caring is equivalent to Assigned</b>.
			        Volunteers must have a valid Approved or Onboarded
			        role and an active Arrangement assignment
			        matching that role.
			        Each volunteer is counted only once.
			    </div>
			
			    <!-- INFO BOX -->
			    <div style='
			        width:100%;box-sizing:border-box;
			        background:#F5F5F5;border-radius:7px;padding:11px 12px;
			    '>
			        <div style='font-size:10px;font-weight:700;margin-bottom:5px;'>
			            How to use this information
			        </div>
			
			        <div style='font-size:10px;line-height:1.5;color:#555555;'>
			            Use this metric to understand the number of
			            <b>individual volunteers actively participating</b>
			            in Arrangements on the selected date.
			            Unlike volunteer families, no separate
			            childcare record is required.
			        </div>
			    </div>
			
			    <!-- NOTE -->
			    <div style='
			        margin-top:14px;padding-top:12px;
			        border-top:1px solid #E5E5E5;
			        font-size:10px;line-height:1.45;color:#666666;
			    '>
			        <b>Note:</b> This metric has the same value as
			        Assigned Individual Volunteers.
			        These are not separate groups and should
			        not be added together.
			    </div>
			
			</div>
			"
		displayFolder: HTML
		lineageTag: 919f06ad-0960-4716-9c7f-2c141c6f3686

	measure '(HTML) Help - Individual Volunteer Capacity Utilization' =
			
			"
			<div style='
			    width:100%;height:100%;box-sizing:border-box;padding:18px;
			    font-family:Arial,sans-serif;color:#333333;background:#FFFFFF;
			'>
			
			    <!-- HEADER -->
			    <div style='display:flex;align-items:center;gap:8px;margin-bottom:14px;'>
			        <div style='
			            width:22px;height:22px;flex:0 0 22px;
			            display:flex;align-items:center;justify-content:center;
			            background:#F2F2F2;border-radius:50%;
			            font-size:12px;font-weight:700;
			        '>i</div>
			
			        <div style='font-size:15px;font-weight:700;line-height:1.2;'>
			            Individual Volunteer Capacity Utilization
			        </div>
			    </div>
			
			    <!-- DESCRIPTION -->
			    <div style='font-size:11px;line-height:1.5;margin-bottom:16px;'>
			        Shows the proportion of <b>approved individual volunteers</b>
			        with active Arrangement assignments on the
			        selected reference date.
			    </div>
			
			    <!-- METRIC -->
			    <div style='
			        font-size:10px;font-weight:700;text-transform:uppercase;
			        letter-spacing:0.5px;color:#666666;margin-bottom:6px;
			    '>
			        How is utilization calculated?
			    </div>
			
			    <div style='font-size:11px;line-height:1.5;margin-bottom:16px;'>
			        <b>Assignment Rate</b> is calculated by dividing
			        Assigned Individual Volunteers by Approved
			        Individual Volunteers.
			        For individuals, <b>Caring Rate equals Assignment Rate</b>.
			        Both rates use the same reference date.
			    </div>
			
			    <!-- INFO BOX -->
			    <div style='
			        width:100%;box-sizing:border-box;
			        background:#F5F5F5;border-radius:7px;padding:11px 12px;
			    '>
			        <div style='font-size:10px;font-weight:700;margin-bottom:5px;'>
			            How to read the visualization
			        </div>
			
			        <div style='font-size:10px;line-height:1.5;color:#555555;'>
			            The bar represents the total approved individual
			            volunteer capacity. The <b>assigned portion</b>
			            shows volunteers with active assignments.
			            The remaining portion represents approved
			            volunteers without an active assignment.
			        </div>
			    </div>
			
			    <!-- NOTE -->
			    <div style='
			        margin-top:14px;padding-top:12px;
			        border-top:1px solid #E5E5E5;
			        font-size:10px;line-height:1.45;color:#666666;
			    '>
			        <b>Note:</b> For individuals, Caring and Assigned
			        represent the same volunteers and are not added
			        together. Volunteers without active assignments
			        are not necessarily available.
			        This visualization represents a snapshot,
			        not cumulative activity over time.
			    </div>
			
			</div>
			"
		displayFolder: HTML
		lineageTag: ef1668fd-fad5-484d-aa13-371aa956846e

	measure '(HTML) Help - Individual Volunteer Capacity by Role' =
			
			"
			<div style='
			    width:100%;height:100%;box-sizing:border-box;padding:18px;
			    font-family:Arial,sans-serif;color:#333333;background:#FFFFFF;
			'>
			
			    <!-- HEADER -->
			    <div style='display:flex;align-items:center;gap:8px;margin-bottom:14px;'>
			        <div style='
			            width:22px;height:22px;flex:0 0 22px;
			            display:flex;align-items:center;justify-content:center;
			            background:#F2F2F2;border-radius:50%;
			            font-size:12px;font-weight:700;
			        '>i</div>
			
			        <div style='font-size:15px;font-weight:700;line-height:1.2;'>
			            Individual Volunteer Capacity by Role
			        </div>
			    </div>
			
			    <!-- DESCRIPTION -->
			    <div style='font-size:11px;line-height:1.5;margin-bottom:16px;'>
			        Shows the distribution of <b>approved individual volunteers</b>
			        across different roles and their active assignments
			        on the selected reference date.
			    </div>
			
			    <!-- METRIC -->
			    <div style='
			        font-size:10px;font-weight:700;text-transform:uppercase;
			        letter-spacing:0.5px;color:#666666;margin-bottom:6px;
			    '>
			        How are roles evaluated?
			    </div>
			
			    <div style='font-size:11px;line-height:1.5;margin-bottom:16px;'>
			        <b>Approved</b> includes volunteers with a valid
			        Approved or Onboarded status for the role.
			        <b>Assigned</b> includes approved volunteers with
			        an active Arrangement assignment matching
			        that specific role.
			        For individuals, <b>Caring equals Assigned</b>.
			    </div>
			
			    <!-- INFO BOX -->
			    <div style='
			        width:100%;box-sizing:border-box;
			        background:#F5F5F5;border-radius:7px;padding:11px 12px;
			    '>
			        <div style='font-size:10px;font-weight:700;margin-bottom:5px;'>
			            How to read the visualization
			        </div>
			
			        <div style='font-size:10px;line-height:1.5;color:#555555;'>
			            Each row represents an individual volunteer role.
			            The bar shows the proportion of approved volunteers
			            with active assignments for that role.
			            Roles are ordered by <b>Assignment Rate</b>
			            to compare utilization across functions.
			        </div>
			    </div>
			
			    <!-- NOTE -->
			    <div style='
			        margin-top:14px;padding-top:12px;
			        border-top:1px solid #E5E5E5;
			        font-size:10px;line-height:1.45;color:#666666;
			    '>
			        <b>Note:</b> A volunteer may hold multiple approved
			        roles and appear in more than one row.
			        Role totals may exceed the overall number of
			        unique volunteers. Assignments are counted only
			        for the corresponding role.
			        Volunteers without active assignments are
			        not necessarily available.
			    </div>
			
			</div>
			"
		displayFolder: HTML
		lineageTag: 5f2ad07a-b4df-4b85-a23e-871a595ac359

