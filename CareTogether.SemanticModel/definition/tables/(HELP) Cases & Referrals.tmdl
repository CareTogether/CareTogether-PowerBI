table '(HELP) Cases & Referrals'
	lineageTag: 3d7c070f-72c6-48c2-99da-83c91b2143a8

	measure '(HTML) Help - Cases Opened' =
			
			"
			<div style='
			    width:100%;
			    box-sizing:border-box;
			    padding:18px;
			
			    font-family:Arial,sans-serif;
			    color:#333333;
			    background:#FFFFFF;
			'>
			
			    <!-- HEADER -->
			    <div style='
			        display:flex;
			        align-items:center;
			        gap:8px;
			        margin-bottom:14px;
			    '>
			
			        <div style='
			            width:22px;
			            height:22px;
			            flex:0 0 22px;
			
			            display:flex;
			            align-items:center;
			            justify-content:center;
			
			            background:#F2F2F2;
			            border-radius:50%;
			
			            font-size:12px;
			            font-weight:700;
			            color:#333333;
			        '>
			            i
			        </div>
			
			        <div style='
			            font-size:15px;
			            font-weight:700;
			            line-height:1.2;
			        '>
			            Cases Opened
			        </div>
			
			    </div>
			
			
			    <!-- DESCRIPTION -->
			    <div style='
			        font-size:11px;
			        font-weight:400;
			        line-height:1.5;
			        margin-bottom:16px;
			    '>
			        Shows the number of <b>Cases opened during the selected timeframe</b>.
			    </div>
			
			
			    <!-- COHORT LOGIC -->
			    <div style='
			        font-size:10px;
			        font-weight:700;
			        text-transform:uppercase;
			        letter-spacing:0.5px;
			        color:#666666;
			        margin-bottom:6px;
			    '>
			        How do the Case metrics work?
			    </div>
			
			    <div style='
			        font-size:11px;
			        font-weight:400;
			        line-height:1.5;
			        margin-bottom:16px;
			    '>
			        The selected timeframe first identifies the Cases that were
			        <b>opened during that period</b>. The other Case metrics then
			        describe what happened to this same group of Cases.
			    </div>
			
			
			    <!-- EXAMPLE -->
			    <div style='
			        width:100%;
			        box-sizing:border-box;
			
			        background:#F5F5F5;
			        border-radius:7px;
			
			        padding:11px 12px;
			    '>
			
			        <div style='
			            font-size:10px;
			            font-weight:700;
			            color:#333333;
			            margin-bottom:5px;
			        '>
			            Example: January selected
			        </div>
			
			        <div style='
			            font-size:10px;
			            font-weight:400;
			            line-height:1.5;
			            color:#555555;
			        '>
			            We first identify all <b>Cases opened in January</b>.
			            From that same group, we can then see how many were closed,
			            how many families had Cases, and other related Case metrics.
			        </div>
			
			    </div>
			
			
			    <!-- NOTE -->
			    <div style='
			        margin-top:14px;
			        padding-top:12px;
			
			        border-top:1px solid #E5E5E5;
			
			        font-size:10px;
			        line-height:1.45;
			        color:#666666;
			    '>
			        <b>In short:</b> the Case Open Date determines the group
			        of Cases being analyzed.
			    </div>
			
			</div>
			"
		displayFolder: HTML
		lineageTag: d49c62a7-2f56-4cc3-b3bd-0a3607fa223c

	measure '(HTML) Help - Cases Closed' = ```
			
			"
			<div style='
			    width:100%;
			    height:100%;
			    box-sizing:border-box;
			    padding:18px;
			    font-family:Arial,sans-serif;
			    color:#333333;
			    background:#FFFFFF;
			'>
			
			    <!-- HEADER -->
			    <div style='
			        display:flex;
			        align-items:center;
			        gap:8px;
			        margin-bottom:14px;
			    '>
			        <div style='
			            width:22px;
			            height:22px;
			            flex:0 0 22px;
			            display:flex;
			            align-items:center;
			            justify-content:center;
			            background:#F2F2F2;
			            border-radius:50%;
			            font-size:12px;
			            font-weight:700;
			        '>i</div>
			
			        <div style='
			            font-size:15px;
			            font-weight:700;
			            line-height:1.2;
			        '>
			            Cases Closed
			        </div>
			    </div>
			
			    <!-- DESCRIPTION -->
			    <div style='
			        font-size:11px;
			        line-height:1.5;
			        margin-bottom:16px;
			    '>
			        Shows how many Cases were <b>closed during the selected
			        timeframe</b>, regardless of when they were opened.
			    </div>
			
			    <!-- CALCULATION -->
			    <div style='
			        font-size:10px;
			        font-weight:700;
			        text-transform:uppercase;
			        letter-spacing:0.5px;
			        color:#666666;
			        margin-bottom:6px;
			    '>
			        How is it calculated?
			    </div>
			
			    <div style='
			        font-size:11px;
			        line-height:1.5;
			        margin-bottom:16px;
			    '>
			        Cases are counted using their <b>Close Date</b>.
			        Each Case is counted once if its closing date falls
			        within the selected timeframe.
			    </div>
			
			    <!-- EXAMPLE -->
			    <div style='
			        width:100%;
			        box-sizing:border-box;
			        background:#F5F5F5;
			        border-radius:7px;
			        padding:11px 12px;
			    '>
			        <div style='
			            font-size:10px;
			            font-weight:700;
			            margin-bottom:5px;
			        '>
			            Example: January selected
			        </div>
			
			        <div style='
			            font-size:10px;
			            line-height:1.5;
			            color:#555555;
			        '>
			            If 80 Cases were closed in January, including Cases
			            opened in previous months, this metric shows
			            <b>80</b>.
			        </div>
			    </div>
			
			    <!-- NOTE -->
			    <div style='
			        margin-top:14px;
			        padding-top:12px;
			        border-top:1px solid #E5E5E5;
			        font-size:10px;
			        line-height:1.45;
			        color:#666666;
			    '>
			        <b>Important:</b> Cases closed during the selected timeframe
			        may have been opened in an earlier period. This metric
			        measures closures independently of Case openings.
			    </div>
			
			</div>
			"
			
			```
		displayFolder: HTML
		lineageTag: 36f63626-646f-472b-a220-8cf11d4192b3

	measure '(HTML) Help - Families with Cases' =
			
			"
			<div style='
			    width:100%;
			    height:100%;
			    box-sizing:border-box;
			    padding:18px;
			    font-family:Arial,sans-serif;
			    color:#333333;
			    background:#FFFFFF;
			'>
			
			    <!-- HEADER -->
			    <div style='display:flex;align-items:center;gap:8px;margin-bottom:14px;'>
			        <div style='
			            width:22px;height:22px;flex:0 0 22px;
			            display:flex;align-items:center;justify-content:center;
			            background:#F2F2F2;border-radius:50%;
			            font-size:12px;font-weight:700;
			        '>i</div>
			
			        <div style='font-size:15px;font-weight:700;line-height:1.2;'>
			            Families with Cases
			        </div>
			    </div>
			
			    <!-- DESCRIPTION -->
			    <div style='font-size:11px;line-height:1.5;margin-bottom:16px;'>
			        Shows the number of <b>unique Client Families</b> represented
			        among the Cases opened during the selected timeframe.
			    </div>
			
			    <!-- CALCULATION -->
			    <div style='
			        font-size:10px;font-weight:700;text-transform:uppercase;
			        letter-spacing:0.5px;color:#666666;margin-bottom:6px;
			    '>
			        How is it calculated?
			    </div>
			
			    <div style='font-size:11px;line-height:1.5;margin-bottom:16px;'>
			        We first identify the Cases opened during the selected period,
			        then count the <b>distinct families associated with those Cases</b>.
			    </div>
			
			    <!-- INFO BOX -->
			    <div style='
			        width:100%;box-sizing:border-box;
			        background:#F5F5F5;border-radius:7px;
			        padding:11px 12px;
			    '>
			        <div style='font-size:10px;font-weight:700;margin-bottom:5px;'>
			            Why can this be lower than Cases Opened?
			        </div>
			
			        <div style='font-size:10px;line-height:1.5;color:#555555;'>
			            A family may have more than one Case over time. The family
			            is counted only once within the selected group, even when
			            multiple Cases are associated with it.
			        </div>
			    </div>
			
			    <!-- NOTE -->
			    <div style='
			        margin-top:14px;padding-top:12px;
			        border-top:1px solid #E5E5E5;
			        font-size:10px;line-height:1.45;color:#666666;
			    '>
			        <b>Remember:</b> the group is still determined by the
			        <b>Case Open Date</b>.
			    </div>
			
			</div>
			"
		displayFolder: HTML
		lineageTag: 70998de0-6426-4225-aa9d-58ebbe523bda

	measure '(HTML) Help - Referrals Created' =
			
			"
			<div style='
			    width:100%;height:100%;box-sizing:border-box;padding:18px;
			    font-family:Arial,sans-serif;color:#333333;background:#FFFFFF;
			'>
			
			    <!-- HEADER -->
			    <div style='display:flex;align-items:center;gap:8px;margin-bottom:14px;'>
			        <div style='
			            width:22px;height:22px;flex:0 0 22px;
			            display:flex;align-items:center;justify-content:center;
			            background:#F2F2F2;border-radius:50%;
			            font-size:12px;font-weight:700;
			        '>i</div>
			
			        <div style='font-size:15px;font-weight:700;line-height:1.2;'>
			            Referrals Created
			        </div>
			    </div>
			
			    <!-- DESCRIPTION -->
			    <div style='font-size:11px;line-height:1.5;margin-bottom:16px;'>
			        Shows the number of <b>Referrals created during the selected
			        timeframe</b>.
			    </div>
			
			    <!-- LOGIC -->
			    <div style='
			        font-size:10px;font-weight:700;text-transform:uppercase;
			        letter-spacing:0.5px;color:#666666;margin-bottom:6px;
			    '>
			        How do the Referral metrics work?
			    </div>
			
			    <div style='font-size:11px;line-height:1.5;margin-bottom:16px;'>
			        The selected timeframe first identifies the Referrals that were
			        <b>created during that period</b>. Related Referral metrics can
			        then describe what happened to this same group.
			    </div>
			
			    <!-- EXAMPLE -->
			    <div style='
			        width:100%;box-sizing:border-box;
			        background:#F5F5F5;border-radius:7px;padding:11px 12px;
			    '>
			        <div style='font-size:10px;font-weight:700;margin-bottom:5px;'>
			            Example: January selected
			        </div>
			
			        <div style='font-size:10px;line-height:1.5;color:#555555;'>
			            We identify the Referrals created in January and can then
			            follow the outcomes associated with that group.
			        </div>
			    </div>
			
			    <!-- NOTE -->
			    <div style='
			        margin-top:14px;padding-top:12px;
			        border-top:1px solid #E5E5E5;
			        font-size:10px;line-height:1.45;color:#666666;
			    '>
			        <b>In short:</b> Referral Created Date determines the
			        group of Referrals being analyzed.
			    </div>
			
			</div>
			"
		displayFolder: HTML
		lineageTag: b9d6c33c-efa9-4556-a103-1f74c028190c

	measure '(HTML) Help - Referrals Accepted' = ```
			
			"
			<div style='
			    width:100%;height:100%;box-sizing:border-box;padding:18px;
			    font-family:Arial,sans-serif;color:#333333;background:#FFFFFF;
			'>
			
			    <!-- HEADER -->
			    <div style='display:flex;align-items:center;gap:8px;margin-bottom:14px;'>
			        <div style='
			            width:22px;height:22px;flex:0 0 22px;
			            display:flex;align-items:center;justify-content:center;
			            background:#F2F2F2;border-radius:50%;
			            font-size:12px;font-weight:700;
			        '>i</div>
			
			        <div style='font-size:15px;font-weight:700;line-height:1.2;'>
			            Referrals Accepted
			        </div>
			    </div>
			
			    <!-- DESCRIPTION -->
			    <div style='font-size:11px;line-height:1.5;margin-bottom:16px;'>
			        Shows how many Referrals were <b>accepted during the
			        selected timeframe</b>, regardless of when they were created.
			    </div>
			
			    <!-- CALCULATION -->
			    <div style='
			        font-size:10px;font-weight:700;text-transform:uppercase;
			        letter-spacing:0.5px;color:#666666;margin-bottom:6px;
			    '>
			        How is it calculated?
			    </div>
			
			    <div style='font-size:11px;line-height:1.5;margin-bottom:16px;'>
			        Referrals are counted using their <b>Accepted Date</b>.
			        Each Referral is counted once if its acceptance date
			        falls within the selected timeframe.
			    </div>
			
			    <!-- INFO BOX -->
			    <div style='
			        width:100%;box-sizing:border-box;
			        background:#F5F5F5;border-radius:7px;padding:11px 12px;
			    '>
			        <div style='font-size:10px;font-weight:700;margin-bottom:5px;'>
			            What does Accepted mean?
			        </div>
			
			        <div style='font-size:10px;line-height:1.5;color:#555555;'>
			            An accepted Referral has progressed through Intake and
			            was accepted for further service or Case activity.
			        </div>
			    </div>
			
			    <!-- NOTE -->
			    <div style='
			        margin-top:14px;padding-top:12px;
			        border-top:1px solid #E5E5E5;
			        font-size:10px;line-height:1.45;color:#666666;
			    '>
			        <b>Important:</b> Referrals accepted during the selected
			        timeframe may have been created in an earlier period.
			        Acceptance does not create an additional Referral.
			    </div>
			
			</div>
			"
			
			```
		displayFolder: HTML
		lineageTag: 801a13bf-47be-496d-8c67-6fb099bd63a7

	measure '(HTML) Help - Families Referred' =
			
			"
			<div style='
			    width:100%;height:100%;box-sizing:border-box;padding:18px;
			    font-family:Arial,sans-serif;color:#333333;background:#FFFFFF;
			'>
			
			    <!-- HEADER -->
			    <div style='display:flex;align-items:center;gap:8px;margin-bottom:14px;'>
