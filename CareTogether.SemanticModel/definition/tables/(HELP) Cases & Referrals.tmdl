	measure '(HTML) Help - Dynamic Pop-up - Cases & Referrals' =
			
			VAR HelpID =
			    SELECTEDVALUE(
			        '(HELP) Cases & Referrals'[Help ID]
			    )
			
			RETURN
			    SWITCH(
			        HelpID,
			
			        "CASES_OPENED",
			            [(HTML) Help - Cases Opened],
			
			        "CASES_CLOSED",
			            [(HTML) Help - Cases Closed],
			
			        "FAMILIES_WITH_CASES",
			            [(HTML) Help - Families with Cases],
			
			        "REFERRALS_CREATED",
			            [(HTML) Help - Referrals Created],
			
			        "REFERRALS_ACCEPTED",
			            [(HTML) Help - Referrals Accepted],
			
			        "FAMILIES_REFERRED",
			            [(HTML) Help - Families Referred],
			
			        "OVER_TIME",
			            [(HTML) Help - Over Time],
			
			        "REFERRALS_BY_STATUS",
			            [(HTML) Help - Referrals by Status],
			
			        "CASES_BY_FAMILY_TYPE",
			            [(HTML) Help - Cases by Family Type],
			
			        "PRIMARY_REASON_FOR_REFERRAL",
			            [(HTML) Help - Primary Reason for Referral],
			
			        "CASE_CLOSE_REASON",
			            [(HTML) Help - Case Close Reason],
			
			        "REFERRAL_CLOSE_REASON",
			            [(HTML) Help - Referral Close Reason],
			
			        "CASES_DETAILS",
			            [(HTML) Help - Cases Details],
			
			        "REFERRALS_DETAILS",
			            [(HTML) Help - Referrals Details],
			
			        BLANK()
			    )
		displayFolder: Measures
		lineageTag: bd023146-004d-49f6-8522-5aece1ab932b

	column 'Help ID'
		lineageTag: db3e1939-f5d6-4102-9e83-e4c9c37d1b1b
		summarizeBy: none
		isNameInferred
		sourceColumn: [Help ID]

		annotation SummarizationSetBy = Automatic

	partition '(HELP) Cases & Referrals' = calculated
		mode: import
		source =
				
				DATATABLE(
				    "Help ID", STRING,
				    {
				        {"CASES_OPENED"},
				        {"CASES_CLOSED"},
				        {"FAMILIES_WITH_CASES"},
				        {"REFERRALS_CREATED"},
				        {"REFERRALS_ACCEPTED"},
				        {"FAMILIES_REFERRED"},
				        {"OVER_TIME"},
				        {"REFERRALS_BY_STATUS"},
				        {"CASES_BY_FAMILY_TYPE"},
				        {"PRIMARY_REASON_FOR_REFERRAL"},
				        {"CASE_CLOSE_REASON"},
				        {"REFERRAL_CLOSE_REASON"},
				        {"CASES_DETAILS"},
				        {"REFERRALS_DETAILS"}
				    }
				)

	annotation PBI_Id = 0d58cb598c094b10b0c4039c973252ba

