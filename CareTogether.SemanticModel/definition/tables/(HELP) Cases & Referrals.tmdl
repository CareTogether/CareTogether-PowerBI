	measure '(HTML) Help - Over Time' = ```
			
			"
			<div style='
			    width:100%;height:100%;box-sizing:border-box;padding:18px;
			    font-family:Arial,sans-serif;color:#333333;background:#FFFFFF;
			'>
			
			    <!-- HEADER -->
			    <div style='display:flex;align-items:center;gap:8px;margin-bottom:14px;'>
			        <div style='
			            width:22px;height:22px;flex:0 0 22px;
			            display:flex;align-items:center;justify-content:center;
			            background:#F2F2F2;border-radius:50%;
			            font-size:12px;font-weight:700;
			        '>i</div>
			
			        <div style='font-size:15px;font-weight:700;line-height:1.2;'>
			            Cases and Referrals Over Time
			        </div>
			    </div>
			
			    <!-- DESCRIPTION -->
			    <div style='font-size:11px;line-height:1.5;margin-bottom:16px;'>
			        Shows how the volume of <b>Cases Opened</b> and
			        <b>Referrals Created</b> has changed over time.
			    </div>
			
			    <!-- CHART -->
			    <div style='
			        font-size:10px;font-weight:700;text-transform:uppercase;
			        letter-spacing:0.5px;color:#666666;margin-bottom:6px;
			    '>
			        What does the chart show?
			    </div>
			
			    <div style='font-size:11px;line-height:1.5;margin-bottom:16px;'>
			        Cases are grouped according to their <b>Open Date</b>,
			        while Referrals are grouped according to their
			        <b>Created Date</b>.
			    </div>
			
			    <!-- NAVIGATION -->
			    <div style='
			        font-size:10px;font-weight:700;text-transform:uppercase;
			        letter-spacing:0.5px;color:#666666;margin-bottom:6px;
			    '>
			        How to explore the timeline
			    </div>
			
			    <div style='font-size:11px;line-height:1.5;margin-bottom:14px;'>
			        Move your mouse over the chart. A toolbar will appear
			        in the <b>top-right corner</b>, allowing you to navigate
			        between <b>Year, Month and Day</b> levels.
			    </div>
			
			    <!-- DRILL UP -->
			    <div style='
			        display:flex;align-items:center;gap:12px;
			        margin-bottom:14px;
			    '>
			
			        <div style='
			            width:36px;height:36px;flex:0 0 36px;
			            display:flex;align-items:center;justify-content:center;
			            background:#F5F5F5;border-radius:5px;
			        '>
			            <svg width='24' height='24' viewBox='0 0 24 24'
			                 fill='none' stroke='#45B9C8'
			                 stroke-width='1.3'
			                 stroke-linecap='square'
			                 stroke-linejoin='miter'>
			                <path d='M12 21V3 M4 11L12 3L20 11'/>
			            </svg>
			        </div>
			
			        <div style='font-size:11px;line-height:1.5;'>
			            <b>Drill Up</b><br/>
			            Click the upward arrow to move to a higher
			            level of the hierarchy:
			            <b>Day → Month → Year</b>.
			        </div>
			
			    </div>
			
			    <!-- EXPAND ALL -->
			    <div style='
			        display:flex;align-items:center;gap:12px;
			        margin-bottom:16px;
			    '>
			
			        <div style='
			            width:36px;height:36px;flex:0 0 36px;
			            display:flex;align-items:center;justify-content:center;
			            background:#F5F5F5;border-radius:5px;
			        '>
			            <svg width='24' height='24' viewBox='0 0 24 24'
			                 fill='none' stroke='#45B9C8'
			                 stroke-width='1.3'
			                 stroke-linecap='square'
			                 stroke-linejoin='miter'>
			                <path d='M12 3V10
			                         M5 10H19
			                         M5 10V20
			                         M19 10V20
			                         M1 16L5 20L9 16
			                         M15 16L19 20L23 16'/>
			            </svg>
			        </div>
			
			        <div style='font-size:11px;line-height:1.5;'>
			            <b>Expand All Down One Level</b><br/>
			            Click the branching downward arrow to expand
			            the hierarchy:
			            <b>Year → Month → Day</b>,
			            keeping previous levels visible.
			        </div>
			
			    </div>
			
			    <!-- INFO BOX -->
			    <div style='
			        width:100%;box-sizing:border-box;
			        background:#F5F5F5;border-radius:7px;
			        padding:11px 12px;
			    '>
			
			        <div style='
			            font-size:10px;font-weight:700;margin-bottom:5px;
			        '>
			            Use this chart to compare activity
			        </div>
			
			        <div style='
			            font-size:10px;line-height:1.5;color:#555555;
			        '>
			            Compare the number of new Cases and Referrals across
			            different periods to identify changes in service demand
			            and activity over time.
			        </div>
			
			    </div>
			
			    <!-- NOTE -->
			    <div style='
			        margin-top:14px;padding-top:12px;
			        border-top:1px solid #E5E5E5;
			        font-size:10px;line-height:1.45;color:#666666;
			    '>
			        <b>Note:</b> this chart represents when Cases and Referrals
			        entered the workflow, not their current status.
			        Navigating the date hierarchy does not change the
			        selected report timeframe.
			    </div>
			
			</div>
			"
			
			```
		displayFolder: HTML
		lineageTag: ce9429b9-2e77-47e3-949d-796af7c7ac7b

	measure '(HTML) Help - Referrals by Status' =
			
			"
			<div style='
			    width:100%;height:100%;box-sizing:border-box;padding:18px;
			    font-family:Arial,sans-serif;color:#333333;background:#FFFFFF;
			'>
			
			    <!-- HEADER -->
			    <div style='display:flex;align-items:center;gap:8px;margin-bottom:14px;'>
			        <div style='
			            width:22px;height:22px;flex:0 0 22px;
			            display:flex;align-items:center;justify-content:center;
			            background:#F2F2F2;border-radius:50%;
			            font-size:12px;font-weight:700;
			        '>i</div>
			
			        <div style='font-size:15px;font-weight:700;line-height:1.2;'>
			            Referrals by Status
			        </div>
			    </div>
			
			    <!-- DESCRIPTION -->
			    <div style='font-size:11px;line-height:1.5;margin-bottom:16px;'>
			        Shows the <b>current status distribution</b> of the Referrals
			        included in the current report context.
			    </div>
			
			    <!-- STATUS -->
			    <div style='
			        font-size:10px;font-weight:700;text-transform:uppercase;
			        letter-spacing:0.5px;color:#666666;margin-bottom:6px;
			    '>
			        What do the statuses represent?
			    </div>
			
			    <div style='font-size:11px;line-height:1.5;margin-bottom:16px;'>
			        Referrals are grouped by their current workflow status,
			        such as <b>Closed</b>, <b>Accepted</b>, or <b>Open</b>.
			    </div>
			
			    <!-- INFO BOX -->
			    <div style='
			        width:100%;box-sizing:border-box;
			        background:#F5F5F5;border-radius:7px;padding:11px 12px;
			    '>
			        <div style='font-size:10px;font-weight:700;margin-bottom:5px;'>
			            How to read this chart
			        </div>
			
			        <div style='font-size:10px;line-height:1.5;color:#555555;'>
			            Use the chart to understand how the Referral population
			            is currently distributed across the different stages
			            of the workflow.
			        </div>
			    </div>
			
			    <!-- NOTE -->
			    <div style='
			        margin-top:14px;padding-top:12px;
			        border-top:1px solid #E5E5E5;
			        font-size:10px;line-height:1.45;color:#666666;
			    '>
			        <b>Tip:</b> percentages show each status as a share of the
			        Referral population currently displayed.
			    </div>
			
			</div>
			"
		displayFolder: HTML
		lineageTag: a4f3e6d6-1c1d-4646-8959-517bfebdf17c

	measure '(HTML) Help - Cases by Family Type' =
			
			"
			<div style='
			    width:100%;height:100%;box-sizing:border-box;padding:18px;
			    font-family:Arial,sans-serif;color:#333333;background:#FFFFFF;
			'>
			
			    <!-- HEADER -->
			    <div style='display:flex;align-items:center;gap:8px;margin-bottom:14px;'>
			        <div style='
			            width:22px;height:22px;flex:0 0 22px;
			            display:flex;align-items:center;justify-content:center;
			            background:#F2F2F2;border-radius:50%;
			            font-size:12px;font-weight:700;
			        '>i</div>
			
			        <div style='font-size:15px;font-weight:700;line-height:1.2;'>
			            Cases by Family Type
			        </div>
			    </div>
			
			    <!-- DESCRIPTION -->
			    <div style='font-size:11px;line-height:1.5;margin-bottom:16px;'>
			        Shows how Cases are distributed between <b>New Families</b>
			        and <b>Returning Families</b>.
			    </div>
			
			    <!-- DEFINITION -->
			    <div style='
			        font-size:10px;font-weight:700;text-transform:uppercase;
			        letter-spacing:0.5px;color:#666666;margin-bottom:6px;
			    '>
			        What does Family Type mean?
			    </div>
			
			    <div style='font-size:11px;line-height:1.5;margin-bottom:16px;'>
			        This classification helps distinguish Cases involving families
			        entering the Case process for the first time from those involving
			        families that have previously had a Case.
			    </div>
			
			    <!-- INFO BOX -->
			    <div style='
			        width:100%;box-sizing:border-box;
			        background:#F5F5F5;border-radius:7px;padding:11px 12px;
			    '>
			        <div style='font-size:10px;font-weight:700;margin-bottom:5px;'>
			            New vs. Returning
			        </div>
			
			        <div style='font-size:10px;line-height:1.5;color:#555555;'>
			            <b>New Family</b> represents the family's first Case.
			            <br>
			            <b>Returning Family</b> represents a family with prior
			            Case history.
			        </div>
			    </div>
			
			    <!-- NOTE -->
			    <div style='
			        margin-top:14px;padding-top:12px;
			        border-top:1px solid #E5E5E5;
			        font-size:10px;line-height:1.45;color:#666666;
			    '>
			        <b>Note:</b> this classification is based on the family's
			        Case history, not simply on whether the family itself is new
			        to the system.
			    </div>
			
			</div>
			"
		displayFolder: HTML
		lineageTag: 8520e75b-869f-482b-884f-25ce6beaf981

