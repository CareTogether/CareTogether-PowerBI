	measure 'Avg. Time to Start CP' =
			
			/*
			CP = Current Period
			
			Calculates the average number of days between the request date
			and start date for Arrangements that effectively started within
			the selected timeframe, regardless of when they were requested.
			
			An Arrangement is considered started when:
			- Its phase is not Cancelled.
			- Its start date is populated.
			- Its start date is on or before today.
			
			The selected timeframe is applied to the Arrangement Start Date.
			
			Arrangements with a start date earlier than their request
			date are excluded to prevent invalid negative durations.
			*/
			
			VAR startDate = [Selected Timeframe Start]
			VAR endDate = [Selected Timeframe End]
			VAR todayDate = TODAY()
			
			RETURN
			CALCULATE(
			    AVERAGEX(
			        Arrangement,
			        Arrangement[started_utc] - Arrangement[requested]
			    ),
			    Arrangement[started_utc] >= startDate,
			    Arrangement[started_utc] < endDate + 1,
			    Arrangement[phase] <> "Cancelled",
			    NOT ISBLANK(Arrangement[started_utc]),
			    Arrangement[started_utc] < todayDate + 1,
			    NOT ISBLANK(Arrangement[requested]),
			    FILTER(
			        Arrangement,
			        Arrangement[started_utc] >= Arrangement[requested]
			    ),
			    USERELATIONSHIP(
			        Arrangement[location_id],
			        Location[location_id]
			    )
			)
		formatString: #,0
		lineageTag: da43fe89-fa46-48ec-be6f-2a275e7287be

