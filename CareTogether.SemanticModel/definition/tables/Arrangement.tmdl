	measure '# of Arrangements Started CP (Cohort)' =
			
			/*
			CP = Current Period
			
			Counts the number of Arrangements requested within the
			selected timeframe that effectively started.
			
			An Arrangement is considered started when:
			- Its phase is not Cancelled.
			- Its start date is populated.
			- Its start date is on or before today.
			
			The selected timeframe defines the cohort based on
			the Arrangement Request Date.
			
			Arrangements may have started after the selected timeframe,
			as long as their start date is not in the future.
			*/
			
			VAR startDate = [Selected Timeframe Start]
			VAR endDate = [Selected Timeframe End]
			VAR todayDate = TODAY()
			
			RETURN
			CALCULATE(
			    COUNTROWS(Arrangement),
			    Arrangement[requested] >= startDate,
			    Arrangement[requested] < endDate + 1,
			    Arrangement[phase] <> "Cancelled",
			    NOT ISBLANK(Arrangement[started_utc]),
			    Arrangement[started_utc] < todayDate + 1,
			    USERELATIONSHIP(
			        Arrangement[location_id],
			        Location[location_id]
			    )
			)
		formatString: 0
		lineageTag: 4bb7568d-0a5b-4be2-826f-54c79b1f5ab9

	measure '# of Arrangements Cancelled CP (Cohort)' =
			
			/*
			CP = Current Period
			
			Counts Arrangements requested within the selected timeframe
			that are currently classified as Cancelled.
			
			The selected timeframe defines the cohort based on
			the Arrangement Request Date.
			*/
			
			VAR startDate = [Selected Timeframe Start]
			VAR endDate = [Selected Timeframe End]
			
			RETURN
			CALCULATE(
			    COUNTROWS(Arrangement),
			    Arrangement[requested] >= startDate,
			    Arrangement[requested] < endDate + 1,
			    Arrangement[phase] = "Cancelled",
			    USERELATIONSHIP(
			        Arrangement[location_id],
			        Location[location_id]
			    )
			)
		formatString: 0
		lineageTag: 549e78b9-411a-4e93-ac4c-8ff59a66bd01

	measure '# of Arrangements Not Started CP (Cohort)' =
			
			/*
			CP = Current Period
			
			Counts Arrangements requested within the selected timeframe
			that have not effectively started and are not Cancelled.
			
			An Arrangement has not started when:
			- Its start date is blank, or
			- Its start date is in the future.
			
			The selected timeframe defines the cohort based on
			the Arrangement Request Date.
			*/
			
			VAR startDate = [Selected Timeframe Start]
			VAR endDate = [Selected Timeframe End]
			VAR todayDate = TODAY()
			
			RETURN
			CALCULATE(
			    COUNTROWS(Arrangement),
			    Arrangement[requested] >= startDate,
			    Arrangement[requested] < endDate + 1,
			    Arrangement[phase] <> "Cancelled",
			    FILTER(
			        Arrangement,
			        ISBLANK(Arrangement[started_utc])
			            || Arrangement[started_utc] >= todayDate + 1
			    ),
			    USERELATIONSHIP(
			        Arrangement[location_id],
			        Location[location_id]
			    )
			)
		formatString: 0
		lineageTag: 9b6a3595-e0b8-43e1-8840-7ebf626700f4

	measure '# of Arrangements In Progress CP (Cohort)' =
			
			/*
			CP = Current Period
			
			Counts Arrangements requested within the selected timeframe
			that have effectively started and have not yet ended.
			
			An Arrangement is considered In Progress when:
			- Its phase is not Cancelled.
			- Its start date is populated and on or before today.
			- Its end date is blank or in the future.
			
			The selected timeframe defines the cohort based on
			the Arrangement Request Date.
			*/
			
			VAR startDate = [Selected Timeframe Start]
			VAR endDate = [Selected Timeframe End]
			VAR todayDate = TODAY()
			
			RETURN
			CALCULATE(
			    COUNTROWS(Arrangement),
			    Arrangement[requested] >= startDate,
			    Arrangement[requested] < endDate + 1,
			    Arrangement[phase] <> "Cancelled",
			    NOT ISBLANK(Arrangement[started_utc]),
			    Arrangement[started_utc] < todayDate + 1,
			    FILTER(
			        Arrangement,
			        ISBLANK(Arrangement[ended_utc])
			            || Arrangement[ended_utc] >= todayDate + 1
			    ),
			    USERELATIONSHIP(
			        Arrangement[location_id],
			        Location[location_id]
			    )
			)
		formatString: 0
		lineageTag: cbd67952-5640-4788-a8ed-bb8bafd5a6eb

	measure '# of Arrangements Ended Cohort CP' =
			
			/*
			CP = Current Period
			
			Counts Arrangements requested within the selected timeframe
			that effectively started and have subsequently ended.
			
			The selected timeframe defines the cohort based on
			the Arrangement Request Date.
			
			An Arrangement is considered ended when:
			- Its phase is not Cancelled.
			- Its start date is populated and on or before today.
			- Its end date is populated and on or before today.
			*/
			
			VAR startDate = [Selected Timeframe Start]
			VAR endDate = [Selected Timeframe End]
			VAR todayDate = TODAY()
			
			RETURN
			CALCULATE(
			    COUNTROWS(Arrangement),
			    Arrangement[requested] >= startDate,
			    Arrangement[requested] < endDate + 1,
			    Arrangement[phase] <> "Cancelled",
			    NOT ISBLANK(Arrangement[started_utc]),
			    Arrangement[started_utc] < todayDate + 1,
			    NOT ISBLANK(Arrangement[ended_utc]),
			    Arrangement[ended_utc] < todayDate + 1,
			    USERELATIONSHIP(
			        Arrangement[location_id],
			        Location[location_id]
			    )
			)
		formatString: #,0
		lineageTag: 9c4d97b2-30cf-4a47-b2fb-497c03ec3517

	measure 'Request Outcomes Description' =
			
			/*
			Dynamically describes the outcomes of Arrangements
			requested within the selected timeframe.
			
			All metrics are based on the Request Date Cohort.
			
			The description reflects the current outcomes of
			the requested Arrangements, regardless of when
			they started or ended.
			*/
			
			VAR requested =
			    COALESCE([# of Arrangements Requested CP], 0)
			
			VAR customDescription =
			    "Of the " & FORMAT(requested, "#,##0") &
			    " Arrangements requested during the selected period: "
			
			RETURN
			    customDescription
		lineageTag: fdb327e3-dc72-4889-9491-6d5934d7ed0c

	measure 'Avg. Duration CP' =
			
			/*
			CP = Current Period
			
			Calculates the average duration, in days, of Arrangements
			that effectively started within the selected timeframe,
			regardless of when they were requested.
			
			For completed Arrangements:
			- Duration is calculated from Start Date to End Date.
			
			For ongoing Arrangements:
			- Duration is calculated from Start Date to Today.
			
			An Arrangement is considered eligible when:
			- Its phase is not Cancelled.
			- Its start date is populated.
			- Its start date is on or before today.
			- Its effective end date is not earlier than its start date.
			
			The selected timeframe is applied to the Arrangement Start Date.
			
			Invalid negative durations are excluded.
			*/
			
			VAR startDate = [Selected Timeframe Start]
			VAR endDate = [Selected Timeframe End]
			VAR todayDate = TODAY()
			
			RETURN
			CALCULATE(
			    AVERAGEX(
			        Arrangement,
			        VAR arrangementStart = Arrangement[started_utc]
			        VAR arrangementEnd = Arrangement[ended_utc]
			
			        VAR effectiveEnd =
			            COALESCE(
			                arrangementEnd,
			                todayDate
			            )
			
			        RETURN
			            effectiveEnd - arrangementStart
			    ),
			    Arrangement[started_utc] >= startDate,
			    Arrangement[started_utc] < endDate + 1,
			    Arrangement[phase] <> "Cancelled",
			    NOT ISBLANK(Arrangement[started_utc]),
			    Arrangement[started_utc] < todayDate + 1,
			    FILTER(
			        Arrangement,
			        VAR effectiveEnd =
			            COALESCE(
			                Arrangement[ended_utc],
			                todayDate
			            )
			
			        RETURN
			            effectiveEnd >= Arrangement[started_utc]
			    ),
			    USERELATIONSHIP(
			        Arrangement[location_id],
			        Location[location_id]
			    )
			)
		formatString: 0
		lineageTag: 5509c0fd-7267-4409-8ca8-2e70e0058d09

	measure 'Avg. Duration PP' =
			
			/*
			PP = Previous Period
			
			Calculates the average duration, in days, of Arrangements
			that effectively started within the previous period,
			regardless of when they were requested.
			
			For completed Arrangements:
			- Duration is calculated from Start Date to End Date.
			
			For ongoing Arrangements:
			- Duration is calculated from Start Date to Today.
			
			An Arrangement is considered eligible when:
			- Its phase is not Cancelled.
			- Its start date is populated.
			- Its start date is on or before today.
			- Its effective end date is not earlier than its start date.
			
			The previous period is calculated based on the
			Arrangement Start Date, not the Request Date.
			
			The previous period has the same number of days
			as the currently selected timeframe.
			
			Invalid negative durations are excluded.
			*/
			
			VAR currentStartDate = [Selected Timeframe Start]
			VAR currentEndDate = [Selected Timeframe End]
			VAR todayDate = TODAY()
			
			VAR periodDays =
			    DATEDIFF(
			        currentStartDate,
			        currentEndDate,
			        DAY
			    ) + 1
			
			VAR previousStartDate =
			    currentStartDate - periodDays
			
			VAR previousEndDate =
			    currentStartDate - 1
			
			RETURN
			CALCULATE(
			    AVERAGEX(
			        Arrangement,
			        VAR arrangementStart = Arrangement[started_utc]
			        VAR arrangementEnd = Arrangement[ended_utc]
			
			        VAR effectiveEnd =
			            COALESCE(
			                arrangementEnd,
			                todayDate
			            )
			
			        RETURN
			            effectiveEnd - arrangementStart
			    ),
			    Arrangement[started_utc] >= previousStartDate,
			    Arrangement[started_utc] < previousEndDate + 1,
			    Arrangement[phase] <> "Cancelled",
			    NOT ISBLANK(Arrangement[started_utc]),
			    Arrangement[started_utc] < todayDate + 1,
			    FILTER(
			        Arrangement,
			        VAR effectiveEnd =
			            COALESCE(
			                Arrangement[ended_utc],
			                todayDate
			            )
			
			        RETURN
			            effectiveEnd >= Arrangement[started_utc]
			    ),
			    USERELATIONSHIP(
			        Arrangement[location_id],
			        Location[location_id]
			    )
			)
		lineageTag: c193646a-852b-49b7-a85c-290b508385d6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg. Duration PoP' =
			
			VAR currentPeriod = [Avg. Duration CP]
			VAR previousPeriod = [Avg. Duration PP]
			VAR perc = DIVIDE(currentPeriod - previousPeriod, previousPeriod)
			
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(perc), BLANK(),
			    perc >= 0, FORMAT(perc, "+0%") & "▲",
			    perc < 0, FORMAT(perc, "0%") & "▼",
			    "0%"
			)
		lineageTag: 7863d591-aad1-41ae-ae1f-5e267b0f39ae

	measure 'Display Arrangements By' =
			
			VAR selectedOption = SELECTEDVALUE(_aux_arrangement_display_by[Option])
			RETURN SWITCH(
			    selectedOption,
			    "Requested within the selected period", [# of Arrangements Requested CP],
			    "Started within the selected period", [# of Arrangements Started CP]
			)
		formatString: 0
		lineageTag: d3a67f8c-4134-4489-a5eb-43a4c013704b

