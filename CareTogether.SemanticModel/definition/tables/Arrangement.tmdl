	column 'Communities Involved' = ```
			
			/*
			Returns all Communities associated with Volunteer Families
			and Volunteer Persons involved in the current Arrangement.
			
			Displays:
			Community Name - Person Name (Function)
			
			If no Community Role Assignments exist:
			Community Name - No Roles assigned
			
			- Supports multiple Families and Persons.
			- Supports multiple Communities per Family.
			- Includes all Community Roles.
			- Removes duplicate Community/Person/Role combinations.
			- Sorts by Community, then Person, then Role.
			*/
			
			VAR currentArrangementUID =
			    Arrangement[arrangement_uid]
			
			-- Step 1: Families directly assigned to the Arrangement
			VAR directFamilies =
			    SELECTCOLUMNS(
			        FILTER(
			            ALL('Volunteer Family Function Assignment'),
			            'Volunteer Family Function Assignment'[arrangement_uid]
			                = currentArrangementUID
			        ),
			        "FamilyUID",
			            'Volunteer Family Function Assignment'[family_uid]
			    )
			
			-- Step 2: Individual Volunteers assigned to the Arrangement
			VAR individualVolunteers =
			    SELECTCOLUMNS(
			        FILTER(
			            ALL('Volunteer Person Function Assignment'),
			            'Volunteer Person Function Assignment'[arrangement_uid]
			                = currentArrangementUID
			        ),
			        "PersonUID",
			            'Volunteer Person Function Assignment'[person_uid]
			    )
			
			-- Step 3: Families of Individual Volunteers
			VAR individualFamilies =
			    SELECTCOLUMNS(
			        FILTER(
			            ALL('Volunteer Person'),
			            'Volunteer Person'[person_uid]
			                IN individualVolunteers
			        ),
			        "FamilyUID",
			            'Volunteer Person'[family_uid]
			    )
			
			-- Step 4: Combine all Families
			VAR allFamilies =
			    DISTINCT(
			        FILTER(
			            UNION(
			                directFamilies,
			                individualFamilies
			            ),
			            NOT ISBLANK([FamilyUID])
			        )
			    )
			
			-- Step 5: Communities associated with those Families
			VAR involvedCommunities =
			    DISTINCT(
			        SELECTCOLUMNS(
			            FILTER(
			                ALL('Community Member Family'),
			                'Community Member Family'[family_uid]
			                    IN allFamilies
			            ),
			            "CommunityUID",
			                'Community Member Family'[community_uid]
			        )
			    )
			
			-- Step 6: Resolve Community names
			VAR communitiesWithNames =
			    ADDCOLUMNS(
			        involvedCommunities,
			        "Community",
			            VAR communityUID = [CommunityUID]
			            RETURN
			                LOOKUPVALUE(
			                    'Community'[community_name],
			                    'Community'[community_uid],
			                    communityUID
			                )
			    )
			
			-- Step 7: Retrieve all Community Role Assignments
			VAR communitiesWithRoles =
			    GENERATE(
			        communitiesWithNames,
			
			        VAR currentCommunityUID = [CommunityUID]
			
			        VAR assignments =
			            SELECTCOLUMNS(
			                FILTER(
			                    ALL('Community Role Assignment'),
			                    'Community Role Assignment'[community_uid]
			                        = currentCommunityUID
			                ),
			                "PersonUID",
			                    'Community Role Assignment'[person_uid],
			                "Function",
			                    'Community Role Assignment'[role]
			            )
			
			        VAR roleDetails =
			            ADDCOLUMNS(
			                assignments,
			                "Person",
			                    VAR personUID = [PersonUID]
			                    RETURN
			                        LOOKUPVALUE(
			                            'Volunteer Person'[full_name],
			                            'Volunteer Person'[person_uid],
			                            personUID
			                        )
			            )
			
			        VAR validRoles =
			            DISTINCT(
			                SELECTCOLUMNS(
			                    FILTER(
			                        roleDetails,
			                        NOT ISBLANK([Person])
			                            && [Person] <> ""
			                            && NOT ISBLANK([Function])
			                            && [Function] <> ""
			                    ),
			                    "Person", [Person],
			                    "Function", [Function]
			                )
			            )
			
			        VAR fallback =
			            SELECTCOLUMNS(
			                FILTER(
			                    ROW(
			                        "Person", "No roles assigned",
			                        "Function", ""
			                    ),
			                    ISEMPTY(validRoles)
			                ),
			                "Person", [Person],
			                "Function", [Function]
			            )
			
			        RETURN
			            UNION(
			                validRoles,
			                fallback
			            )
			    )
			
			-- Step 8: Remove duplicate Community/Person/Function combinations
			VAR finalCommunities =
			    DISTINCT(
			        SELECTCOLUMNS(
			            FILTER(
			                communitiesWithRoles,
			                NOT ISBLANK([Community])
			            ),
			            "Community", [Community],
			            "Person", [Person],
			            "Function", [Function]
			        )
			    )
			
			-- Step 9: Create sorting key
			VAR sortedCommunities =
			    ADDCOLUMNS(
			        finalCommunities,
			        "SortKey",
			            [Community] & "|" & [Person] & "|" & [Function]
			    )
			
			RETURN
			IF(
			    ISBLANK(currentArrangementUID),
			    BLANK(),
			    CONCATENATEX(
			        sortedCommunities,
			        [Community] & " - " & [Person]
			            & IF(
			                [Function] <> "",
			                " (" & [Function] & ")",
			                ""
			            ),
			        UNICHAR(10),
			        [SortKey],
			        ASC
			    )
			)
			
			```
		displayFolder: _calculated_columns
		lineageTag: 620ddfb4-f14c-4493-96c5-f29808d95d17
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

