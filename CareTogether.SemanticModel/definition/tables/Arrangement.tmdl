	column 'Volunteer Families' =
			
			VAR familyFunctions =
			    DISTINCT(
			        SELECTCOLUMNS(
			            RELATEDTABLE('Volunteer Family Function Assignment'),
			            "Family", RELATED('Volunteer Family'[family_name]),
			            "Function", 'Volunteer Family Function Assignment'[function]
			        )
			    )
			
			RETURN
			CONCATENATEX(
			    familyFunctions,
			    [Family] & " (" & [Function] & ")",
			    UNICHAR(10),
			    [Family],
			    ASC
			)
		displayFolder: _calculated_columns
