table Arrangement
	lineageTag: 5a7b2de3-02f5-4659-b92c-8a113de80938

	measure '# of Arrangements Requested CP' = ```
			
			/*
			CP = Current Period
			
			Counts Arrangements requested during the selected timeframe.
			*/
			
			VAR startDate = [Selected Timeframe Start]
			VAR endDate = [Selected Timeframe End]
			
			RETURN 
			CALCULATE(
			    COUNTROWS(Arrangement),
			    Arrangement[requested] >= startDate,
			    Arrangement[requested] < endDate + 1,
			    USERELATIONSHIP(Arrangement[location_id], Location[location_id])
			)
			```
		formatString: #,0
		lineageTag: d41b52e0-9373-4b0f-b443-401c2fac8a32

	measure '# of Arrangements Requested PP' =
			
			/*
			PP = Previous Period
			
			Counts Arrangements requested during the period immediately
			preceding the selected timeframe, using the same number of days.
			*/
			
			VAR currentStartDate = [Selected Timeframe Start]
			VAR currentEndDate = [Selected Timeframe End]
			VAR periodDays = DATEDIFF(currentStartDate, currentEndDate, DAY) + 1
			VAR previousStartDate = currentStartDate - periodDays
			VAR previousEndDate = currentStartDate - 1
			
			RETURN
			CALCULATE(
			    COUNTROWS(Arrangement),
			    Arrangement[requested] >= previousStartDate,
			    Arrangement[requested] < previousEndDate + 1,
			    USERELATIONSHIP(Arrangement[location_id], Location[location_id])
			)
		formatString: 0
		lineageTag: fa9d3cea-9934-44cc-b413-a5da670a9bbd

	measure '# of Arrangements Requested PoP' =
			
			VAR currentPeriod = [# of Arrangements Requested CP]
			VAR previousPeriod = [# of Arrangements Requested PP]
			VAR Perc = DIVIDE(currentPeriod - previousPeriod, previousPeriod)
			
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(Perc), BLANK(),
			    Perc >= 0, FORMAT(Perc, "+0%") & "▲",
			    Perc < 0, FORMAT(Perc, "0%") & "▼",
			    "0%"
			)
		lineageTag: 6c8db7ff-58fa-4265-be30-4661f6d42833

	measure '# of Arrangements Started CP' =
			
			/*
			CP = Current Period
			
			Counts the number of Arrangements that effectively started
			within the selected timeframe, regardless of when they
			were requested.
			
			An Arrangement is considered started when:
			- Its phase is not Cancelled.
			- Its start date is populated.
			- Its start date is on or before today.
			
			The selected timeframe is applied to the Arrangement Start Date.
			*/
			
			VAR startDate = [Selected Timeframe Start]
			VAR endDate = [Selected Timeframe End]
			VAR todayDate = TODAY()
			
			RETURN
			CALCULATE(
			    COUNTROWS(Arrangement),
			    Arrangement[started_utc] >= startDate,
			    Arrangement[started_utc] < endDate + 1,
			    Arrangement[phase] <> "Cancelled",
			    NOT ISBLANK(Arrangement[started_utc]),
			    Arrangement[started_utc] < todayDate + 1,
			    USERELATIONSHIP(
			        Arrangement[location_id],
			        Location[location_id]
			    )
			)
		formatString: #,0
		lineageTag: 04c89e7b-290b-46ad-a265-f67850f8ab56

	measure '# of Arrangements Started PP' =
			
			/*
			PP = Previous Period
			
			Counts the number of Arrangements that effectively started
			within the previous period, regardless of when they
			were requested.
			
			An Arrangement is considered started when:
			- Its phase is not Cancelled.
			- Its start date is populated.
			- Its start date is on or before today.
			
			The previous period has the same number of days
			as the currently selected timeframe.
			
			The previous period is calculated based on the
			Arrangement Start Date, not the Request Date.
			*/
			
			VAR currentStartDate = [Selected Timeframe Start]
			VAR currentEndDate = [Selected Timeframe End]
			VAR todayDate = TODAY()
			
			VAR periodDays =
			    DATEDIFF(
			        currentStartDate,
			        currentEndDate,
			        DAY
			    ) + 1
			
			VAR previousStartDate = currentStartDate - periodDays
			
			VAR previousEndDate = currentStartDate - 1
			
			RETURN
			CALCULATE(
			    COUNTROWS(Arrangement),
			    Arrangement[started_utc] >= previousStartDate,
			    Arrangement[started_utc] < previousEndDate + 1,
			    Arrangement[phase] <> "Cancelled",
			    NOT ISBLANK(Arrangement[started_utc]),
			    Arrangement[started_utc] < todayDate + 1,
			    USERELATIONSHIP(
			        Arrangement[location_id],
			        Location[location_id]
			    )
			)
		formatString: 0
		lineageTag: 722fb885-4325-494f-ac25-bb68fb760f72

	measure '# of Arrangements Started PoP' =
			
			VAR currentPeriod = [# of Arrangements Started CP]
			VAR previousPeriod = [# of Arrangements Started PP]
			VAR Perc = DIVIDE(currentPeriod - previousPeriod, previousPeriod)
			
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(Perc), BLANK(),
			    Perc >= 0, FORMAT(Perc, "+0%") & "▲",
			    Perc < 0, FORMAT(Perc, "0%") & "▼",
			    "0%"
			)
		lineageTag: 8ad271ca-c78c-4d39-86ee-36fca90c1947

	measure '# of People Served CP' =
			
			/*
			CP = Current Period
			
			Counts the number of unique people served through Arrangements
			that effectively started within the selected timeframe,
			regardless of when they were requested.
			
			An Arrangement is considered started when:
			- Its phase is not Cancelled.
			- Its start date is populated.
			- Its start date is on or before today.
			
			The selected timeframe is applied to the Arrangement Start Date.
			
			Each person is counted only once, even if associated
			with multiple qualifying Arrangements.
			*/
			
			VAR startDate = [Selected Timeframe Start]
			VAR endDate = [Selected Timeframe End]
			VAR todayDate = TODAY()
			
			RETURN
			CALCULATE(
			    DISTINCTCOUNT(Arrangement[person_id]),
			    Arrangement[started_utc] >= startDate,
			    Arrangement[started_utc] < endDate + 1,
			    Arrangement[phase] <> "Cancelled",
			    NOT ISBLANK(Arrangement[started_utc]),
			    Arrangement[started_utc] < todayDate + 1,
			    NOT ISBLANK(Arrangement[person_id]),
			    USERELATIONSHIP(
			        Arrangement[location_id],
			        Location[location_id]
			    )
			)
		formatString: #,0
		lineageTag: c6da53c7-7304-4304-b0f4-750e4a5a51db

	measure '# of People Served PP' =
			
			/*
			PP = Previous Period
			
			Counts the number of unique people served through Arrangements
			that effectively started within the previous period,
			regardless of when they were requested.
			
			An Arrangement is considered started when:
			- Its phase is not Cancelled.
			- Its start date is populated.
			- Its start date is on or before today.
			
			The previous period has the same number of days
			as the currently selected timeframe.
			
			The previous period is calculated based on the
			Arrangement Start Date, not the Request Date.
			
			Each person is counted only once, even if associated
			with multiple qualifying Arrangements.
			*/
			
			VAR currentStartDate = [Selected Timeframe Start]
			VAR currentEndDate = [Selected Timeframe End]
			VAR todayDate = TODAY()
			
			VAR periodDays =
			    DATEDIFF(
			        currentStartDate,
			        currentEndDate,
			        DAY
			    ) + 1
			
			VAR previousStartDate =
			    currentStartDate - periodDays
			
			VAR previousEndDate =
			    currentStartDate - 1
			
			RETURN
			CALCULATE(
			    DISTINCTCOUNT(Arrangement[person_id]),
			    Arrangement[started_utc] >= previousStartDate,
			    Arrangement[started_utc] < previousEndDate + 1,
			    Arrangement[phase] <> "Cancelled",
			    NOT ISBLANK(Arrangement[started_utc]),
			    Arrangement[started_utc] < todayDate + 1,
			    NOT ISBLANK(Arrangement[person_id]),
			    USERELATIONSHIP(
			        Arrangement[location_id],
			        Location[location_id]
			    )
			)
		formatString: 0
		lineageTag: d9be206c-83a0-439e-8cc5-061158d8352c

	measure '# of People Served PoP' =
			
			VAR currentPeriod = [# of People Served CP]
			VAR previousPeriod = [# of People Served PP]
			VAR Perc = DIVIDE(currentPeriod - previousPeriod, previousPeriod)
			
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(Perc), BLANK(),
			    Perc >= 0, FORMAT(Perc, "+0%") & "▲",
