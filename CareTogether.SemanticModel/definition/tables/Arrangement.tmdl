	partition Arrangement = m
		mode: import
		queryGroup: Facts
		source =
				let
				
				  Source = #"OData",
				  Arrangements = Source{[Name="Arrangement", Signature="table"]}[Data],
				
				  expandFamilyId = Table.ExpandRecordColumn(Arrangements, "Person", {"FamilyId"}, {"Person.FamilyId"}),
				
				  selectColumns = Table.SelectColumns(
				    expandFamilyId,
				    {
				      "Id",
				      "OrganizationId",
				      "LocationId",
				      "TypeName",
				      "CaseId",
				      "PersonId",
				      "Person.FamilyId",
				      "Requested",
				      "StartedUtc",
				      "EndedUtc",
				      "Phase",
				      "Reason",
				      "PolicyVersion"
				    }
				  ),
				
				  renameColumns = Table.RenameColumns(
				    selectColumns,
				    {
				      {"Id", "arrangement_id"},
				      {"OrganizationId", "organization_id"},
				      {"LocationId", "location_id"},
				      {"TypeName", "type"},
				      {"CaseId", "case_id"},
				      {"PersonId", "person_id"},
				      {"Person.FamilyId", "family_id"},
				      {"Requested", "requested"},
				      {"StartedUtc", "started_utc"},
				      {"EndedUtc", "ended_utc"},
				      {"Phase", "phase"},
				      {"Reason", "reason"},
				      {"PolicyVersion", "policy_version"}
				    }
				  ),
				
				  addRLSKey = Table.AddColumn(
				    renameColumns,
				    "rls_key",
				    each Text.Combine({[organization_id], "-", [location_id]})
				  ),
				
				  addArrangementUniqueKey = Table.AddColumn(
				      addRLSKey,
				      "arrangement_uid",
				      each
				          if [arrangement_id] <> null then
				              Text.Combine({[rls_key], "-", [arrangement_id]})
				          else
				              null,
				      type text
				  ),
				
				  addPersonUniqueKey = Table.AddColumn(
				    addArrangementUniqueKey,
				    "person_uid",
				    each
				      if [person_id] <> null then
				        Text.Combine({[rls_key], "-", [person_id]})
				      else
				        null,
				      type text
				  ),
				
				  addArrangementTypeUniqueKey = Table.AddColumn(
				    addPersonUniqueKey,
				    "type_uid",
				    each
				      if [type] <> null then
				        Text.Combine({[rls_key], "-", [type]})
				      else
				        null,
				      type text
				  ),
				
				  addCaseUniqueKey = Table.AddColumn(
				    addArrangementTypeUniqueKey,
				    "case_uid",
				    each
				      if [case_id] <> null then
				        Text.Combine({[rls_key], "-", [case_id]})
				      else
				        null,
				      type text
				  ),
				
				  addTableIndex = Table.AddIndexColumn(
				    addCaseUniqueKey,
				    "index",
				    1
				  )
				
				in
				
				  addTableIndex

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

