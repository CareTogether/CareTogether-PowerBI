		lineageTag: 5af7d50d-6f32-430c-a411-97ea6b8f48fd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg. Time to Start PoP' =
			
			VAR currentPeriod = [Avg. Time to Start CP]
