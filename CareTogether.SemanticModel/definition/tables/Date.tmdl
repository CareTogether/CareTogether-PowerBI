table Date
	lineageTag: 6b0b0936-2e04-4e57-9950-46010d0363e9

	measure 'Selected Timeframe Start' = MIN('Date'[Date])
		formatString: General Date
		lineageTag: ff4a6ff2-1dd7-4c12-aca9-2bd2dc0d19f9

	measure 'Selected Timeframe End' = MAX('Date'[Date])
		formatString: General Date
		lineageTag: defaf07e-085c-460e-b916-7912a2c683e3

	measure 'PoP Comparison Timeframe' =
			
			VAR CurrentStartDate =
			    [Selected Timeframe Start]
			
			VAR CurrentEndDate =
			    [Selected Timeframe End]
			
			VAR NumberOfDays =
			    DATEDIFF(
			        CurrentStartDate,
			        CurrentEndDate,
			        DAY
			    ) + 1
			
			VAR PreviousStartDate =
			    CurrentStartDate - NumberOfDays
			
			VAR PreviousEndDate =
			    CurrentStartDate - 1
			
			RETURN
			    FORMAT(PreviousStartDate, "MMM d")
			    & " – "
			    & FORMAT(PreviousEndDate, "MMM d, yyyy")
			    // & " (" & NumberOfDays & " days)"
		lineageTag: bd5592d1-a7b1-45cc-b1dc-398e93c7a98a

