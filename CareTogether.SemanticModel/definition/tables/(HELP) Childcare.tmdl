	measure '(HTML) Help - Care by Childcare Plan' = ```
			
			"
			<div style='
			    width:100%;height:100%;box-sizing:border-box;padding:18px;
			    font-family:Arial,sans-serif;color:#333333;background:#FFFFFF;
			'>
			
			    <!-- HEADER -->
			    <div style='display:flex;align-items:center;gap:8px;margin-bottom:14px;'>
			        <div style='
			            width:22px;height:22px;flex:0 0 22px;
			            display:flex;align-items:center;justify-content:center;
			            background:#F2F2F2;border-radius:50%;
			            font-size:12px;font-weight:700;
			        '>i</div>
			
			        <div style='font-size:15px;font-weight:700;line-height:1.2;'>
			            Care by Childcare Plan
			        </div>
			    </div>
			
			    <!-- DESCRIPTION -->
			    <div style='font-size:11px;line-height:1.5;margin-bottom:16px;'>
			        Shows how <b>Days of Care</b> and <b>Nights of Care</b>
			        are distributed across different childcare plans.
			    </div>
			
			    <!-- CHART -->
			    <div style='
			        font-size:10px;font-weight:700;text-transform:uppercase;
			        letter-spacing:0.5px;color:#666666;margin-bottom:6px;
			    '>
			        What does the chart show?
			    </div>
			
			    <div style='font-size:11px;line-height:1.5;margin-bottom:16px;'>
			        <b>Overnight Housing:</b> Care recorded under the
			        Overnight Housing childcare plan.
			        <br/><br/>
			        <b>Daytime Childcare:</b> Care recorded under the
			        Daytime Childcare plan.
			        <br/><br/>
			        For each plan, the chart compares total
			        <b>Days of Care</b>, including arrival and
			        departure dates, with <b>Nights of Care</b>,
			        excluding the departure date.
			    </div>
			
			    <!-- INFO BOX -->
			    <div style='
			        width:100%;box-sizing:border-box;
			        background:#F5F5F5;border-radius:7px;padding:11px 12px;
			    '>
			        <div style='font-size:10px;font-weight:700;margin-bottom:5px;'>
			            Understanding the difference
			        </div>
			
			        <div style='font-size:10px;line-height:1.5;color:#555555;'>
			            Nights of Care are calculated from the
			            recorded childcare dates, regardless of
			            the childcare plan.
			            <br/><br/>
			            As a result, <b>Daytime Childcare may also
			            show Nights of Care</b> when a recorded care
			            period extends across multiple calendar days.
			            This does not necessarily confirm an
			            overnight stay.
			        </div>
			    </div>
			
			    <!-- NOTE -->
			    <div style='
			        margin-top:14px;padding-top:12px;
			        border-top:1px solid #E5E5E5;
			        font-size:10px;line-height:1.45;color:#666666;
			    '>
			        <b>Note:</b> Each childcare record contributes
			        separately to the totals. WithParent care is
			        excluded. Only care within the selected Date
			        and Location filters is included.
			        Ongoing care is counted through the latest
			        available data.
			    </div>
			
			</div>
			"
			
			```
		displayFolder: HTML
		lineageTag: 3a80eca2-3c01-4a88-8acb-b3b123d0eb3b

	measure '(HTML) Help - Care by Arrangement Type' = ```
			
			"
			<div style='
			    width:100%;height:100%;box-sizing:border-box;padding:16px 18px;
			    font-family:Arial,sans-serif;color:#333333;background:#FFFFFF;
			'>
			
			    <!-- HEADER -->
			    <div style='display:flex;align-items:center;gap:8px;margin-bottom:12px;'>
			        <div style='
			            width:22px;height:22px;flex:0 0 22px;
			            display:flex;align-items:center;justify-content:center;
			            background:#F2F2F2;border-radius:50%;
			            font-size:12px;font-weight:700;
			        '>i</div>
			
			        <div style='font-size:15px;font-weight:700;line-height:1.2;'>
			            Care by Arrangement Type
			        </div>
			    </div>
			
			    <!-- DESCRIPTION -->
			    <div style='font-size:11px;line-height:1.45;margin-bottom:13px;'>
			        Shows how <b>volunteer childcare activity</b> is
			        distributed across different Arrangement Types.
			    </div>
			
			    <!-- CHART -->
			    <div style='
			        font-size:10px;font-weight:700;text-transform:uppercase;
			        letter-spacing:0.5px;color:#666666;margin-bottom:5px;
			    '>
			        What does the table show?
			    </div>
			
			    <div style='font-size:11px;line-height:1.45;margin-bottom:13px;'>
			        <b>Days of Care:</b> Total calendar days of childcare,
			        including arrival and departure dates.
			        <br/>
			        <b>Nights of Care:</b> Overnight stays calculated
			        from recorded care dates, excluding departure dates.
			        <br/>
			        <b>Children Cared For:</b> Number of unique children
			        who received care under each Arrangement Type.
			    </div>
			
			    <!-- INFO BOX -->
			    <div style='
			        width:100%;box-sizing:border-box;
			        background:#F5F5F5;border-radius:7px;padding:10px 12px;
			    '>
			        <div style='font-size:10px;font-weight:700;margin-bottom:5px;'>
			            Why might the total differ from the sum of the rows?
			        </div>
			
			        <div style='font-size:10px;line-height:1.45;color:#555555;'>
			            A child may receive care through <b>multiple
			            Arrangement Types</b> and appear in more than
			            one category.
			            <br/><br/>
			            However, the <b>Children Cared For total</b>
			            counts each child only once, regardless of
			            how many Arrangement Types they participated in.
			            Therefore, the total may be lower than the
			            sum of the individual categories.
			        </div>
			    </div>
			
			    <!-- MISSING TYPE -->
			    <div style='
			        font-size:10px;font-weight:700;text-transform:uppercase;
			        letter-spacing:0.5px;color:#666666;
			        margin-top:13px;margin-bottom:5px;
			    '>
			        Why are some Arrangement Types blank?
			    </div>
			
			    <div style='font-size:11px;line-height:1.45;margin-bottom:12px;'>
			        Some historical childcare records remain available
			        even when their associated Arrangement is no longer
			        present in the system.
			        <br/><br/>
			        These records are still included in the totals,
			        but their Arrangement Type cannot be identified.
			    </div>
			
			    <!-- NOTE -->
			    <div style='
			        padding-top:10px;
			        border-top:1px solid #E5E5E5;
			        font-size:10px;line-height:1.4;color:#666666;
			    '>
			        <b>Note:</b> WithParent care is excluded.
			        Results respect the selected Date and Location
			        filters. Ongoing care is included through the
			        latest available data.
			    </div>
			
			</div>
			"
			
			```
		displayFolder: HTML
		lineageTag: 9761b76f-aa77-42e5-9cd6-f7b1bb3a77b4

	measure '(HTML) Help - Childcare Details' = ```
			
			"
			<div style='
			    width:100%;height:100%;box-sizing:border-box;padding:16px 18px;
			    font-family:Arial,sans-serif;color:#333333;background:#FFFFFF;
			'>
			
			    <!-- HEADER -->
			    <div style='display:flex;align-items:center;gap:8px;margin-bottom:12px;'>
			        <div style='
			            width:22px;height:22px;flex:0 0 22px;
			            display:flex;align-items:center;justify-content:center;
			            background:#F2F2F2;border-radius:50%;
			            font-size:12px;font-weight:700;
			        '>i</div>
			
			        <div style='font-size:15px;font-weight:700;line-height:1.2;'>
			            Childcare Details
			        </div>
			    </div>
			
			    <!-- DESCRIPTION -->
			    <div style='font-size:11px;line-height:1.45;margin-bottom:13px;'>
			        Provides a <b>detailed view of individual childcare
			        records</b>, showing which children received care,
			        the volunteer families involved and the duration
			        of each care period.
			    </div>
			
			    <!-- TABLE -->
			    <div style='
			        font-size:10px;font-weight:700;text-transform:uppercase;
			        letter-spacing:0.5px;color:#666666;margin-bottom:5px;
			    '>
			        What does the table show?
			    </div>
			
			    <div style='font-size:11px;line-height:1.45;margin-bottom:13px;'>
			        <b>Child:</b> The child who received care.
			        <br/>
			        <b>Volunteer Family:</b> The family providing care.
			        <br/>
			        <b>Childcare Plan:</b> The recorded type of childcare.
			        <br/>
			        <b>Arrangement Type:</b> The associated Arrangement category.
			        <br/>
			        <b>Started / Ended:</b> When the care period began and ended.
			        A blank Ended date indicates no recorded end date.
			        <br/>
			        <b>Days of Care:</b> Calendar days of care, including
			        arrival and departure dates.
			        <br/>
			        <b>Nights of Care:</b> Nights between arrival and
			        departure, excluding the departure date.
			    </div>
			
			    <!-- INFO BOX -->
			    <div style='
			        width:100%;box-sizing:border-box;
			        background:#F5F5F5;border-radius:7px;padding:10px 12px;
			    '>
			        <div style='font-size:10px;font-weight:700;margin-bottom:5px;'>
			            Why might a child appear multiple times?
			        </div>
			
			        <div style='font-size:10px;line-height:1.45;color:#555555;'>
			            Each row represents a <b>childcare record</b>,
			            not a unique child.
			            <br/><br/>
			            A child may appear multiple times when they
			            receive care during different periods,
			            through different Arrangements or from
			            different volunteer families.
			            <br/><br/>
			            This allows you to follow the child's
			            recorded care history and identify
			            transitions between volunteer families.
			        </div>
			    </div>
			
			    <!-- NOTE -->
			    <div style='
			        margin-top:12px;padding-top:10px;
			        border-top:1px solid #E5E5E5;
			        font-size:10px;line-height:1.45;color:#666666;
			    '>
			        <b>Note:</b> Only childcare records overlapping
			        the selected period are displayed.
			        Days and Nights of Care reflect activity within
			        the selected Date and Location filters.
			        WithParent care is excluded.
			        Historical records may have missing Arrangement
			        information.
			    </div>
			
			</div>
			"
			
			```
		displayFolder: HTML
		lineageTag: a688260d-db8e-44cb-a857-e865b5f9df5b

