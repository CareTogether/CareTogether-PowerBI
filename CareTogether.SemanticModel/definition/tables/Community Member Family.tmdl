	partition 'Community Member Family' = m
		mode: import
		queryGroup: Facts
		source = ```
				let
				  Source = #"OData",
				  communityMemberAssignment = Source{[Name="CommunityMemberFamilies", Signature="table"]}[Data],
				
				  selectColumns = Table.SelectColumns(
				    communityMemberAssignment,
				    {
				      "OrganizationId",
				      "LocationId",
				      "CommunityId",
				      "FamilyId"
				    }
				  ),
				
				  renameColumns = Table.RenameColumns(
				    selectColumns,
				    {
				      {"OrganizationId", "organization_id"},
				      {"LocationId", "location_id"},
				      {"CommunityId", "community_id"},
				      {"FamilyId", "family_id"}
				    }
				  ),
				
				  addRLSKey = Table.AddColumn(
				    renameColumns,
				    "rls_key",
				    each Text.Combine({[organization_id], "-", [location_id]})
				  ),
				
				  // There are duplicated Family Ids in different orgs/locations:
				  addFamilyUniqueKey = Table.AddColumn(
				      addRLSKey,
				      "family_uid",
				      each
				          if [family_id] <> null then
				              Text.Combine({[rls_key], "-", [family_id]})
				          else
				              null,
				      type text
				  ),
				
				  addCommunityUniqueKey = Table.AddColumn(
				      addFamilyUniqueKey,
				      "community_uid",
				      each
				          if [community_id] <> null then
				              Text.Combine({[rls_key], "-", [community_id]})
				          else
				              null,
				      type text
				  )
				  
				in
				
				  addCommunityUniqueKey
				```

	annotation PBI_NavigationStepName = Navegação

