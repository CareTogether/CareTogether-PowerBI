		annotation SummarizationSetBy = Automatic

	column date
		dataType: dateTime
		formatString: General Date
		lineageTag: 056d5116-ae45-48c0-817c-8a0105e51d06
		summarizeBy: none
		sourceColumn: date

		annotation SummarizationSetBy = Automatic

	column expire_date
		dataType: dateTime
		formatString: General Date
		lineageTag: 479fdb3c-d759-4eb1-b625-1300bd704983
		summarizeBy: none
		sourceColumn: expire_date

		annotation SummarizationSetBy = Automatic

	column rls_key
		dataType: string
		lineageTag: 76acc23f-d1c6-452b-a7df-a143be3b3d85
		summarizeBy: none
		sourceColumn: rls_key

		annotation SummarizationSetBy = Automatic

	column family_uid
		dataType: string
		lineageTag: d515fbce-2148-40cd-88b9-d3c7381a6316
		summarizeBy: none
		sourceColumn: family_uid

		annotation SummarizationSetBy = Automatic

	partition 'Volunteer Family Role Requirements' = m
		mode: import
		queryGroup: Facts
		source =
				let
				  Source = #"OData",
				  VolunteerFamilyRequirements = Source{[Name="FamilyRequirementStatuses", Signature="table"]}[Data],
				
				  selectColumns = Table.SelectColumns(
				    VolunteerFamilyRequirements,
				    {
				      "OrganizationId",
				      "LocationId",
				      "FamilyId",
				      "RequirementName",
				      "Status",
				      "Date",
				      "ExpireDate"
				    }
				  ),
				
				  renameColumns = Table.RenameColumns(
				    selectColumns,
				    {
				      {"OrganizationId", "organization_id"},
				      {"LocationId", "location_id"},
				      {"FamilyId", "family_id"},
				      {"RequirementName", "requirement_name"},
				      {"Status", "status"},
				      {"Date", "date"},
				      {"ExpireDate", "expire_date"}
				    }
				  ),
				
				  addRLSKey = Table.AddColumn(
				    renameColumns,
				    "rls_key",
				    each Text.Combine({[organization_id], "-", [location_id]})
				  ),
				
				  addFamilyUniqueKey = Table.AddColumn(
				      addRLSKey,
				      "family_uid",
				      each
				          if [family_id] <> null then
				              Text.Combine({[rls_key], "-", [family_id]})
				          else
				              null,
				      type text
				  )
				in
				
				  addFamilyUniqueKey

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

