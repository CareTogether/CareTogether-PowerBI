table 'Volunteer Family Role Requirements'
	lineageTag: a6a1734d-ead6-40ce-981c-17e7bb75d06f

	measure '# of Requirements Completed' =
			
			
			VAR startDate = [Selected Timeframe Start]
			VAR endDate = [Selected Timeframe End]
			
			RETURN CALCULATE(
			    DISTINCTCOUNT('Volunteer Family Role Requirements'[family_id]),
			    'Volunteer Family Role Requirements'[date] >= startDate,
			    'Volunteer Family Role Requirements'[date] < endDate + 1,
			    USERELATIONSHIP('Volunteer Family Role Requirements'[location_id], Location[location_id])
			)
		formatString: 0
		lineageTag: b8a4aa3d-2a34-4ec1-864a-55a99c7f132a

	column organization_id
		dataType: string
		lineageTag: 4c4cf14e-612f-4354-b8c7-55993e624723
		summarizeBy: none
		sourceColumn: organization_id

		annotation SummarizationSetBy = Automatic

	column location_id
		dataType: string
		lineageTag: ac6ae380-0d65-403b-9de4-d299c27bcd8c
		summarizeBy: none
		sourceColumn: location_id

		annotation SummarizationSetBy = Automatic

	column family_id
		dataType: string
		lineageTag: f22c2857-762f-4def-94b9-e3451284406f
		summarizeBy: none
