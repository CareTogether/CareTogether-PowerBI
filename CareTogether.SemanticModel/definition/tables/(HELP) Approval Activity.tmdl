	measure '(HTML) Help - Family Application Outcomes' =
			
			"
			<div style='
			    width:100%;height:100%;box-sizing:border-box;padding:14px 18px;
			    font-family:Arial,sans-serif;color:#333333;background:#FFFFFF;
			'>
			
			    <!-- HEADER -->
			    <div style='display:flex;align-items:center;gap:8px;margin-bottom:9px;'>
			        <div style='
			            width:22px;height:22px;flex:0 0 22px;
			            display:flex;align-items:center;justify-content:center;
			            background:#F2F2F2;border-radius:50%;
			            font-size:12px;font-weight:700;
			        '>i</div>
			        <div style='font-size:15px;font-weight:700;line-height:1.2;'>
			            Family Application Outcomes
			        </div>
			    </div>
			
			    <!-- DESCRIPTION -->
			    <div style='font-size:11px;line-height:1.4;margin-bottom:10px;'>
			        Shows the <b>latest known status of Family Applications</b>
			        initiated during the selected period, using an
			        <b>Application Date Cohort</b>. This helps understand
			        what happened to approval processes started within
			        a specific timeframe.
			    </div>
			
			    <!-- COHORT -->
			    <div style='
			        font-size:10px;font-weight:700;text-transform:uppercase;
			        letter-spacing:0.5px;color:#666666;margin-bottom:5px;
			    '>
			        How does the Cohort work?
			    </div>
			
			    <div style='font-size:11px;line-height:1.45;margin-bottom:10px;'>
			        <b>Step 1:</b> Identify Applications that entered
			        <b>Prospective</b> during the selected period,
			        using Family, Role, and Application Start Date.<br/>
			        <b>Step 2:</b> Follow subsequent status changes,
			        including those occurring <b>outside the selected period</b>.<br/>
			        <b>Step 3:</b> Assign each Application to its
			        <b>latest effective status</b>, counting it in
			        only one outcome.
			    </div>
			
			    <!-- EXAMPLE -->
			    <div style='
			        width:100%;box-sizing:border-box;
			        background:#F5F5F5;border-radius:7px;padding:9px 11px;
			        margin-bottom:10px;
			    '>
			        <div style='font-size:10px;font-weight:700;margin-bottom:4px;'>
			            Example
			        </div>
			        <div style='font-size:10px;line-height:1.45;color:#555555;'>
			            A Family starts an Application in <b>November 2025</b>
			            and reaches <b>Onboarded in February 2026</b>.
			            When selecting 2025, the Application belongs to the
			            <b>2025 Cohort</b> and is classified as
			            <b>Onboarded</b>, even though onboarding occurred in 2026.
			        </div>
			    </div>
			
			    <!-- OUTCOMES -->
			    <div style='
			        font-size:10px;font-weight:700;text-transform:uppercase;
			        letter-spacing:0.5px;color:#666666;margin-bottom:5px;
			    '>
			        What do the outcomes mean?
			    </div>
			
			    <div style='font-size:11px;line-height:1.5;margin-bottom:10px;'>
			        <b>Prospective:</b> Still in the initial approval stage.<br/>
			        <b>Approved:</b> Reached Approved; no subsequent status recorded.<br/>
			        <b>Onboarded:</b> Reached Onboarded and remains in that status.<br/>
			        <b>Expired:</b> Approval or eligibility has expired.<br/>
			        <b>Denied:</b> Application was denied.<br/>
			        <b>Inactive:</b> Application is currently classified as Inactive.
			    </div>
			
			    <!-- INFO BOX -->
			    <div style='
			        width:100%;box-sizing:border-box;
			        background:#F5F5F5;border-radius:7px;padding:9px 11px;
			    '>
			        <div style='font-size:10px;font-weight:700;margin-bottom:4px;'>
			            How to use this information
			        </div>
			        <div style='font-size:10px;line-height:1.45;color:#555555;'>
			            Evaluate how Applications from a selected period have
			            progressed. Compare Locations and reporting periods
			            to identify Applications still awaiting approval,
			            successfully onboarded, or no longer active.
			        </div>
			    </div>
			
			    <!-- NOTE -->
			    <div style='
			        margin-top:10px;padding-top:9px;
			        border-top:1px solid #E5E5E5;
			        font-size:10px;line-height:1.4;color:#666666;
			    '>
			        <b>Important:</b> The selected period determines
			        <b>which Applications are included</b>, not when their
			        status changes must occur. Outcomes reflect the latest
			        effective status as of today; future-dated changes,
			        including scheduled <b>Expired</b> records, are ignored
			        until their effective date.
			        <br/>
			        Results represent <b>Applications, not unique Families</b>.
			        Each Application belongs to one outcome, and the total
			        should match the Family Applications in the selected Cohort.
			    </div>
			
			</div>
			"
		displayFolder: HTML
		lineageTag: 047987ae-a4a6-4d67-9efd-da2f38a3a5f0

	measure '(HTML) Help - Individual Application Outcomes' =
			
			"
			<div style='
			    width:100%;height:100%;box-sizing:border-box;padding:14px 18px;
			    font-family:Arial,sans-serif;color:#333333;background:#FFFFFF;
			'>
			
			    <!-- HEADER -->
			    <div style='display:flex;align-items:center;gap:8px;margin-bottom:9px;'>
			        <div style='
			            width:22px;height:22px;flex:0 0 22px;
			            display:flex;align-items:center;justify-content:center;
			            background:#F2F2F2;border-radius:50%;
			            font-size:12px;font-weight:700;
			        '>i</div>
			        <div style='font-size:15px;font-weight:700;line-height:1.2;'>
			            Individual Application Outcomes
			        </div>
			    </div>
			
			    <!-- DESCRIPTION -->
			    <div style='font-size:11px;line-height:1.4;margin-bottom:10px;'>
			        Shows the <b>latest known status of Individual Applications</b>
			        initiated during the selected period, using an
			        <b>Application Date Cohort</b>. This helps understand
			        how approval processes initiated by Individuals
			        have progressed over time.
			    </div>
			
			    <!-- COHORT -->
			    <div style='
			        font-size:10px;font-weight:700;text-transform:uppercase;
			        letter-spacing:0.5px;color:#666666;margin-bottom:5px;
			    '>
			        How does the Cohort work?
			    </div>
			
			    <div style='font-size:11px;line-height:1.45;margin-bottom:10px;'>
			        <b>Step 1:</b> Identify Applications that entered
			        <b>Prospective</b> during the selected period,
			        using Individual, Role, and Application Start Date.<br/>
			        <b>Step 2:</b> Follow subsequent status changes,
			        including those occurring <b>outside the selected period</b>.<br/>
			        <b>Step 3:</b> Assign each Application to its
			        <b>latest effective status</b>, counting it in
			        only one outcome.
			    </div>
			
			    <!-- EXAMPLE -->
			    <div style='
			        width:100%;box-sizing:border-box;
			        background:#F5F5F5;border-radius:7px;padding:9px 11px;
			        margin-bottom:10px;
			    '>
			        <div style='font-size:10px;font-weight:700;margin-bottom:4px;'>
			            Example
			        </div>
			        <div style='font-size:10px;line-height:1.45;color:#555555;'>
			            An Individual starts a <b>Family Coach Application
			            in December 2025</b> and reaches
			            <b>Onboarded in March 2026</b>.
			            When selecting 2025, the Application belongs to the
			            <b>2025 Cohort</b> and is classified as
			            <b>Onboarded</b>, even though onboarding occurred in 2026.
			        </div>
			    </div>
			
			    <!-- OUTCOMES -->
			    <div style='
			        font-size:10px;font-weight:700;text-transform:uppercase;
			        letter-spacing:0.5px;color:#666666;margin-bottom:5px;
			    '>
			        What do the outcomes mean?
			    </div>
			
			    <div style='font-size:11px;line-height:1.5;margin-bottom:10px;'>
			        <b>Prospective:</b> Still in the initial approval stage.<br/>
			        <b>Approved:</b> Reached Approved; no subsequent status recorded.<br/>
			        <b>Onboarded:</b> Reached Onboarded and remains in that status.<br/>
			        <b>Expired:</b> Approval or eligibility has expired.<br/>
			        <b>Denied:</b> Application was denied.<br/>
			        <b>Inactive:</b> Application is currently classified as Inactive.
			    </div>
			
			    <!-- INFO BOX -->
			    <div style='
			        width:100%;box-sizing:border-box;
			        background:#F5F5F5;border-radius:7px;padding:9px 11px;
			    '>
			        <div style='font-size:10px;font-weight:700;margin-bottom:4px;'>
			            How to use this information
			        </div>
			        <div style='font-size:10px;line-height:1.45;color:#555555;'>
			            Evaluate how Individual Applications from a selected
			            period have progressed. Compare Roles, Locations,
			            and reporting periods to identify pending approvals,
			            successful onboardings, and Applications that
			            become inactive.
			        </div>
			    </div>
			
			    <!-- NOTE -->
			    <div style='
			        margin-top:10px;padding-top:9px;
			        border-top:1px solid #E5E5E5;
			        font-size:10px;line-height:1.4;color:#666666;
			    '>
			        <b>Important:</b> The selected period determines
			        <b>which Applications are included</b>, not when their
			        status changes must occur. Outcomes reflect the latest
			        effective status as of today; future-dated changes,
			        including scheduled <b>Expired</b> records, are ignored
			        until their effective date.
			        <br/>
			        Results represent <b>Applications, not unique Individuals</b>.
			        An Individual may apply multiple times or for different Roles.
			        Each Application belongs to one outcome, and the total
			        should match the Individual Applications in the selected Cohort.
			    </div>
			
			</div>
			"
		displayFolder: HTML
		lineageTag: e2162854-4116-4004-b642-b13df41015b1

	measure '(HTML) Help - Family Applications Over Time' =
			
			"
			<div style='
			    width:100%;height:100%;box-sizing:border-box;padding:14px 18px;
			    font-family:Arial,sans-serif;color:#333333;background:#FFFFFF;
			'>
			
			    <!-- HEADER -->
			    <div style='display:flex;align-items:center;gap:8px;margin-bottom:10px;'>
			        <div style='
			            width:22px;height:22px;flex:0 0 22px;
			            display:flex;align-items:center;justify-content:center;
			            background:#F2F2F2;border-radius:50%;
			            font-size:12px;font-weight:700;
			        '>i</div>
			
			        <div style='font-size:15px;font-weight:700;line-height:1.2;'>
			            Family Applications Over Time
			        </div>
			    </div>
			
			    <!-- DESCRIPTION -->
			    <div style='font-size:11px;line-height:1.45;margin-bottom:12px;'>
			        Shows how <b>Family Applications change over time</b>,
			        based on the date each Family enters
			        <b>Prospective</b> for a specific volunteer Role.
			        Each bar represents Applications initiated during
			        the corresponding time interval.
			    </div>
			
			    <!-- CHART -->
			    <div style='
			        font-size:10px;font-weight:700;text-transform:uppercase;
			        letter-spacing:0.5px;color:#666666;margin-bottom:5px;
			    '>
			        How to explore the timeline
			    </div>
			
			    <div style='font-size:11px;line-height:1.45;margin-bottom:12px;'>
			        Move your mouse over the chart. A toolbar will appear
			        in the <b>top-right corner</b>, allowing you to navigate
			        between <b>Year, Month and Day</b> levels.
			    </div>
			
			    <!-- DRILL UP -->
			    <div style='
			        display:flex;align-items:center;gap:12px;
			        margin-bottom:12px;
			    '>
			
			        <div style='
			            width:36px;height:36px;flex:0 0 36px;
			            display:flex;align-items:center;justify-content:center;
			            background:#F5F5F5;border-radius:5px;
			        '>
			            <svg width='24' height='24' viewBox='0 0 24 24'
			                 fill='none' stroke='#45B9C8'
			                 stroke-width='1.3'
			                 stroke-linecap='square'
			                 stroke-linejoin='miter'>
			                <path d='M12 21V3 M4 11L12 3L20 11'/>
			            </svg>
			        </div>
			
			        <div style='font-size:11px;line-height:1.45;'>
			            <b>Drill Up</b><br/>
			            Click the upward arrow to move to a higher
			            level of the hierarchy:
			            <b>Day → Month → Year</b>.
			        </div>
			
			    </div>
			
			    <!-- EXPAND ALL -->
			    <div style='
			        display:flex;align-items:center;gap:12px;
			        margin-bottom:12px;
			    '>
			
			        <div style='
			            width:36px;height:36px;flex:0 0 36px;
			            display:flex;align-items:center;justify-content:center;
			            background:#F5F5F5;border-radius:5px;
			        '>
			            <svg width='24' height='24' viewBox='0 0 24 24'
			                 fill='none' stroke='#45B9C8'
			                 stroke-width='1.3'
			                 stroke-linecap='square'
			                 stroke-linejoin='miter'>
			                <path d='M12 3V10
			                         M5 10H19
			                         M5 10V20
			                         M19 10V20
			                         M1 16L5 20L9 16
			                         M15 16L19 20L23 16'/>
			            </svg>
			        </div>
			
			        <div style='font-size:11px;line-height:1.45;'>
			            <b>Expand All Down One Level</b><br/>
			            Click the branching downward arrow to expand
			            the hierarchy:
			            <b>Year → Month → Day</b>,
			            keeping previous levels visible.
			        </div>
			
			    </div>
			
			    <!-- INFO BOX -->
			    <div style='
			        width:100%;box-sizing:border-box;
			        background:#F5F5F5;border-radius:7px;padding:9px 11px;
			    '>
			        <div style='font-size:10px;font-weight:700;margin-bottom:4px;'>
			            How to use this information
			        </div>
			
			        <div style='font-size:10px;line-height:1.45;color:#555555;'>
			            Start with the yearly overview, expand into months
			            to identify trends and periods of higher or lower
			            Family application activity, and continue into days
			            for a more detailed analysis.
			        </div>
			    </div>
			
			    <!-- NOTE -->
			    <div style='
			        margin-top:10px;padding-top:9px;
			        border-top:1px solid #E5E5E5;
			        font-size:10px;line-height:1.4;color:#666666;
			    '>
			        <b>Important:</b> Applications represent
			        <b>approval processes, not unique Families</b>.
			        Each entry into Prospective starts a new Application,
			        including reapplications. Duplicate Applications
			        across Locations are counted once, and future-dated
			        Applications are excluded.
			        <br/><br/>
			        Navigating the date hierarchy changes the level of
			        detail displayed, <b>not the selected report timeframe</b>.
			        Applications are always grouped by their start date,
			        regardless of subsequent status changes.
			    </div>
			
			</div>
			"
		displayFolder: HTML
		lineageTag: 90b0f076-828f-4851-94de-87924f9488d4

	measure '(HTML) Help - Application by Family Type' =
			
			"
			<div style='
			    width:100%;height:100%;box-sizing:border-box;padding:14px 18px;
			    font-family:Arial,sans-serif;color:#333333;background:#FFFFFF;
			'>
			
			    <!-- HEADER -->
			    <div style='display:flex;align-items:center;gap:8px;margin-bottom:10px;'>
			        <div style='
			            width:22px;height:22px;flex:0 0 22px;
			            display:flex;align-items:center;justify-content:center;
			            background:#F2F2F2;border-radius:50%;
			            font-size:12px;font-weight:700;
			        '>i</div>
			        <div style='font-size:15px;font-weight:700;line-height:1.2;'>
			            Application by Family Type
			        </div>
			    </div>
			
			    <!-- DESCRIPTION -->
			    <div style='font-size:11px;line-height:1.45;margin-bottom:12px;'>
			        Shows the distribution of <b>Family Applications</b>
			        initiated during the selected period, classified
			        as <b>New</b> or <b>Returning</b>.
			    </div>
			
			    <!-- CLASSIFICATION -->
			    <div style='
			        font-size:10px;font-weight:700;text-transform:uppercase;
			        letter-spacing:0.5px;color:#666666;margin-bottom:5px;
			    '>
			        How are Applications classified?
			    </div>
			
			    <div style='font-size:11px;line-height:1.45;margin-bottom:12px;'>
			        <b>New:</b> The Family's first recorded Application
			        for a specific Role.
			        <br/><br/>
			        <b>Returning:</b> A subsequent Application initiated
			        by the same Family for the <b>same Role</b>.
			        <br/><br/>
			        Classification considers the <b>full historical
			        application record</b>, not only Applications
			        within the selected reporting period.
			    </div>
			
			    <!-- EXAMPLE -->
			    <div style='
			        width:100%;box-sizing:border-box;
			        background:#F5F5F5;border-radius:7px;padding:9px 11px;
			        margin-bottom:10px;
			    '>
			        <div style='font-size:10px;font-weight:700;margin-bottom:4px;'>
			            Example
			        </div>
			        <div style='font-size:10px;line-height:1.45;color:#555555;'>
			            A Family applies for <b>Host Family in 2024</b>:
			            <b>New</b>.
			            <br/>
			            The same Family applies again for
			            <b>Host Family in 2026</b>: <b>Returning</b>.
			            <br/>
			            An Application for a different Role would be
			            classified as <b>New</b> for that Role.
			        </div>
			    </div>
			
			    <!-- INFO BOX -->
			    <div style='
			        width:100%;box-sizing:border-box;
			        background:#F5F5F5;border-radius:7px;padding:9px 11px;
			    '>
			        <div style='font-size:10px;font-weight:700;margin-bottom:4px;'>
			            How to use this information
			        </div>
			        <div style='font-size:10px;line-height:1.45;color:#555555;'>
			            Understand how much application activity comes
			            from first-time applications for a Role versus
			            Families applying again for the same Role.
			            This helps identify recurring approval activity.
			        </div>
			    </div>
			
			    <!-- NOTE -->
			    <div style='
			        margin-top:10px;padding-top:9px;
			        border-top:1px solid #E5E5E5;
			        font-size:10px;line-height:1.4;color:#666666;
			    '>
			        <b>Important:</b> New and Returning describe
			        <b>Applications, not Families</b>.
			        Returning does not necessarily mean the Family
			        was previously Approved or Onboarded.
			        <br/>
			        The classification is based on previous entries
			        into Prospective for the same Family and Role,
			        regardless of Location.
			    </div>
			
			</div>
			"
		displayFolder: HTML
		lineageTag: 32c632da-f3a8-465a-a488-f6d811e55855

