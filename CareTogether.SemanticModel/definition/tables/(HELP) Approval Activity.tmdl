table '(HELP) Approval Activity'
	lineageTag: ffcb2f3b-c3ad-42ba-9f91-60cb78b2e6d1

	measure '(HTML) Help - Family Applications' =
			
			"
			<div style='
			    width:100%;height:100%;box-sizing:border-box;padding:18px;
			    font-family:Arial,sans-serif;color:#333333;background:#FFFFFF;
			'>
			
			    <!-- HEADER -->
			    <div style='display:flex;align-items:center;gap:8px;margin-bottom:14px;'>
			        <div style='
			            width:22px;height:22px;flex:0 0 22px;
			            display:flex;align-items:center;justify-content:center;
			            background:#F2F2F2;border-radius:50%;
			            font-size:12px;font-weight:700;
			        '>i</div>
			
			        <div style='font-size:15px;font-weight:700;line-height:1.2;'>
			            Family Applications
			        </div>
			    </div>
			
			    <!-- DESCRIPTION -->
			    <div style='font-size:11px;line-height:1.5;margin-bottom:16px;'>
			        Counts the number of <b>Family approval processes initiated</b>
			        during the selected period.
			        Each Application represents a Family applying for
			        a specific volunteer Role within a <b>Location</b>.
			    </div>
			
			    <!-- METRIC -->
			    <div style='
			        font-size:10px;font-weight:700;text-transform:uppercase;
			        letter-spacing:0.5px;color:#666666;margin-bottom:6px;
			    '>
			        How is this metric calculated?
			    </div>
			
			    <div style='font-size:11px;line-height:1.5;margin-bottom:16px;'>
			        An Application starts whenever a Family enters
			        the <b>Prospective</b> status for a Role.
			        Each new entry into Prospective represents a new
			        Application, including renewals and reapplications.
			        <br/><br/>
			        Applications are identified by
			        <b>Family, Role, and Application Start Date</b>.
			        Each Role is specific to a <b>Location</b>.
			        Therefore, applying for the same volunteer function
			        in a different Location is treated as a separate Application.
			        <br/><br/>
			        Only Applications initiated within the selected
			        period are counted.
			    </div>
			
			    <!-- INFO BOX -->
			    <div style='
			        width:100%;box-sizing:border-box;
			        background:#F5F5F5;border-radius:7px;padding:11px 12px;
			    '>
			        <div style='font-size:10px;font-weight:700;margin-bottom:5px;'>
			            How to interpret this information
			        </div>
			
			        <div style='font-size:10px;line-height:1.5;color:#555555;'>
			            A higher value indicates more Family approval
			            processes were initiated during the selected period.
			            <br/><br/>
			            The percentage below the KPI compares this total
			            with the immediately preceding period of equal
			            duration. A green increase indicates more Applications,
			            while a red decrease indicates fewer Applications.
			        </div>
			    </div>
			
			    <!-- NOTE -->
			    <div style='
			        margin-top:14px;padding-top:12px;
			        border-top:1px solid #E5E5E5;
			        font-size:10px;line-height:1.45;color:#666666;
			    '>
			        <b>Important:</b> Applications represent
			        <b>approval processes, not unique Families</b>.
			        The same Family may apply multiple times, for
			        different Roles, or in different Locations.
			        <br/><br/>
			        Duplicate records representing the
			        <b>same Application</b> are counted only once.
			        Future-dated Applications are excluded.
			    </div>
			
			</div>
			"
		displayFolder: HTML
		lineageTag: b6eed7b6-d74c-4d66-9c3d-b0652e929d2a

	measure '(HTML) Help - Family Approvals' =
			
			"
			<div style='
			    width:100%;height:100%;box-sizing:border-box;padding:18px;
			    font-family:Arial,sans-serif;color:#333333;background:#FFFFFF;
			'>
			
			    <!-- HEADER -->
			    <div style='display:flex;align-items:center;gap:8px;margin-bottom:14px;'>
			        <div style='
			            width:22px;height:22px;flex:0 0 22px;
			            display:flex;align-items:center;justify-content:center;
			            background:#F2F2F2;border-radius:50%;
			            font-size:12px;font-weight:700;
			        '>i</div>
			
			        <div style='font-size:15px;font-weight:700;line-height:1.2;'>
			            Family Approvals
			        </div>
			    </div>
			
			    <!-- DESCRIPTION -->
			    <div style='font-size:11px;line-height:1.5;margin-bottom:16px;'>
			        Counts the number of <b>Family approval events</b>
			        recorded during the selected period.
			        An Approval occurs when a Family reaches
			        the <b>Approved</b> status for a specific Role.
			    </div>
			
			    <!-- METRIC -->
			    <div style='
			        font-size:10px;font-weight:700;text-transform:uppercase;
			        letter-spacing:0.5px;color:#666666;margin-bottom:6px;
			    '>
			        How is this metric calculated?
			    </div>
			
			    <div style='font-size:11px;line-height:1.5;margin-bottom:16px;'>
			        Each recorded transition into
			        <b>Approved</b> is counted according to its
			        effective date.
			        <br/><br/>
			        The selected period applies to the
			        <b>Approval Date</b>, not the date when the
			        Application originally started.
			        <br/><br/>
			        Therefore, an Application initiated in an earlier
			        period may contribute to the Approvals total
			        in the currently selected period.
			    </div>
			
			    <!-- INFO BOX -->
			    <div style='
			        width:100%;box-sizing:border-box;
			        background:#F5F5F5;border-radius:7px;padding:11px 12px;
			    '>
			        <div style='font-size:10px;font-weight:700;margin-bottom:5px;'>
			            How to interpret this information
			        </div>
			
			        <div style='font-size:10px;line-height:1.5;color:#555555;'>
			            Use this metric to understand how many Family
			            approval events occurred during the selected period.
			            <br/><br/>
			            The percentage below the KPI compares Approval
			            activity with the immediately preceding period
			            of equal duration.
			        </div>
			    </div>
			
			    <!-- NOTE -->
			    <div style='
			        margin-top:14px;padding-top:12px;
			        border-top:1px solid #E5E5E5;
			        font-size:10px;line-height:1.45;color:#666666;
			    '>
			        <b>Important:</b> Approvals measure
			        <b>approval activity, not unique Families</b>
			        or the number of Applications initiated during
			        the same period.
			        <br/><br/>
			        Approval and Onboarding counts may differ because
			        not every process has a recorded Approved transition.
			        Future-dated events are excluded.
			    </div>
			
			</div>
			"
		displayFolder: HTML
		lineageTag: b270c502-0211-4501-92d9-1b10cbcda1a5

	measure '(HTML) Help - Family Onboardings' =
			
			"
			<div style='
			    width:100%;height:100%;box-sizing:border-box;padding:18px;
			    font-family:Arial,sans-serif;color:#333333;background:#FFFFFF;
			'>
			
			    <!-- HEADER -->
			    <div style='display:flex;align-items:center;gap:8px;margin-bottom:14px;'>
			        <div style='
			            width:22px;height:22px;flex:0 0 22px;
			            display:flex;align-items:center;justify-content:center;
			            background:#F2F2F2;border-radius:50%;
			            font-size:12px;font-weight:700;
			        '>i</div>
			
			        <div style='font-size:15px;font-weight:700;line-height:1.2;'>
			            Family Onboardings
			        </div>
			    </div>
			
			    <!-- DESCRIPTION -->
			    <div style='font-size:11px;line-height:1.5;margin-bottom:16px;'>
			        Counts the number of <b>Family onboarding events</b>
			        recorded during the selected period.
			        An Onboarding occurs when a Family reaches
			        the <b>Onboarded</b> status for a specific Role.
			    </div>
			
			    <!-- METRIC -->
			    <div style='
			        font-size:10px;font-weight:700;text-transform:uppercase;
			        letter-spacing:0.5px;color:#666666;margin-bottom:6px;
			    '>
			        How is this metric calculated?
			    </div>
			
			    <div style='font-size:11px;line-height:1.5;margin-bottom:16px;'>
			        Each recorded transition into
			        <b>Onboarded</b> is counted according to its
			        effective date.
			        <br/><br/>
			        The selected period applies to the
			        <b>Onboarding Date</b>, regardless of when
			        the original Application was initiated.
			        <br/><br/>
			        An Onboarding may therefore be counted in a
			        different reporting period from its Application
			        or Approval.
			    </div>
			
			    <!-- INFO BOX -->
			    <div style='
			        width:100%;box-sizing:border-box;
			        background:#F5F5F5;border-radius:7px;padding:11px 12px;
			    '>
			        <div style='font-size:10px;font-weight:700;margin-bottom:5px;'>
			            How to interpret this information
			        </div>
			
			        <div style='font-size:10px;line-height:1.5;color:#555555;'>
			            Use this metric to understand the volume of
			            Family onboarding activity completed during
			            the selected period.
			            <br/><br/>
			            The percentage below the KPI compares Onboarding
			            activity with the immediately preceding period
			            of equal duration.
			        </div>
			    </div>
			
			    <!-- NOTE -->
			    <div style='
			        margin-top:14px;padding-top:12px;
			        border-top:1px solid #E5E5E5;
			        font-size:10px;line-height:1.45;color:#666666;
			    '>
			        <b>Important:</b> Onboardings represent
			        <b>recorded onboarding events, not unique Families</b>
			        or the number of currently active volunteer Families.
			        <br/><br/>
			        Some historical Onboarded records do not have a
			        preceding Approved event. As a result, Onboardings
			        may exceed Approvals, even when the full historical
			        period is selected.
			        Future-dated events are excluded.
			    </div>
			
			</div>
			"
		displayFolder: HTML
		lineageTag: cf84dc43-b715-4791-9d75-0ad12cf14b8d

	measure '(HTML) Help - Dynamic Pop-up - Approval Activity' = ```
			
			/*
			Dynamically returns the corresponding HTML tooltip
			based on the selected Help ID from the Arrangements
			helper table.
			*/
			
			VAR HelpID =
			    SELECTEDVALUE(
			        '(HELP) Approval Activity'[Help ID]
			    )
			
			RETURN
			SWITCH(
			    HelpID,
			
			    "FAMILY_APPLICATIONS",
			        [(HTML) Help - Family Applications],
			
			    "FAMILY_APPROVALS",
			        [(HTML) Help - Family Approvals],
			
			    "FAMILY_ONBOARDINGS",
			        [(HTML) Help - Family Onboardings],
			
			    "INDIVIDUAL_APPLICATIONS",
			        [(HTML) Help - Individual Applications],
			    
			    "INDIVIDUAL_APPROVALS",
			        [(HTML) Help - Individual Approvals],
			    
			    "INDIVIDUAL_ONBOARDINGS",
			        [(HTML) Help - Individual Onboardings],
			
			    "FAMILY_APPLICATION_OUTCOMES",
			        [(HTML) Help - Family Application Outcomes],
			
			    "INDIVIDUAL_APPLICATION_OUTCOMES",
			        [(HTML) Help - Individual Application Outcomes],
			
			    "FAMILY_APPLICATIONS_OVER_TIME",
			        [(HTML) Help - Family Applications Over Time],
			
			    "APPLICATION_BY_FAMILY_TYPE",
			        [(HTML) Help - Application by Family Type],
			
			    "INDIVIDUAL_APPLICATIONS_OVER_TIME",
			        [(HTML) Help - Individual Applications Over Time],
			
			    "APPLICATION_BY_PERSON_TYPE",
			        [(HTML) Help - Application by Person Type],
			
			    "FAMILY_APPLICATIONS_BY_ROLE",
			        [(HTML) Help - Family Applications by Role],
			
			    "INDIVIDUAL_APPLICATIONS_BY_ROLE",
			        [(HTML) Help - Individual Applications by Role],
			
			    BLANK()
			)
			```
		displayFolder: Measures
		lineageTag: 72fa1854-5ce8-44ec-af58-7584a0b8ca7b

