	partition 'Volunteer Family Function Assignment' = m
		mode: import
		queryGroup: Facts
		source = ```
				let
				  Source = #"OData",
				  FamilyFunctionAssignment = Source{[Name="FamilyFunctionAssignments", Signature="table"]}[Data],
				
				  selectColumns = Table.SelectColumns(
				    FamilyFunctionAssignment,
				    {
				      "OrganizationId",
				      "LocationId",
				      "ArrangementId",
				      "FamilyId",
				      "Function"
				    }
				  ),
				
				  renameColumns = Table.RenameColumns(
				    selectColumns,
				    {
				      {"OrganizationId", "organization_id"},
				      {"LocationId", "location_id"},
				      {"ArrangementId", "arrangement_id"},
				      {"FamilyId", "family_id"},
				      {"Function", "function"}
				    }
				  ),
				
				  addRLSKey = Table.AddColumn(
				    renameColumns,
				    "rls_key",
				    each Text.Combine({[organization_id], "-", [location_id]})
				  ),
				
				  // There are duplicated Family Ids in different orgs/locations:
				  addFamilyUniqueKey = Table.AddColumn(
				    addRLSKey,
				    "family_uid",
				    each
				        if [family_id] <> null then
				            Text.Combine({[rls_key], "-", [family_id]})
				        else
				            null,
				    type text
				  ),
				
				  // There are duplicated Arrangemets in different orgs/locations:
				  addArrangementUniqueKey = Table.AddColumn(
				    addFamilyUniqueKey,
				    "arrangement_uid",
				    each
				      if [arrangement_id] <> null then
				        Text.Combine({[rls_key], "-", [arrangement_id]})
				      else
				        null,
				      type text
				  )
				 
				in
				
				  addArrangementUniqueKey
				```

	annotation PBI_NavigationStepName = Navegação

