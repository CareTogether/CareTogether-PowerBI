	partition 'Child Location Record' = m
		mode: import
		queryGroup: Facts
		source = ```
				let
				
				  Source = #"OData",
				  childLocationRecord = Source{[Name="ChildLocationRecords", Signature="table"]}[Data],
				
				  expandClientChild = Table.ExpandRecordColumn(childLocationRecord, "Child", {"FirstName", "LastName", "Family"}, {"Child.FirstName", "Child.LastName", "Child.Family"}),
				  expandClientFamily = Table.ExpandRecordColumn(expandClientChild, "Child.Family", {"Name"}, {"Child.Family.Name"}),
				  expandVolunteerFamily = Table.ExpandRecordColumn(expandClientFamily, "Family", {"Name"}, {"Family.Name"}),
				  expandArrangementType = Table.ExpandRecordColumn(expandVolunteerFamily, "Arrangement", {"TypeName"}, {"Arrangement.TypeName"}),
				
				  addChildFullName = Table.AddColumn(
				    expandArrangementType,
				    "ChildPersonName",
				    each Text.Combine({[Child.FirstName], " ", [Child.LastName]})
				  ),
				
				  selectColumns = Table.SelectColumns(
				    addChildFullName,
				    {
				      "OrganizationId",
				      "LocationId",
				      "ArrangementId",
				      "Arrangement.TypeName",
				      "ChildPersonId",
				      "ChildPersonName",
				      "Child.Family.Name",
				      "FamilyId",
				      "Family.Name",
				      "StartedAtUtc",
				      "EndedAtUtc",
				      "ChildcarePlan",
				      "Duration"
				    }
				  ),
				
				  renameColumns = Table.RenameColumns(
				    selectColumns,
				    {
				      {"OrganizationId", "organization_id"},
				      {"LocationId", "location_id"},
				      {"ArrangementId", "arrangement_id"},
				      {"Arrangement.TypeName", "arrangement_type"},
				      {"ChildPersonId", "child_person_id"},
				      {"ChildPersonName", "child_person_name"},
				      {"Child.Family.Name", "child_family_name"}, 
				      {"FamilyId", "family_id"},
				      {"Family.Name", "family_name"},
				      {"StartedAtUtc", "started_at_utc"},
				      {"EndedAtUtc", "ended_at_utc"},
				      {"ChildcarePlan", "childcare_plan"},
				      {"Duration", "duration"}
				
				    }
				  ),
				
				  addRLSKey = Table.AddColumn(
				    renameColumns,
				    "rls_key",
				    each Text.Combine({[organization_id], "-", [location_id]})
				  ),
				
				  addArrangementUniqueKey = Table.AddColumn(
				    addRLSKey,
				    "arrangement_uid",
				    each
				      if [arrangement_id] <> null then
				        Text.Combine({[rls_key], "-", [arrangement_id]})
				      else
				        null,
				      type text
				  ),
				
				  addChildPersonUniqueKey = Table.AddColumn(
				    addArrangementUniqueKey,
				    "child_person_uid",
				    each
				      if [child_person_id] <> null then
				        Text.Combine({[rls_key], "-", [child_person_id]})
				      else
				        null,
				      type text
				  ),
				
				  addVolunteerFamilyUniqueKey = Table.AddColumn(
				    addChildPersonUniqueKey,
				    "family_uid",
				    each
				      if [family_id] <> null then
				        Text.Combine({[rls_key], "-", [family_id]})
				      else
				        null,
				      type text
				  ),
				
				  addTableIndex = Table.AddIndexColumn(
				    addVolunteerFamilyUniqueKey,
				    "index",
				    1,
				    1
				  ),
				
				  // Find the date when each child first received childcare.
				  getFirstCareDate = Table.SelectRows(
				    addTableIndex,
				    each
				      [started_at_utc] <> null and
				      [childcare_plan] <> null and
				      [childcare_plan] <> "WithParent"
				  ),
				
				  groupFirstCareDate = Table.Group(
				    getFirstCareDate,
				    {"child_person_uid"},
				    {
				      {
				        "first_care_date",
				        each List.Min([started_at_utc]),
				        type nullable datetimezone
				      }
				    }
				  ),
				
				  mergeTables = Table.NestedJoin(
				    addTableIndex,
				    {"child_person_uid"},
				    groupFirstCareDate,
				    {"child_person_uid"},
				    "first_care",
				    JoinKind.LeftOuter
				  ),
				
				  expandFirstCareDate = Table.ExpandTableColumn(
				    mergeTables,
				    "first_care",
				    {"first_care_date"},
				    {"first_care_date"}
				  ),
				
				  addIsFirstCareFlag = Table.AddColumn(
				    expandFirstCareDate,
				    "is_first_care",
				    each
				      [started_at_utc] = [first_care_date],
				    type logical
				  )
				
				in
				
				  addIsFirstCareFlag
				```

	changedProperty = IsHidden

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

