table 'Child Location Record'
	lineageTag: 364c51cc-cbfe-421e-8f4c-0e1d82d15cd5

	measure '# of Children Cared For CP' =
			
			/*
			CP = Current Period
			
			Counts the number of distinct children who received
			volunteer childcare during the selected timeframe,
			regardless of when their care originally started.
			
			A child is considered cared for when:
			- The childcare plan is not WithParent.
			- The child identifier and start date are populated.
			- The care period overlaps the selected timeframe.
			- The care started on or before today.
			- The care end date is blank (ongoing care) or
			  falls on or after the selected timeframe start.
			
			Each child is counted only once, regardless of the
			number of childcare records or Arrangements.
			
			The selected timeframe is applied to the actual
			care period, not the Arrangement request date.
			
			Location filtering uses the inactive relationship
			between Child Location Record and Location.
			*/
			
			VAR startDate =
			    [Selected Timeframe Start]
			
			VAR endDate =
			    [Selected Timeframe End]
			
			VAR effectiveEndDate =
			    MIN(endDate, TODAY())
			
			RETURN
			IF(
			    ISBLANK(startDate)
			        || ISBLANK(endDate)
			        || startDate > effectiveEndDate,
			    BLANK(),
			    CALCULATE(
			        DISTINCTCOUNT('Child Location Record'[child_person_id]),
			        NOT ISBLANK('Child Location Record'[child_person_id]),
			        NOT ISBLANK('Child Location Record'[started_at_utc]),
			        'Child Location Record'[childcare_plan] <> "WithParent",
			        'Child Location Record'[started_at_utc] < effectiveEndDate + 1,
			        ISBLANK('Child Location Record'[ended_at_utc]) || 'Child Location Record'[ended_at_utc] >= startDate,
			        USERELATIONSHIP('Child Location Record'[location_id],Location[location_id])
			    )
			)
		formatString: #,0
		lineageTag: 94503cc4-8c20-47ab-ba6d-6d66fb7293f2

		changedProperty = IsHidden

	measure '# of Children Cared For PP' =
			
			/*
			PP = Previous Period
			
			Counts the number of distinct children who received
			volunteer childcare during the previous period,
			regardless of when their care originally started.
			
			A child is considered cared for when:
			- The childcare plan is not WithParent.
			- The child identifier and start date are populated.
			- The care period overlaps the previous period.
			- The care started on or before today.
			- The care end date is blank (ongoing care) or
			  falls on or after the previous period start.
			
			Each child is counted only once, regardless of the
			number of childcare records, Arrangements, or Locations.
			
			The previous period has the same number of days
			as the selected current period.
			
			The timeframe is applied to the actual care period,
			not the Arrangement request date.
			
			Location filtering uses the inactive relationship
			between Child Location Record and Location.
			*/
			
			VAR currentStartDate =
			    [Selected Timeframe Start]
			
			VAR currentEndDate =
			    [Selected Timeframe End]
			
			VAR todayDate =
			    TODAY()
			
			VAR periodDays =
			    DATEDIFF(
			        currentStartDate,
			        currentEndDate,
			        DAY
			    ) + 1
			
			VAR previousStartDate =
			    currentStartDate - periodDays
			
			VAR previousEndDate =
			    currentStartDate - 1
			
			VAR effectiveEndDate =
			    MIN(previousEndDate, todayDate)
			
			RETURN
			IF(
			    ISBLANK(currentStartDate) || ISBLANK(currentEndDate) || previousStartDate > effectiveEndDate,
			    BLANK(),
			    CALCULATE(
			        DISTINCTCOUNT('Child Location Record'[child_person_id]),
			        NOT ISBLANK('Child Location Record'[child_person_id]),
			        NOT ISBLANK('Child Location Record'[started_at_utc]),
			        'Child Location Record'[childcare_plan] <> "WithParent",
			        'Child Location Record'[started_at_utc] < effectiveEndDate + 1,
			        ISBLANK('Child Location Record'[ended_at_utc]) || 'Child Location Record'[ended_at_utc] >= previousStartDate,
			        USERELATIONSHIP('Child Location Record'[location_id],Location[location_id])
			    )
			)
		formatString: #,0
		lineageTag: 56db856f-34d0-45d4-9f0c-5610c4a2a1cf

		changedProperty = IsHidden

	measure '# of Children Care For PoP' =
			
			
			VAR currentPeriod = [# of Children Cared For CP]
			VAR previousPeriod = [# of Children Cared For PP]
			VAR Perc = DIVIDE(currentPeriod - previousPeriod, previousPeriod)
			
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(Perc), BLANK(),
			    Perc >= 0, FORMAT(Perc, "+0%") & "▲",
			    Perc < 0, FORMAT(Perc, "0%") & "▼",
			    "0%"
			)
		lineageTag: fbe9b2f9-3c04-428a-93f6-97d8c7d47090

		changedProperty = IsHidden

	measure '# of First-Time Children Cared For CP' =
			
			
			/*
			CP = Current Period
			
			Counts the number of distinct children who received
			volunteer childcare for the first time during the
			selected timeframe.
			
			A child is considered a first-time care recipient when:
			- The childcare plan is not WithParent.
			- The child identifier and first care date are populated.
			- The first valid care date falls within the selected timeframe.
			- The first valid care date is on or before today.
			
			Each child is counted only once, regardless of the
			number of childcare records, Arrangements, or Locations.
			
			The selected timeframe is applied to the child's
			first valid care date, not the Arrangement request date.
			
			The Location filter is applied through the
			inactive relationship with the Location table.
			*/
			
			VAR startDate = [Selected Timeframe Start]
			VAR endDate = [Selected Timeframe End]
			VAR todayDate = TODAY()
			VAR effectiveEndDate = MIN(endDate, todayDate)
			
			RETURN
			IF(
			    startDate > todayDate,
			    BLANK(),
			    CALCULATE(
			        DISTINCTCOUNT('Child Location Record'[child_person_id]),
			        NOT ISBLANK('Child Location Record'[child_person_id]),
			        NOT ISBLANK('Child Location Record'[first_care_date]),
			        'Child Location Record'[childcare_plan] <> "WithParent",
			        'Child Location Record'[first_care_date] >= startDate,
			        'Child Location Record'[first_care_date] < effectiveEndDate + 1,
			        USERELATIONSHIP('Child Location Record'[location_id], Location[location_id])
			    )
			)
		formatString: #,0
		lineageTag: 2bb0d0bc-cc73-4888-82ba-5022477a362b

		changedProperty = IsHidden

	measure '# of First-Time Children Cared For PP' =
			
			
			/*
			PP = Previous Period
			
			Counts the number of distinct children who received
			volunteer childcare for the first time during the
			previous period.
			
			A child is considered a first-time care recipient when:
			- The childcare plan is not WithParent.
			- The child identifier and first care date are populated.
			- The first valid care date falls within the previous period.
			- The first valid care date is on or before today.
			
			Each child is counted only once, regardless of the
			number of childcare records, Arrangements, or Locations.
			
			The previous period has the same number of days
			as the currently selected timeframe.
			
			The timeframe is applied to the child's first valid
			care date, not the Arrangement request date.
			
			The Location filter is applied through the
			inactive relationship with the Location table.
			*/
			
			VAR currentStartDate = [Selected Timeframe Start]
			VAR currentEndDate = [Selected Timeframe End]
			VAR todayDate = TODAY()
			VAR periodDays = DATEDIFF(currentStartDate, currentEndDate, DAY) + 1
			VAR previousStartDate = currentStartDate - periodDays
			VAR previousEndDate = currentStartDate - 1
			VAR effectiveEndDate = MIN(previousEndDate, todayDate)
			
			RETURN
			IF(
			    previousStartDate > todayDate,
			    BLANK(),
			    CALCULATE(
			        DISTINCTCOUNT('Child Location Record'[child_person_id]),
			        NOT ISBLANK('Child Location Record'[child_person_id]),
			        NOT ISBLANK('Child Location Record'[first_care_date]),
			        'Child Location Record'[childcare_plan] <> "WithParent",
			        'Child Location Record'[first_care_date] >= previousStartDate,
			        'Child Location Record'[first_care_date] < effectiveEndDate + 1,
			        USERELATIONSHIP('Child Location Record'[location_id], Location[location_id])
			    )
			)
		formatString: #,0
		lineageTag: 381abd53-3f51-47d1-9710-b63f895373ec

		changedProperty = IsHidden

	measure '# of First-Time Children Care For PoP' =
			
			
			VAR currentPeriod = [# of First-Time Children Cared For CP]
			VAR previousPeriod = [# of First-Time Children Cared For PP]
			VAR Perc = DIVIDE(currentPeriod - previousPeriod, previousPeriod)
			
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(Perc), BLANK(),
			    Perc >= 0, FORMAT(Perc, "+0%") & "▲",
			    Perc < 0, FORMAT(Perc, "0%") & "▼",
			    "0%"
			)
		lineageTag: 8ec68a66-50f4-4cfd-9bf8-04f4cceedc09

		changedProperty = IsHidden

	measure 'Avg. Care Days per Child CP' =
			
			/*
			CP = Current Period
			
			Calculates the average number of care days
			received per distinct child during the selected
			timeframe, across all volunteer families.
			
			Each child/date combination is counted once,
			even when multiple care records overlap.
			
			Excludes WithParent care and future dates.
			
			Child identifiers are retrieved from the
			related Child Location Record table.
			
			Location filtering uses the inactive relationship
			between Child Location Record and Location.
			*/
			
			VAR startDate = [Selected Timeframe Start]
			VAR endDate = [Selected Timeframe End]
			VAR effectiveEndDate = MIN(endDate, TODAY())
			
			RETURN
			IF(
			    startDate > effectiveEndDate,
			    BLANK(),
			    VAR careRecords =
			        CALCULATETABLE(
			            SELECTCOLUMNS(
			                'Child Location Record Expanded',
			                "Child ID",
			                    RELATED(
			                        'Child Location Record'[child_person_id]
			                    ),
			                "Care Date",
			                    'Child Location Record Expanded'[date]
			            ),
			            'Child Location Record Expanded'[date] >= startDate,
			            'Child Location Record Expanded'[date] < effectiveEndDate + 1,
			            'Child Location Record Expanded'[childcare_plan] <> "WithParent",
			            USERELATIONSHIP(
			                'Child Location Record'[location_id],
			                Location[location_id]
			            )
			        )
			
			    VAR distinctCareDays =
			        DISTINCT(
			            FILTER(
			                careRecords,
			                NOT ISBLANK([Child ID])
			            )
			        )
			
			    VAR totalCareDays =
			        COUNTROWS(distinctCareDays)
			
			    VAR totalChildren =
			        COUNTROWS(
			            DISTINCT(
			                SELECTCOLUMNS(
			                    distinctCareDays,
			                    "Child ID", [Child ID]
			                )
			            )
			        )
			
			    RETURN
			        DIVIDE(totalCareDays, totalChildren)
			)
		formatString: 0
		lineageTag: 3da8a209-d13f-4072-9655-207a6cffad1f

		changedProperty = IsHidden

	measure 'Avg. Days with Same Family CP' =
			
			/*
			CP = Current Period
			
			Calculates the average number of care days
			per child and volunteer family combination
			during the selected timeframe.
			
			Care days are accumulated across Arrangements.
			
			Each child/family/date combination is counted
			only once to prevent duplicate care days.
			
			Excludes WithParent care and future dates.
			
			Child and volunteer family identifiers are
			retrieved from Child Location Record.
			
			Location filtering uses the inactive relationship
			between Child Location Record and Location.
			*/
			
			VAR startDate = [Selected Timeframe Start]
			VAR endDate = [Selected Timeframe End]
			VAR effectiveEndDate = MIN(endDate, TODAY())
			
			RETURN
			IF(
			    startDate > effectiveEndDate,
			    BLANK(),
			    VAR careRecords =
			        CALCULATETABLE(
			            SELECTCOLUMNS(
			                'Child Location Record Expanded',
			                "Child ID",
			                    RELATED(
			                        'Child Location Record'[child_person_id]
			                    ),
			                "Volunteer Family ID",
			                    RELATED(
			                        'Child Location Record'[family_id]
			                    ),
			                "Care Date",
			                    'Child Location Record Expanded'[date]
			            ),
			            'Child Location Record Expanded'[date] >= startDate,
			            'Child Location Record Expanded'[date] < effectiveEndDate + 1,
			            'Child Location Record Expanded'[childcare_plan] <> "WithParent",
			            USERELATIONSHIP(
			                'Child Location Record'[location_id],
			                Location[location_id]
			            )
			        )
			
			    VAR distinctCareDays =
			        DISTINCT(
			            FILTER(
			                careRecords,
			                NOT ISBLANK([Child ID])
			                    && NOT ISBLANK([Volunteer Family ID])
			            )
			        )
			
			    VAR totalCareDays =
			        COUNTROWS(distinctCareDays)
			
			    VAR childFamilyCombinations =
			        COUNTROWS(
			            DISTINCT(
			                SELECTCOLUMNS(
			                    distinctCareDays,
			                    "Child ID", [Child ID],
			                    "Volunteer Family ID", [Volunteer Family ID]
			                )
			            )
			        )
			
			    RETURN
			        DIVIDE(
			            totalCareDays,
			            childFamilyCombinations
			        )
			)
		formatString: #,0
		lineageTag: 384fa1e0-2347-4151-b4f0-518148d728cc

		changedProperty = IsHidden

	measure 'Avg. Care Days per Child PP' =
			
			/*
			PP = Previous Period
			
			Calculates the average number of care days
			received per distinct child during the previous
			period, across all volunteer families.
			
			The previous period has the same number of
			calendar days as the selected current period
			and ends one day before it begins.
			
			Each child/date combination is counted once,
			even when multiple care records overlap.
			
			Excludes WithParent care and future dates.
			
			Child identifiers are retrieved from the
			related Child Location Record table.
			
			Location filtering uses the inactive relationship
			between Child Location Record and Location.
			*/
			
			VAR startDate = [Selected Timeframe Start]
			VAR endDate = [Selected Timeframe End]
			
			VAR periodDays =
			    DATEDIFF(startDate, endDate, DAY) + 1
			
			VAR previousStartDate =
			    startDate - periodDays
			
			VAR previousEndDate =
			    startDate - 1
			
			VAR effectiveEndDate =
			    MIN(previousEndDate, TODAY())
			
			RETURN
			IF(
			    previousStartDate > effectiveEndDate,
			    BLANK(),
			    VAR careRecords =
			        CALCULATETABLE(
			            SELECTCOLUMNS(
			                'Child Location Record Expanded',
			                "Child ID",
			                    RELATED(
			                        'Child Location Record'[child_person_id]
			                    ),
			                "Care Date",
			                    'Child Location Record Expanded'[date]
			            ),
			            'Child Location Record Expanded'[date] >= previousStartDate,
			            'Child Location Record Expanded'[date] < effectiveEndDate + 1,
			            'Child Location Record Expanded'[childcare_plan] <> "WithParent",
			            USERELATIONSHIP(
			                'Child Location Record'[location_id],
			                Location[location_id]
			            )
			        )
			
			    VAR distinctCareDays =
			        DISTINCT(
			            FILTER(
			                careRecords,
			                NOT ISBLANK([Child ID])
			            )
			        )
			
			    VAR totalCareDays =
			        COUNTROWS(distinctCareDays)
			
			    VAR totalChildren =
			        COUNTROWS(
			            DISTINCT(
			                SELECTCOLUMNS(
			                    distinctCareDays,
			                    "Child ID", [Child ID]
			                )
			            )
			        )
			
			    RETURN
			        DIVIDE(totalCareDays, totalChildren)
			)
		lineageTag: 61ff323b-af31-4b47-82e0-3c1b2e1ee930

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg. Care Days per Child PoP' =
			
			
			VAR currentPeriod = [Avg. Care Days per Child CP]
			VAR previousPeriod = [Avg. Care Days per Child PP]
			VAR Perc = DIVIDE(currentPeriod - previousPeriod, previousPeriod)
			
