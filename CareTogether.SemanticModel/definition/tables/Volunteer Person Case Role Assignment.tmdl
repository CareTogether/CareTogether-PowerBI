	partition 'Volunteer Person Case Role Assignment' = m
		mode: import
		queryGroup: Facts
		source = ```
				let
				  Source = #"OData",
				  CasesRoleAssignments = Source{[Name="CasesRoleAssignments", Signature="table"]}[Data],
				 
				  selectColumns = Table.SelectColumns(
				    CasesRoleAssignments,
				    {
				      "CaseId",
				      "OrganizationId",
				      "LocationId",
				      "PersonId",
				      "PersonName",
				      "AssignmentRole",
				      "AssignedAtUtc",
				      "AssignedByUserId"
				    }
				  ),
				
				  renameColumns = Table.RenameColumns(
				    selectColumns,
				    {
				      {"CaseId", "case_id"},
				      {"OrganizationId", "organization_id"},
				      {"LocationId", "location_id"},
				      {"PersonId", "person_id"},
				      {"PersonName", "person_name"},
				      {"AssignmentRole", "role"},
				      {"AssignedAtUtc", "assigned_at_utc"},
				      {"AssignedByUserId", "assigned_by_user_id"}
				    }
				  ),
				
				  addRLSKey = Table.AddColumn(
				    renameColumns,
				    "rls_key",
				    each Text.Combine({[organization_id], "-", [location_id]})
				  ),
				
				  addCaseUniqueKey = Table.AddColumn(
				      addRLSKey,
				      "case_uid",
				      each
				          if [case_id] <> null then
				              Text.Combine({[rls_key], "-", [case_id]})
				          else
				              null,
				      type text
				  ),
				
				  addPersonUniqueKey = Table.AddColumn(
				      addCaseUniqueKey,
				      "person_uid",
				      each
				          if [person_id] <> null then
				              Text.Combine({[rls_key], "-", [person_id]})
				          else
				              null,
				      type text
				  )
				
				in
				  
				  addPersonUniqueKey
				```

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

