			            'Volunteer Person Role Approval'[valid_from]
			        )
			    ),
			    'Volunteer Person Role Approval'[status] = "Approved",
			    'Volunteer Person Role Approval'[valid_from] >= previousStartDate,
			    'Volunteer Person Role Approval'[valid_from] < previousEndDate + 1,
			    USERELATIONSHIP('Volunteer Person Role Approval'[location_id],Location[location_id])
			)
		formatString: 0
		displayFolder: Approval Activity Measures
		lineageTag: 19be616a-f66b-4f25-be89-7f2d59a1de81

	measure '# of Individual Approvals PoP' =
			
			/*
			PoP = Period over Period
			
			Calculates the percentage change in Individual Approvals
			between the current and previous periods.
			
			Displays an upward arrow for positive or zero change
			and a downward arrow for negative change.
			*/
			
			VAR currentPeriod = [# of Individual Approvals CP]
			VAR previousPeriod = [# of Individual Approvals PP]
			VAR perc = DIVIDE(currentPeriod - previousPeriod, previousPeriod)
			
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(perc), BLANK(),
			    perc >= 0, FORMAT(perc, "+0%") & "▲",
			    perc < 0, FORMAT(perc, "0%") & "▼",
			    "0%"
			)
		displayFolder: Approval Activity Measures
		lineageTag: fcc0cd94-03c9-49b9-8c9d-c83740192df9

