table 'Volunteer Person Role Approval'
	lineageTag: 37f9c72c-441f-466d-bcb6-081e0ead75e0

	measure '# of Individual Applications CP' =
			
			/*
			CP = Current Period
			
			Counts the number of Individual Applications initiated
			during the selected timeframe.
			
			Each entry into Prospective represents a new Application
			for a specific Person and Role, including reapplications.
			
			Applications are identified by Person ID, Role UID,
			and Prospective start date.
			
			Duplicate records across Locations are counted only once.
			*/
			
			VAR selectedStartDate = [Selected Timeframe Start]
			VAR selectedEndDate = [Selected Timeframe End]
			
			RETURN
			CALCULATE(
			    COUNTROWS(
			        SUMMARIZE(
			            'Volunteer Person Role Approval',
			            'Volunteer Person Role Approval'[person_id],
			            'Volunteer Person Role Approval'[role_uid],
			            'Volunteer Person Role Approval'[valid_from]
			        )
			    ),
			    'Volunteer Person Role Approval'[status] = "Prospective",
			    'Volunteer Person Role Approval'[valid_from] >= selectedStartDate,
			    'Volunteer Person Role Approval'[valid_from] < selectedEndDate + 1,
			    USERELATIONSHIP('Volunteer Person Role Approval'[location_id], Location[location_id])
			)
		formatString: 0
		displayFolder: Approval Activity Measures
		lineageTag: a049791a-6778-41ae-aef5-b270867822be

	measure '# of Individual Applications PP' =
			
			
			/*
			PP = Previous Period
			
			Counts the number of Individual Applications initiated
			during the previous period.
			
			The previous period has the same number of calendar days
			as the currently selected timeframe.
			
			Each entry into Prospective represents a new Application
			for a specific Person and Role, including reapplications.
			
			Applications are identified by Person ID, Role UID,
			and Prospective start date.
			
			Duplicate records across Locations are counted only once.
			*/
			
			VAR selectedStartDate = [Selected Timeframe Start]
			VAR selectedEndDate = [Selected Timeframe End]
			
			VAR periodDays = DATEDIFF(selectedStartDate, selectedEndDate, DAY) + 1
			VAR previousStartDate = selectedStartDate - periodDays
			VAR previousEndDate = selectedStartDate - 1
			
			RETURN
			CALCULATE(
			    COUNTROWS(
			        SUMMARIZE(
			            'Volunteer Person Role Approval',
			            'Volunteer Person Role Approval'[person_id],
			            'Volunteer Person Role Approval'[role_uid],
			            'Volunteer Person Role Approval'[valid_from]
			        )
			    ),
			    'Volunteer Person Role Approval'[status] = "Prospective",
			    'Volunteer Person Role Approval'[valid_from] >= previousStartDate,
			    'Volunteer Person Role Approval'[valid_from] < previousEndDate + 1,
			    USERELATIONSHIP('Volunteer Person Role Approval'[location_id], Location[location_id])
			)
		formatString: 0
		displayFolder: Approval Activity Measures
		lineageTag: 0e13c497-2e0a-4668-bbc3-9bd344dbe9ad

	measure '# of Individual Applications PoP' =
			
			
			VAR currentPeriod = [# of Individual Applications CP]
			VAR previousPeriod = [# of Individual Applications PP]
			VAR perc = DIVIDE(currentPeriod - previousPeriod, previousPeriod)
			
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(perc), BLANK(),
			    perc >= 0, FORMAT(perc, "+0%") & "▲",
			    perc < 0, FORMAT(perc, "0%") & "▼",
			    "0%"
			)
		displayFolder: Approval Activity Measures
		lineageTag: 5127efa4-9d27-4cc1-bc19-e961bc995dce

	measure '# of Individual Approvals CP' =
			
			/*
			CP = Current Period
			
			Counts the number of Individual Approval events
			during the selected timeframe.
			
			Each entry into Approved represents an Approval
			event for a specific Person and Role.
			
			Approvals are identified by Person ID, Role UID,
			and Approved start date.
			
			Duplicate records across Locations are counted only once.
			
			This is an activity-based measure, not a cohort measure.
			*/
			
			VAR selectedStartDate = [Selected Timeframe Start]
			VAR selectedEndDate = [Selected Timeframe End]
			
			RETURN
			CALCULATE(
			    COUNTROWS(
			        SUMMARIZE(
			            'Volunteer Person Role Approval',
			            'Volunteer Person Role Approval'[person_id],
			            'Volunteer Person Role Approval'[role_uid],
			            'Volunteer Person Role Approval'[valid_from]
			        )
			    ),
			    'Volunteer Person Role Approval'[status] = "Approved",
			    'Volunteer Person Role Approval'[valid_from] >= selectedStartDate,
			    'Volunteer Person Role Approval'[valid_from] < selectedEndDate + 1,
			    USERELATIONSHIP('Volunteer Person Role Approval'[location_id],Location[location_id])
			)
		formatString: 0
		displayFolder: Approval Activity Measures
		lineageTag: 54656648-ecd7-4603-a92b-ea59477e3811

	measure '# of Individual Approvals PP' =
			
			/*
			PP = Previous Period
			
			Counts the number of Individual Approval events
			during the previous period.
			
			The previous period has the same number of calendar days
			as the currently selected timeframe.
			
			Each entry into Approved represents an Approval
			event for a specific Person and Role.
			
			Approvals are identified by Person ID, Role UID,
			and Approved start date.
			
			Duplicate records across Locations are counted only once.
			
			This is an activity-based measure, not a cohort measure.
			*/
			
			VAR selectedStartDate = [Selected Timeframe Start]
			VAR selectedEndDate = [Selected Timeframe End]
			
			VAR periodDays = DATEDIFF(selectedStartDate, selectedEndDate, DAY) + 1
			VAR previousStartDate = selectedStartDate - periodDays
			VAR previousEndDate = selectedStartDate - 1
			
			RETURN
			CALCULATE(
			    COUNTROWS(
			        SUMMARIZE(
			            'Volunteer Person Role Approval',
			            'Volunteer Person Role Approval'[person_id],
			            'Volunteer Person Role Approval'[role_uid],
			            'Volunteer Person Role Approval'[valid_from]
			        )
			    ),
			    'Volunteer Person Role Approval'[status] = "Approved",
			    'Volunteer Person Role Approval'[valid_from] >= previousStartDate,
			    'Volunteer Person Role Approval'[valid_from] < previousEndDate + 1,
			    USERELATIONSHIP('Volunteer Person Role Approval'[location_id],Location[location_id])
			)
		formatString: 0
		displayFolder: Approval Activity Measures
		lineageTag: 19be616a-f66b-4f25-be89-7f2d59a1de81

	measure '# of Individual Approvals PoP' =
			
			/*
			PoP = Period over Period
			
			Calculates the percentage change in Individual Approvals
			between the current and previous periods.
			
			Displays an upward arrow for positive or zero change
			and a downward arrow for negative change.
			*/
			
			VAR currentPeriod = [# of Individual Approvals CP]
			VAR previousPeriod = [# of Individual Approvals PP]
			VAR perc = DIVIDE(currentPeriod - previousPeriod, previousPeriod)
			
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(perc), BLANK(),
			    perc >= 0, FORMAT(perc, "+0%") & "▲",
			    perc < 0, FORMAT(perc, "0%") & "▼",
			    "0%"
			)
		displayFolder: Approval Activity Measures
		lineageTag: fcc0cd94-03c9-49b9-8c9d-c83740192df9

	measure '# of Individual Onboardings CP' =
			
			/*
			CP = Current Period
			
			Counts the number of Individual Onboarding events
			during the selected timeframe.
			
			Each entry into Onboarded represents an Onboarding
			event for a specific Person and Role.
			
			Onboardings are identified by Person ID, Role UID,
			and Onboarded start date.
			
			Duplicate records across Locations are counted only once.
			
			This is an activity-based measure, not a cohort measure.
			*/
			
			VAR selectedStartDate = [Selected Timeframe Start]
			VAR selectedEndDate = [Selected Timeframe End]
			
			RETURN
			CALCULATE(
			    COUNTROWS(
			        SUMMARIZE(
			            'Volunteer Person Role Approval',
			            'Volunteer Person Role Approval'[person_id],
			            'Volunteer Person Role Approval'[role_uid],
			            'Volunteer Person Role Approval'[valid_from]
			        )
			    ),
			    'Volunteer Person Role Approval'[status] = "Onboarded",
			    'Volunteer Person Role Approval'[valid_from] >= selectedStartDate,
			    'Volunteer Person Role Approval'[valid_from] < selectedEndDate + 1,
			    USERELATIONSHIP('Volunteer Person Role Approval'[location_id], Location[location_id])
			)
		formatString: 0
		displayFolder: Approval Activity Measures
		lineageTag: 6e37ad91-6f2e-4860-9ae7-88fe671ebdcc

