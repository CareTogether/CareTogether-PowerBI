	column 'Individual Application Final Status' =
			
			/*
			Identifies the final observed status of each Individual Application.
			
			Each entry into Prospective starts a new Application cycle
			for the same Person and Role.
			
			All subsequent status records belong to that Application
			until the next Prospective entry.
			
			The final status is the latest status recorded within
			the Application cycle, based on valid_from.
			
			Application cycles are tracked across Locations using
			Person ID and Role UID.
			
			Future-dated status transitions are excluded.
			
			Records without a preceding Prospective entry return BLANK.
			*/
			
			VAR currentPerson = 'Volunteer Person Role Approval'[person_id]
			VAR currentRole = 'Volunteer Person Role Approval'[role_uid]
			VAR currentDate = 'Volunteer Person Role Approval'[valid_from]
			
			VAR applicationStartDate =
			    CALCULATE(
			        MAX('Volunteer Person Role Approval'[valid_from]),
			        FILTER(
			            ALL('Volunteer Person Role Approval'),
			            'Volunteer Person Role Approval'[person_id] = currentPerson &&
			            'Volunteer Person Role Approval'[role_uid] = currentRole &&
			            'Volunteer Person Role Approval'[status] = "Prospective" &&
			            'Volunteer Person Role Approval'[valid_from] <= currentDate
			        )
			    )
			
			VAR nextApplicationStartDate =
			    CALCULATE(
			        MIN('Volunteer Person Role Approval'[valid_from]),
			        FILTER(
			            ALL('Volunteer Person Role Approval'),
			            'Volunteer Person Role Approval'[person_id] = currentPerson &&
			            'Volunteer Person Role Approval'[role_uid] = currentRole &&
			            'Volunteer Person Role Approval'[status] = "Prospective" &&
			            'Volunteer Person Role Approval'[valid_from] > applicationStartDate
			        )
			    )
			
			VAR lastStatusDate =
			    CALCULATE(
			        MAX('Volunteer Person Role Approval'[valid_from]),
			        FILTER(
			            ALL('Volunteer Person Role Approval'),
			            'Volunteer Person Role Approval'[person_id] = currentPerson &&
			            'Volunteer Person Role Approval'[role_uid] = currentRole &&
			            'Volunteer Person Role Approval'[valid_from] >= applicationStartDate &&
			            (
			                ISBLANK(nextApplicationStartDate) ||
			                'Volunteer Person Role Approval'[valid_from] < nextApplicationStartDate
			            ) &&
			            'Volunteer Person Role Approval'[valid_from] < TODAY() + 1
			        )
			    )
			
			VAR finalStatus =
			    CALCULATE(
			        SELECTEDVALUE('Volunteer Person Role Approval'[status]),
			        FILTER(
			            ALL('Volunteer Person Role Approval'),
			            'Volunteer Person Role Approval'[person_id] = currentPerson &&
			            'Volunteer Person Role Approval'[role_uid] = currentRole &&
			            'Volunteer Person Role Approval'[valid_from] = lastStatusDate
			        )
			    )
			
			RETURN
			IF(
			    NOT ISBLANK(applicationStartDate) &&
			    NOT ISBLANK(currentPerson) &&
			    NOT ISBLANK(currentRole) &&
			    NOT ISBLANK(lastStatusDate),
			    finalStatus,
			    BLANK()
			)
		displayFolder: _calculated_columns
		lineageTag: c9a2b8f0-4d7e-4c9c-a96a-1bb9e519dcba
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Individual Application Type' =
			
			
			/*
			Classifies each Individual Application as New or Returning
			based on the Person and Role combination.
			
			Each entry into Prospective represents a new Application,
			including renewals and reapplications.
			
			The first Prospective date for each Person and Role
			is classified as a New Application.
			
			Subsequent Prospective dates for the same Person and Role
			are classified as Returning Applications.
			
			Applications are tracked across Locations using
			Person ID and Role UID.
			
			Only Prospective records receive a classification.
			*/
			
			VAR currentPerson = 'Volunteer Person Role Approval'[person_id]
			VAR currentRole = 'Volunteer Person Role Approval'[role_uid]
			VAR currentDate = 'Volunteer Person Role Approval'[valid_from]
			VAR currentStatus = 'Volunteer Person Role Approval'[status]
			
			VAR firstApplicationDate =
			    CALCULATE(
			        MIN('Volunteer Person Role Approval'[valid_from]),
			        FILTER(
			            ALL('Volunteer Person Role Approval'),
			            'Volunteer Person Role Approval'[person_id] = currentPerson &&
			            'Volunteer Person Role Approval'[role_uid] = currentRole &&
			            'Volunteer Person Role Approval'[status] = "Prospective"
			        )
			    )
			
			RETURN
			IF(
			    currentStatus = "Prospective",
			    IF(
			        currentDate = firstApplicationDate,
			        "New",
			        "Returning"
			    ),
			    BLANK()
			)
		displayFolder: _calculated_columns
		lineageTag: 1a44cd6f-f791-4f20-bdb2-44c72bc8e16c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'Volunteer Person Role Approval' = m
		mode: import
		queryGroup: Facts
		source =
				let
				  Source = #"OData",
				  IndividualRoleApproval = Source{[Name="IndividualRoleApprovals", Signature="table"]}[Data],
				
				  selectColumns = Table.SelectColumns(
				    IndividualRoleApproval,
				    {
				      "OrganizationId",
				      "LocationId",
				      "PersonId",
				      "RoleName",
				      "Start",
				      "End",
				      "Status"
				    }
				  ),
				
				  renameColumns = Table.RenameColumns(
				    selectColumns,
				    {
				      {"OrganizationId", "organization_id"},
				      {"LocationId", "location_id"},
				      {"PersonId", "person_id"},
				      {"RoleName", "role_name"},
				      {"Start", "valid_from"},
				      {"End", "valid_to"},
				      {"Status", "status"}
				    }
				  ),
				
				  addRLSKey = Table.AddColumn(
				    renameColumns,
				    "rls_key",
				    each Text.Combine({[organization_id], "-", [location_id]})
				  ),
				
				  addPersonUniqueKey = Table.AddColumn(
				      addRLSKey,
				      "person_uid",
				      each
				          if [person_id] <> null then
				              Text.Combine({[rls_key], "-", [person_id]})
				          else
				              null,
				      type text
				  ),
				
				  // Roles are not associated with locations - The UID must be ORG + Role Name
				  addRoleUniqueKey = Table.AddColumn(
				      addPersonUniqueKey,
				      "role_uid",
				      each
				          if [role_name] <> null then
				              Text.Combine({[organization_id], "-", [role_name]})
				          else
				              null,
				      type text
				  )
				
				in
				
				  addRoleUniqueKey

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

