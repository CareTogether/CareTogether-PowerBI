	measure 'Individual Application Outcomes Description' =
			
			/*
			Dynamically describes the outcomes of Individual Applications
			initiated within the selected timeframe.
			
			All metrics are based on the Application Start Date Cohort
			(Prospective).
			
			The description reflects the latest observed status of
			each Application, regardless of when subsequent status
			transitions occurred.
			
			Each Application is counted only once.
			*/
			
			VAR applications =
			    COALESCE(
			        CALCULATE(
			            [# of Individual Applications CP],
			            REMOVEFILTERS(
			                'Volunteer Person Role Approval'[Individual Application Final Status]
			            )
			        ),
			        0
			    )
			
			VAR customDescription =
			    "Of the " & FORMAT(applications, "#,##0") &
			    " Individual Applications initiated during the selected period: "
			
			RETURN
			    customDescription
		displayFolder: Approval Activity Measures
		lineageTag: ea89bf7d-115d-4652-a01b-6741a14e57e1

	measure '# of Individual Application Outcomes CP' =
			
			/*
			CP = Current Period
			
			Counts distinct Individual Applications initiated during
			the selected timeframe, grouped by their Final Status.
			
			Each entry into Prospective represents a new Application
			for the same Person and Role.
			
			Applications are identified by:
			- Person ID
			- Role UID
			- Prospective start date
			
			Duplicate records across Locations are counted once.
			
			The Final Status is determined by the calculated column
			Individual Application Final Status.
			
			Applications without a Prospective entry are excluded.
			
			Location filtering is applied using USERELATIONSHIP.
			*/
			
			VAR selectedStartDate = [Selected Timeframe Start]
			VAR selectedEndDate = [Selected Timeframe End]
			
			VAR result =
			CALCULATE(
			    COUNTROWS(
			        SUMMARIZE(
			            'Volunteer Person Role Approval',
			            'Volunteer Person Role Approval'[person_id],
			            'Volunteer Person Role Approval'[role_uid],
			            'Volunteer Person Role Approval'[valid_from]
			        )
			    ),
			
			    -- Only Application start records
			    'Volunteer Person Role Approval'[status] = "Prospective",
			
			    -- Applications initiated during the selected timeframe
			    'Volunteer Person Role Approval'[valid_from] >= selectedStartDate,
			    'Volunteer Person Role Approval'[valid_from] < selectedEndDate + 1,
			
			    -- Exclude future Applications
			    'Volunteer Person Role Approval'[valid_from] < TODAY() + 1,
			
			    -- Apply Location filtering
			    USERELATIONSHIP(
			        'Volunteer Person Role Approval'[location_id],
			        Location[location_id]
			    )
			)
			
			RETURN
			    IF(ISBLANK(result), 0, result)
		formatString: 0
		displayFolder: Approval Activity Measures
		lineageTag: ea083562-eb6a-4bb0-83ef-3b17ce7e9792

	measure '# of Approved Volunteers CP' = ```
			
			/*
			CP = Current Period (As-of-Date Snapshot)
			
			Counts the number of unique Volunteers
			with at least one Approved or Onboarded Role
			on the selected reference date.
			
			A Role is considered eligible when:
			- Its status is Approved or Onboarded.
			- Its validity period includes the reference date.
			
			Open-ended validity dates (e.g., 2999-12-31
			or 9999-12-31) are handled naturally.
			
			Each Volunteer is counted only once, regardless
			of the number of eligible Roles or Locations.
			
			The selected timeframe end is used as the
			reference date.
			
			Location filtering is applied through
			the inactive relationship.
			*/
			
			VAR referenceDate = [Selected Timeframe End]
			
			RETURN 
			CALCULATE(
			    DISTINCTCOUNT('Volunteer Person Role Approval'[person_id]),
			    'Volunteer Person Role Approval'[status] IN {"Approved", "Onboarded"},
			    'Volunteer Person Role Approval'[valid_from] < referenceDate + 1,
			    'Volunteer Person Role Approval'[valid_to] >= referenceDate,
			    USERELATIONSHIP('Volunteer Person Role Approval'[location_id], Location[location_id])
			)
			```
		formatString: 0
		displayFolder: Volunteers & Engagement Measures
		lineageTag: 11644984-e1fc-4c06-aff0-5ef693adef45

	measure 'HTML - Volunteer Workforce by Role' = ```
			
			/*
			Displays Volunteer Families and Individual Volunteers
			in a single vertical list, grouped by Role.
			
			Families: #BA4EB5
			Individuals: #00778A
			
			Each Role is evaluated using its respective existing measure.
			A Role shared by Families and Individuals appears twice.
			
			Rows are sorted by count, descending.
			
			Bar widths use rounded integer percentages to avoid
			decimal separator issues in HTML/CSS.
			*/
			
			VAR familyRoles =
			    SELECTCOLUMNS(
			        ADDCOLUMNS(
			            ALLSELECTED(
			                'Volunteer Family Role Approval'[role_name]
			            ),
			            "@Count", [# of Approved Volunteer Families CP]
			        ),
			        "Role", 'Volunteer Family Role Approval'[role_name],
			        "VolunteerType", "Families",
			        "VolunteerCount", [@Count],
			        "Color", "#BA4EB5",
			        "TrackColor", "#F2E8F2"
			    )
			
			VAR individualRoles =
			    SELECTCOLUMNS(
			        ADDCOLUMNS(
			            ALLSELECTED(
			                'Volunteer Person Role Approval'[role_name]
			            ),
			            "@Count", [# of Approved Volunteers CP]
			        ),
			        "Role", 'Volunteer Person Role Approval'[role_name],
			        "VolunteerType", "Individuals",
			        "VolunteerCount", [@Count],
			        "Color", "#00778A",
			        "TrackColor", "#E1F1F3"
			    )
			
			VAR combinedRoles =
			    FILTER(
			        UNION(
			            familyRoles,
			            individualRoles
			        ),
			        NOT ISBLANK([VolunteerCount])
			            && [VolunteerCount] > 0
			    )
			
			VAR maxVolunteers =
			    MAXX(
			        combinedRoles,
			        [VolunteerCount]
			    )
			
			VAR totalRoles =
			    COUNTROWS(combinedRoles)
			
			VAR roleRows =
			    CONCATENATEX(
			        combinedRoles,
			
			        VAR currentRole = [Role]
			        VAR currentType = [VolunteerType]
			        VAR currentCount = [VolunteerCount]
			        VAR currentColor = [Color]
			        VAR currentTrack = [TrackColor]
			
			        VAR barWidth =
			            ROUND(
			                DIVIDE(
			                    currentCount,
			                    maxVolunteers,
			                    0
			                ) * 100,
			                0
			            )
			
			        RETURN
			            "<div class='role-item'>" &
			
			                "<div class='role-header'>" &
			
			                    "<div class='role-label'>" &
			                        "<span class='role-dot' style='background:" &
			                            currentColor &
			                        ";'></span>" &
			
			                        "<span class='role-name'>" &
			                            COALESCE(currentRole, "Unknown Role") &
			                        "</span>" &
			                    "</div>" &
			
			                    "<span class='role-value' style='color:" &
			                        currentColor &
			                    ";'>" &
			                        FORMAT(currentCount, "#,0") &
			                    "</span>" &
			
			                "</div>" &
			
			                "<div class='bar-track' style='background:" &
			                    currentTrack &
			                ";'>" &
			
			                    "<div class='bar-fill' style='background:" &
			                        currentColor &
			                        ";width:" &
			                        FORMAT(barWidth, "0") &
			                    "%;'></div>" &
			
			                "</div>" &
			
			            "</div>",
			
			        "",
			        [VolunteerCount],
			        DESC,
			        [Role],
			        ASC
			    )
			
			RETURN
			"
			<div class='workforce-container'>
			
			    <style>
			        .workforce-container {
			            font-family: 'Segoe UI', Arial, sans-serif;
			            width: 100%;
			            height: 100%;
			            box-sizing: border-box;
			            background: transparent;
			            color: #252B42;
			        }
			
			        .workforce-header {
			            display: flex;
			            justify-content: space-between;
			            align-items: center;
			            gap: 12px;
			            margin-bottom: 12px;
			        }
			
			        .workforce-title {
			            font-size: 14px;
			            font-weight: 600;
			            color: #252B42;
			        }
			
			        .workforce-count {
			            font-size: 11px;
			            color: #8A8F9C;
			            white-space: nowrap;
			        }
			
			        .workforce-legend {
			            display: flex;
			            align-items: center;
			            gap: 16px;
			            margin-bottom: 20px;
			        }
			
			        .legend-item {
			            display: flex;
			            align-items: center;
			            gap: 6px;
			            font-size: 11px;
			            color: #737987;
			        }
			
			        .legend-dot {
			            width: 9px;
			            height: 9px;
			            border-radius: 50%;
			            display: inline-block;
			            flex-shrink: 0;
			        }
			
			        .workforce-list {
			            height: 280px;
			            overflow-y: auto;
			            padding-right: 10px;
			            box-sizing: border-box;
			        }
			
			        .role-item {
			            margin-bottom: 17px;
			        }
			
			        .role-header {
			            display: flex;
			            justify-content: space-between;
			            align-items: center;
			            gap: 12px;
			            margin-bottom: 7px;
			        }
			
			        .role-label {
			            display: flex;
			            align-items: center;
			            gap: 8px;
			            min-width: 0;
			        }
			
			        .role-dot {
			            width: 7px;
			            height: 7px;
			            border-radius: 50%;
			            flex-shrink: 0;
			        }
			
			        .role-name {
			            font-size: 12px;
			            font-weight: 500;
			            color: #434957;
			            overflow-wrap: anywhere;
			        }
			
			        .role-value {
			            font-size: 12px;
			            font-weight: 600;
			            white-space: nowrap;
			        }
			
			        .bar-track {
			            width: 100%;
			            height: 8px;
			            border-radius: 10px;
			            overflow: hidden;
			        }
			
			        .bar-fill {
			            height: 100%;
			            border-radius: 10px;
			        }
			
			        .workforce-list::-webkit-scrollbar {
			            width: 5px;
			        }
			
			        .workforce-list::-webkit-scrollbar-track {
			            background: transparent;
			        }
			
			        .workforce-list::-webkit-scrollbar-thumb {
			            background: #D5D8DE;
			            border-radius: 10px;
			        }
			    </style>
			
			    <div class='workforce-header'>
			        <span class='workforce-title'>
			            Volunteer Workforce by Role
			        </span>
			
			        <span class='workforce-count'>" &
			            FORMAT(totalRoles, "#,0") &
			            " Role Entries
			        </span>
			    </div>
			
			    <div class='workforce-legend'>
			
			        <div class='legend-item'>
			            <span class='legend-dot'
			                  style='background:#BA4EB5;'></span>
			            Families
			        </div>
			
			        <div class='legend-item'>
			            <span class='legend-dot'
			                  style='background:#00778A;'></span>
			            Individuals
			        </div>
			
			    </div>
			
			    <div class='workforce-list'>" &
			        roleRows &
			    "</div>
			
			</div>
			"
			
			```
		displayFolder: Volunteers & Engagement Measures
		lineageTag: 6f451698-c7a1-475d-b988-6839b033a1f4

